er;font-size:19rpx;letter-spacing:1rpx;color:#a0aa94;margin-top:42rpx}.notice{background:#eef3e6;color:#748363;border-radius:18rpx;padding:18rpx 22rpx;font-size:22rpx;line-height:1.8}.notice.warn{background:#faf3e4;color:#957c4e}.mock-tag{display:inline-block;font-size:18rpx;color:#8b977c;border:1rpx solid #dce4d2;border-radius:8rpx;padding:2rpx 9rpx}.state{display:flex;align-items:center;flex-direction:column;gap:20rpx;padding:100rpx 30rpx;text-align:center;color:#88957d;font-size:25rpx}.state-title{font-size:32rpx;color:#466043}.loading-mark{height:36rpx;width:36rpx;border:4rpx solid #dfE8d5;border-top-color:#1d6651;border-radius:50%}.form-field{margin-bottom:25rpx}.form-label{display:block;color:#6d7f62;font-size:24rpx;margin-bottom:12rpx}.input,.picker,textarea{width:100%;background:#f6f8f2;border:1rpx solid #e2e8db;border-radius:16rpx;padding:20rpx 22rpx;font-size:27rpx;color:#29432f;min-height:84rpx}.input{height:88rpx}textarea{height:170rpx}.form-hint{font-size:21rpx;color:#929c87;margin-top:9rpx}.menu-item{display:flex;align-items:center;gap:20rpx;min-height:104rpx;border-bottom:1rpx solid #edf0e8;padding:20rpx 0;background:transparent;text-align:left;width:100%;color:inherit;border-radius:0}.menu-item:last-child{border-bottom:0}.arrow{font-size:32rpx;color:#9eac91}.avatar{width:96rpx;height:96rpx;display:flex;align-items:center;justify-content:center;font-size:38rpx;font-weight:600;border-radius:50%;background:#d4ed9c;color:#1d6651;flex-shrink:0}.avatar.small{width:64rpx;height:64rpx;font-size:26rpx}.segmented{display:flex;gap:8rpx;background:#eaf0e2;border-radius:18rpx;padding:7rpx}.segment{flex:1;background:transparent;color:#84927a;font-size:24rpx;line-height:1.5;padding:14rpx 8rpx;border-radius:13rpx}.segment.active{background:#fff;color:#1d6651;box-shadow:0 3rpx 8rpx #24472a09}.record-row{display:flex;align-items:center;gap:18rpx;padding:22rpx 0;border-top:1rpx solid #edf0e8}.record-row:first-child{border-top:0}.thumb{width:90rpx;height:90rpx;border-radius:18rpx;background:#eff3e6}.delete{color:#a0aa94;background:transparent;padding:10rpx;font-size:22rpx}.switch-row{display:flex;align-items:center;gap:22rpx;padding:24rpx 0;border-bottom:1rpx solid #edf0e8}.switch-row:last-child{border-bottom:0}.caption{display:block;font-size:21rpx;color:#8a977f;margin-top:8rpx}.tag-row{display:flex;gap:12rpx;flex-wrap:wrap}.stat-card{background:#fff;border:1rpx solid #e6eae3;border-radius:23rpx;padding:20rpx 15rpx;text-align:center}.stat-card .number{font-size:36rpx}.stat-card .label{font-size:21rpx}.section-kicker{font-size:19rpx;letter-spacing:3rpx;color:#8a9e7b}.activity-art{width:88rpx;height:88rpx;border-radius:27rpx;display:flex;align-items:center;justify-content:center;background:#e9f0db}.activity-art.cream{background:#f3ebd4}.activity-art.sage{background:#dce9dd}.activity-art .icon{width:54rpx;height:54rpx}.list-gap{margin-top:18rpx}.date-control{background:#fff;border:1rpx solid #dfe6d5;padding:12rpx 21rpx;border-radius:14rpx;font-size:24rpx;color:#59734e}.date-arrow{background:transparent;padding:8rpx 14rpx;color:#56744b;font-size:36rpx;line-height:1}.date-arrow[disabled]{opacity:.25}.inline-icon{width:28rpx;height:28rpx}.profile-title{font-size:35rpx;font-weight:600}.footer-buttons{display:flex;gap:18rpx}.footer-buttons .btn{flex:1}.check-ring{width:142rpx;height:142rpx;border:12rpx solid #cfdfb9;border-top-color:#6a955c;border-right-color:#6a955c;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-direction:column;flex-shrink:0;background:#eef3e6}.check-ring .number{font-family:Georgia,serif;font-weight:400;font-size:48rpx}.check-ring .label{font-size:18rpx}.borderless{border:0}.error-inline{color:#a75f49;font-size:23rpx;margin:18rpx 0}.safe-bottom{padding-bottom:env(safe-area-inset-bottom)}

/* Full-prototype shared mobile controls */
button{background:#eaf3e9;color:#1d6651;border:0;border-radius:14rpx;padding:14rpx 20rpx;line-height:1.5;font-size:24rpx}input:not(.input){background:#f6f8f2;border:1rpx solid #e0e7d7;border-radius:14rpx;padding:16rpx 20rpx;min-height:80rpx;font-size:26rpx}textarea{line-height:1.7}.shortcut-card{display:flex;align-items:center;justify-content:flex-start;gap:16rpx;min-height:105rpx;border:1rpx solid #e2e9d8;background:#fff;color:#45693b;padding:20rpx 24rpx;border-radius:22rpx;text-align:left;font-size:25rpx}.type-tabs{display:flex;gap:14rpx;white-space:nowrap;padding:5rpx 0}.type-tabs .pill{flex-shrink:0;padding:12rpx 22rpx;font-size:23rpx}.selected-pill{background:#1d6651;color:#fff}.tier-card{background:#f7f9f2;border:1rpx solid #e4ebda;padding:22rpx;border-radius:18rpx}.mock-ad{margin:24rpx 0;padding:25rpx;border:1rpx dashed #c8d7b8;background:#f0f4e7;border-radius:16rpx;font-size:23rpx;color:#728865;text-align:center}.full-shortcuts{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx}.full-shortcut{display:flex;flex-direction:column;gap:9rpx;align-items:center;padding:18rpx 4rpx;background:#eef3e6;border-radius:19rpx;color:#537247;font-size:21rpx}.banner-slide{height:200rpx;padding:26rpx 30rpx;border-radius:26rpx;background:#e4eddb;position:relative;overflow:hidden}.banner-slide .banner-bg{position:absolute;inset:0;width:100%;height:100%}.banner-slide .banner-title{position:relative;font-size:32rpx;max-width:500rpx;font-weight:600;color:#244f3b}.banner-slide .banner-subtitle{position:relative;font-size:22rpx;color:#5a7650;margin-top:15rpx}.banner-slide .pill{position:relative;background:#ffffffb0}.role-pill{font-size:19rpx;color:#7f9271;border:1rpx solid #d8e3cd;padding:5rpx 12rpx;border-radius:10rpx}.page>.card+.card{margin-top:20rpx}.config-row{padding:18rpx 0;border-bottom:1rpx solid #e9eee1}.config-row:last-child{border:0}.calendar-day[disabled]{opacity:.3}.service-links{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.service-links .btn{font-size:24rpx;min-height:75rpx}.profile-menu-title{font-size:21rpx;color:#879a77;letter-spacing:3rpx;margin-bottom:15rpx}
.full-shortcuts{grid-template-columns:repeat(4,minmax(0,1fr))}
