/* Explicit track and box constraints also apply to native mini-program buttons. */
.page button,.page input,.page textarea,.page picker {box-sizing:border-box}
.page .btn {min-width:0;max-width:100%;white-space:normal;overflow-wrap:anywhere}
.page .service-links {
  width:100%;
  max-width:100%;
  min-width:0;
  box-sizing:border-box;
  grid-template-columns:repeat(2,minmax(0,1fr));
  align-items:stretch;
}
.page .service-links > .btn {
  box-sizing:border-box;
  min-width:0;
  width:100%;
  max-width:100%;
  margin:0;
  padding:20rpx 18rpx;
  gap:12rpx;
  white-space:normal;
  overflow-wrap:anywhere;
  word-break:break-word;
  height:auto;
  align-self:stretch;
}
.page .service-links > .btn > text {
  min-width:0;
  white-space:normal;
  flex:1;
  display:block;
  line-height:1.55;
  overflow-wrap:anywhere;
  word-break:break-word;
}
.page .service-links > .btn > .feature-entry-icon {
  width:48rpx;
  height:48rpx;
  flex:0 0 48rpx;
  margin-right:0;
}
.page .grid2,.page .grid3 {min-width:0;max-width:100%}
.page .grid2 > view,.page .grid2 > button,.page .grid3 > view,.page .grid3 > button {
  box-sizing:border-box;
  min-width:0;
  max-width:100%;
}
.page .grid2 > button,.page .grid3 > button {white-space:normal;overflow-wrap:anywhere}
.page .footer-buttons > .btn {min-width:0;white-space:normal;overflow-wrap:anywhere}
.page .menu-item {min-width:0;max-width:100%;white-space:normal;overflow-wrap:anywhere}
.page .menu-item > .icon-box,.page .menu-item > .arrow {flex-shrink:0}
.page .plan-report-summary > view,.page .overview-pair > view,
.page .invite-hero-stats > view,.page .invite-stat-grid > view,
.page .photo-access-stats > view,.page .weight-health-cards > view {min-width:0;overflow-wrap:anywhere}
.page .invite-menu-card > button,.page .team-quick-grid > button {min-width:0;max-width:100%;white-space:normal}
