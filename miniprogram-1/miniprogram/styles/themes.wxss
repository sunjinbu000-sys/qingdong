/* Shared hierarchy. Scoped selectors preserve page layouts and interaction states. */
.qd-theme{color:var(--qd-ink);--qd-radius:30rpx;--qd-line:#E8EDF0}
.page.qd-theme{min-height:100vh;background:linear-gradient(160deg,var(--qd-canvas),#FCFDFC 92%)}
.page.qd-theme .heading,.page.qd-theme .section-title,.page.qd-theme .title,.page.qd-theme .profile-title{color:var(--qd-ink);letter-spacing:0;font-weight:650}
