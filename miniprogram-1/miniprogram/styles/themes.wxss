.page.qd-theme .subtitle,.page.qd-theme .muted,.page.qd-theme .label,.page.qd-theme .small-text,.page.qd-theme .caption,.page.qd-theme .form-hint,.page.qd-theme .footnote{color:var(--qd-muted)}
.page.qd-theme .eyebrow,.page.qd-theme .section-kicker{color:var(--qd-primary);letter-spacing:3rpx}
.page.qd-theme .card,.page.qd-theme .stat-card,.page.qd-theme .ledger-card{background:#FFFFFF;border:1rpx solid var(--qd-edge);border-radius:var(--qd-radius);box-shadow:0 8rpx 25rpx #263B4C05}
.page.qd-theme .btn{background:var(--qd-primary);border-color:var(--qd-primary);color:#FFFFFF;border-radius:22rpx;min-height:86rpx;box-shadow:0 5rpx 12rpx #24394B08}
.page.qd-theme .btn.soft{background:var(--qd-soft);border-color:var(--qd-soft);color:var(--qd-primary);box-shadow:none}
.page.qd-theme .btn.white{background:#FFFFFF;border-color:var(--qd-edge);color:var(--qd-primary);box-shadow:none}
.page.qd-theme .btn.ghost{background:transparent;border-color:var(--qd-edge);color:var(--qd-primary);box-shadow:none}
.page.qd-theme .btn.small{min-height:62rpx;border-radius:17rpx}
.page.qd-theme .btn.danger{background:#FFF1EE;color:#A7554D;border-color:#F2D7D1;box-shadow:none}
.page.qd-theme .link{background:transparent;color:var(--qd-primary)}
