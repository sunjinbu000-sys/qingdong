<view class="page qd-theme qd-ops"><view wx:if="{{accessMessage}}" class="card">{{accessMessage}}<button data-url="/pages/account/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/edit.svg" mode="aspectFit"/><text>账号与登录</text></button></view><view wx:if="{{error}}" class="card">{{error}}<button bindtap="retry">重试</button></view><view class="card"><view>忽略大小写、空格及标点，匹配违禁词语</view><picker range="{{categories}}" bindchange="category">分类：{{category}}</picker><input data-key="word" value="{{word}}" bindinput="input" maxlength="60" placeholder="词语"/><button bindtap="save">{{editId?'保存编辑':'新增'}}</button><textarea data-key="importText" bindinput="input" placeholder="每行：词语,分类；仅词语使用当前分类。每批最多1000行，自动去重。"/><button bindtap="importWords">校验并批量导入</button><button bindtap="restore">恢复内置词库</button></view><view class="card" wx:for="{{entries}}" wx:key="id">{{item.word}} · {{item.category}}<button data-id="{{item.id}}" bindtap="edit">编辑</button><button data-id="{{item.id}}" bindtap="remove">删除</button></view></view>