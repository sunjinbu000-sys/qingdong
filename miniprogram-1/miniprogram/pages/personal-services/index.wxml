<view class="page"><view wx:if="{{accessMessage}}" class="card">{{accessMessage}}<button data-url="/pages/account/index" bindtap="go">账号与登录</button></view><view wx:if="{{error}}" class="card">{{error}}<button bindtap="retry">重试</button></view><block wx:if="{{services}}"><view class="card"><view class="title">会员与隐私设置</view><button data-url="/pages/membership/index" bindtap="go">会员权益</button><button data-url="/pages/privacy/index" bindtap="go">隐私与数据设置</button></view><view class="card"><view class="title">帮助与客服</view><button wx:if="{{settings.serviceUrl}}" data-url="/pages/web-link/index?url={{settings.serviceUrl}}" bindtap="go">联系客服</button><view wx:else>暂未配置客服入口，请留意平台公告。</view></view><view class="card"><view class="title">消息中心</view><button bindtap="read">全部已读</button><view wx:for="{{services.messages}}" wx:key="id">{{item.read?'已读':'未读'}} · {{item.title}}<view>{{item.text}}</view><button data-id="{{item.id}}" bindtap="read">标为已读</button></view><view wx:if="{{!services.messages.length}}">暂无消息</view></view><view class="card"><view class="title">我的订单</view><view wx:for="{{services.orders}}" wx:key="id">{{item.name||item.title||item.planName}} · {{statusLabels[item.status] || item.status}}<button data-url="/pages/orders/index" bindtap="go">订单详情 / 售后</button></view><view wx:if="{{!services.orders.length}}">暂无订单</view></view><view class="card"><view class="title">我的收藏</view><button wx:for="{{services.favorites}}" wx:key="id" data-url="/pages/forum-detail/index?id={{item.id}}" bindtap="go">{{item.title||item.text}}</button><view wx:if="{{!services.favorites.length}}">暂无收藏</view></view><view class="card"><view class="title">提醒偏好</view><view>会员到期 <switch checked="{{services.reminders.member}}" data-key="member" bindchange="reminder"/></view><view>体重记录 <switch checked="{{services.reminders.weight}}" data-key="weight" bindchange="reminder"/></view><picker mode="time" value="{{services.reminders.weightTime}}" data-key="weightTime" bindchange="reminder">时间 {{services.reminders.weightTime}}</picker><button bindtap="save">保存提醒偏好</button><view>本地模拟保存，实际通知需接入微信订阅消息。</view></view><view class="card"><view class="title">拉黑列表</view><view wx:for="{{services.blocks}}" wx:key="to">{{item.to}}<button data-id="{{item.to}}" bindtap="unblock">解除拉黑</button></view><view wx:if="{{!services.blocks.length}}">暂无拉黑用户</view></view><view class="card"><view class="title">账号注销</view><view>清空本人记录与权益。输入“确认注销”后再次确认。</view><input data-key="confirmation" bindinput="input"/><button bindtap="destroy" disabled="{{confirmation !== '确认注销'}}">注销账号</button></view></block></view>