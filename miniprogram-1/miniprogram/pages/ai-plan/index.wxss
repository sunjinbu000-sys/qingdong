.config-row{padding:24rpx 0;border-bottom:1rpx solid #edf0e8}.config-row input{background:#f4f6ef;padding:20rpx;border-radius:14rpx;margin-top:12rpx}.task-row{padding:20rpx 0}.day-nav{white-space:nowrap}.day-nav button{display:inline-block;margin-right:12rpx}.poster{width:600rpx;height:800rpx}.actions{display:flex;gap:16rpx;flex-wrap:wrap}
.plan-profile-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx;margin-top:24rpx;color:#9380a9;font-size:23rpx}.plan-profile-card .section-title{font-size:28rpx}.plan-profile-card .link{font-size:22rpx;flex-shrink:0}
