.config-row{padding:24rpx 0;border-bottom:1rpx solid #edf0e8}.config-row input{background:#f4f6ef;padding:20rpx;border-radius:14rpx;margin-top:12rpx}.task-row{padding:20rpx 0}.day-nav{white-space:nowrap}.day-nav button{display:inline-block;margin-right:12rpx}.poster{width:600rpx;height:800rpx}.actions{display:flex;gap:16rpx;flex-wrap:wrap}
.plan-profile-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx;margin-top:24rpx;color:#9380a9;font-size:23rpx}.plan-profile-card .section-title{font-size:28rpx}.plan-profile-card .link{font-size:22rpx;flex-shrink:0}

.plan-meals-scroll{width:100%;overflow-x:auto;margin-top:24rpx;white-space:nowrap}.plan-meals-row{display:flex;align-items:stretch;gap:20rpx;padding:2rpx 2rpx 16rpx}.plan-meal-card{flex:0 0 490rpx;width:490rpx;min-width:0;white-space:normal;background:#faf7ff;border:1rpx solid #ebe2f5;border-radius:28rpx;padding:26rpx;box-sizing:border-box}.plan-meal-card .title{font-size:28rpx;line-height:1.6}.plan-meal-card .small-text,.plan-meal-card .caption{font-size:22rpx;line-height:1.8}.plan-meal-card .actions{margin-top:24rpx;flex-wrap:wrap}.plan-meals-hint{font-size:20rpx;color:#ac9abb;text-align:center;margin-top:8rpx}

.day-nav{width:100%;max-width:100%;overflow-x:auto;box-sizing:border-box}

.plan-goal-assessment{background:#f4effb;border-radius:24rpx;padding:24rpx;color:#917cac;font-size:24rpx;line-height:1.8}.page .plan-extend{width:auto;min-width:0;margin-top:16rpx;border-radius:22rpx;background:#fff;color:#8564c6;padding:15rpx 24rpx;font-size:23rpx;line-height:1.5}

.page .plan-style-select{width:100%;min-width:0;display:flex;justify-content:space-between;gap:16rpx;background:#faf7ff;border:1rpx solid #e5daf4;color:#7f65b5;border-radius:24rpx;padding:22rpx;margin-top:16rpx;font-size:26rpx;line-height:1.5}.plan-style-options{background:#f8f3ff;border-radius:24rpx;padding:8rpx;margin-top:12rpx}.page .plan-style-option{width:100%;min-width:0;background:#fff;text-align:left;border-radius:18rpx;padding:20rpx;margin-bottom:8rpx;font-size:25rpx;color:#78648e;line-height:1.6}.page .plan-style-option.is-selected{background:#eee4ff;color:#7753b5}.plan-style-description{font-size:21rpx;color:#a18caf;margin-top:6rpx}
