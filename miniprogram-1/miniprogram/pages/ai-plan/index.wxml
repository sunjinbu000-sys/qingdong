<import src="../../components/states.wxml"/><view class="page plan-page qd-theme qd-plan"><template is="feedback" data="{{loading,error}}"/><view class="plan-step-nav"><button data-step="1" bindtap="step" class="{{activeStep===1?'active':''}}">填写档案</button><button data-step="2" bindtap="step" class="{{activeStep===2?'active':''}}">设定目标</button><button data-step="3" bindtap="step" class="{{activeStep===3?'active':''}}">补充情况</button><button data-step="4" bindtap="step" class="{{activeStep===4?'active':''}}">生成计划</button></view><view class="plan-step-track"><view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="plan-step-dot {{activeStep>=item?'complete':''}}">{{item}}</view></view>
<view id="plan-profile" class="plan-input-card"><view class="plan-card-head"><text>个人档案</text><button data-url="/pages/account/index" bindtap="go">编辑 ›</button></view><view class="plan-hint">已同步你的档案，可继续确认</view><view class="plan-profile-grid"><text>性别：{{profile.sex || '待填写'}}</text><text>身高：{{profile.height || '待填写'}} cm</text><text>年龄：{{profile.age || '待填写'}} 岁</text><text>体重：{{profile.weight || '待记录'}} kg</text><text>目标体重：{{profile.targetWeight || '未设置'}} kg</text><text>自设热量：{{profile.calorieGoal || '未设置'}} kcal</text></view><view class="plan-hint">方向：{{profile.direction || '待设置'}}</view><view class="plan-hint">健康状态：{{profile.healthStatus || '无 / 不适用'}}</view><view class="plan-hint">{{recordOnly?'当前档案使用记录与习惯参考模式。':'生成时读取最新档案，并校验目标范围。'}}</view></view>
<view class="plan-input-card plan-weight-style-card"><view class="plan-card-head"><text>选择你的减重风格</text><text class="plan-head-arrow">›</text></view><view class="plan-style-pills plan-weight-style-pills"><button wx:for="{{weightStyles}}" wx:key="id" class="{{weightStyle===item.id?'selected':''}}" data-style="{{item.id}}" bindtap="selectWeightStyle">{{item.label}}</button></view><view class="plan-hint">{{weightStyleDescription}}</view><view class="plan-hint">风格影响默认活动时长与餐单搭配；自填运动量优先保留。</view></view>
<view class="plan-input-card"><view class="plan-card-head">选择餐食风格</view><view class="plan-style-pills"><button wx:for="{{mealStyles}}" wx:key="id" class="{{mealStyle===item.id?'selected':''}}" data-style="{{item.id}}" bindtap="selectMealStyle">{{item.label}}</button></view><view class="plan-hint">常见食材搭配，按实际配方与份量记录。</view></view>
<view id="plan-goal" class="plan-input-card"><view class="plan-card-head">设定你的目标<view class="plan-clock"><view class="plan-clock-hand"></view></view></view><view class="plan-goal-inputs"><view class="plan-goal-field"><text>计划周期</text><input type="number" value="{{days}}" data-key="days" bindinput="input"/><text>天</text></view><view class="plan-goal-field"><text>目标减重</text><input type="digit" value="{{lossJin}}" data-key="lossJin" bindinput="input"/><text>斤</text></view></view><view class="plan-hint">周期1—1096天，0斤表示维持或记录。</view><view wx:if="{{goalAssessment}}" class="plan-goal-assessment"><view>{{goalAssessment.message}}</view><view wx:if="{{goalAssessment.needsReview}}" class="caption">记录模式保留目标，不执行量化减重目标。</view><button wx:if="{{goalAssessment.suggestedDays}}" class="plan-extend" bindtap="extendPeriod">调整为 {{goalAssessment.suggestedDays}} 天</button></view><view wx:if="{{goalError}}" class="error-inline">{{goalError}}</view></view>
<view id="plan-extra" class="plan-input-card"><view class="plan-card-head"><text>选择运动方式</text><button bindtap="openExerciseSearch">搜索选择 ›</button></view><input class="plan-extra-input" value="{{exerciseName}}" data-key="exerciseName" bindinput="input" maxlength="40" placeholder="搜索运动，或填写自己的运动名称"/><view wx:if="{{exerciseSearchOpen}}" class="plan-exercise-options"><view class="plan-hint">点选运动，或直接保留输入的名称作为自填方式。</view><scroll-view scroll-y="{{true}}" class="plan-exercise-results"><button wx:for="{{exerciseMatches}}" wx:key="id" class="plan-exercise-option {{exerciseId===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="selectExercise"><text>{{item.name}}</text><text class="plan-exercise-category">{{item.category}}</text></button><view wx:if="{{!exerciseMatches.length}}" class="plan-hint">未找到匹配运动，将使用你填写的名称。</view></scroll-view><button class="plan-exercise-done" bindtap="closeExerciseSearch">使用当前运动名称 ✓</button></view><view class="plan-exercise-quantity"><text>每日运动量</text><input type="number" value="{{exerciseMinutes}}" data-key="exerciseMinutes" bindinput="input"/><text>分钟</text></view><view class="plan-hint">{{exerciseId?'已选择目录运动':'使用自填运动'}} · 每日5—240分钟，需在下方活动时段内。</view></view>
<view class="plan-input-card"><view class="plan-card-head">每天活动时段</view><view class="plan-time-pills"><button wx:for="{{activityPresets}}" wx:key="id" class="{{activityPreset===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="chooseActivity">{{item.label}}</button></view><view class="plan-custom-time"><picker class="plan-time-picker" mode="time" value="{{start}}" data-key="start" bindchange="input">{{start}} ⌄</picker><text>至</text><picker class="plan-time-picker" mode="time" value="{{end}}" data-key="end" bindchange="input">{{end}} ⌄</picker></view></view>
<view class="plan-input-card"><view class="plan-card-head">忌口与食物限制</view><view class="plan-restriction-chips"><button wx:for="{{restrictionChips}}" wx:key="value" class="{{item.selected?'selected':''}}" data-value="{{item.value}}" bindtap="toggleRestriction">{{item.value}}{{item.selected?' ✓':''}}</button></view><input class="plan-extra-input" value="{{restrictions}}" data-key="restrictions" bindinput="input" placeholder="添加忌口或过敏食物，如牛奶、鸡蛋"/><view class="plan-hint">档案忌口始终保留，修改请前往个人档案。</view></view>
<view class="plan-input-card"><view class="plan-card-head">身体状况补充</view><textarea class="plan-health-note" value="{{healthNote}}" data-key="healthNote" bindinput="input" maxlength="300" placeholder="选填：补充需要活动安排留意的身体情况"/><view class="plan-hint">补充身体状况时，生成记录参考，活动需专业确认。</view></view>
<view class="plan-access-line">剩余 {{access.remaining || 0}} 次 · 今日全局可用 {{access.globalRemaining || 0}} 次</view><view wx:if="{{access.requiresCredit}}" class="plan-hint">当前会员使用每日额度还需1次免费或广告永久次数。</view><button id="plan-generate" class="plan-generate-button" bindtap="generate" loading="{{busy}}" disabled="{{busy}}">生成专属轻动计划（消耗1次）</button><view wx:if="{{generationError}}" class="plan-generation-error">{{generationError}}<view wx:if="{{plan}}">本次未生成成功，下方仍为上次已保存的计划。</view></view><view class="plan-mock-note">当前使用本地公式模拟，未调用真实AI。用于记录参考，不保证减重效果。</view>
<block wx:if="{{plan}}"><view id="plan-report" class="plan-report-header">—— 我的轻动计划报告 ——</view><view class="plan-report-summary"><view><view class="plan-report-goal">{{plan.request.days}}天 · {{plan.goalAssessment.needsReview?'记录参考':plan.request.lossJin+'斤目标'}}</view><view class="plan-hint">{{plan.start}} — {{plan.end}}</view></view><view><view class="plan-report-calories">{{plan.profileBasis.calorieApplied?'自设热量 '+plan.profileBasis.calorieGoal+' kcal':'餐单示例 '+day.totalKcal+' kcal'}}</view><view class="plan-hint">{{day.meals[0].styleLabel || mealStyleLabel}} · 按实际份量核对</view></view></view><view class="caption section">以下为已保存计划；修改上方设置后，重新生成才会更新。</view><view wx:if="{{plan.profileBasis}}" class="card mt"><view class="title">这份计划采用的档案</view><view class="caption">{{plan.profileBasis.age}} 岁 · {{plan.profileBasis.height}} cm · {{plan.profileBasis.weight}} kg · {{plan.profileBasis.direction}}</view><view class="caption">目标体重 {{plan.profileBasis.targetWeight || '未设置'}} kg · {{plan.profileBasis.calorieApplied ? '使用档案自设热量目标' : '未套用档案热量目标，餐食数值为模拟示例'}}</view><view wx:if="{{plan.request.healthNote}}" class="caption">身体补充：{{plan.request.healthNote}}</view><view class="caption">历史计划保留生成时的档案，修改档案后可重新生成。</view></view><view wx:if="{{plan.goalAssessment.needsReview}}" class="notice mt">原设目标：{{plan.goalAssessment.days}} 天 {{plan.goalAssessment.requestedLossJin}} 斤。当前为记录模式，未执行该量化减重目标。</view><view class="notice mt">{{plan.notice}} {{plan.mode === 'review' ? '当前档案需要专业确认，未执行量化减重目标。' : ''}}</view><view class="plan-report-day-controls"><button data-offset="-1" bindtap="relativeDay" disabled="{{selected===0}}">前一天</button><button bindtap="todayDay" disabled="{{!planHasToday}}">今日</button><button data-offset="1" bindtap="relativeDay" disabled="{{selected===plan.dates.length-1}}">后一天</button></view><scroll-view class="day-nav mt" scroll-x="{{true}}"><button wx:for="{{plan.dates}}" wx:key="*this" size="mini" class="{{selected===index?'selected-plan-day':''}}" data-index="{{index}}" bindtap="selectDay">{{item}}</button></scroll-view><view class="card section"><view class="title">{{day.date}} · 三餐 {{day.totalKcal}} kcal（模拟估算）</view><scroll-view class="plan-meals-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="plan-meals-row"><view wx:for="{{day.meals}}" wx:key="slot" class="plan-meal-card"><view class="pill">{{item.slot === 'breakfast' ? '早餐' : item.slot === 'lunch' ? '午餐' : '晚餐'}}</view><view class="caption">{{item.styleLabel || '减脂餐'}} · 常见食材搭配</view><view class="title mt">{{item.title}}</view><view class="small-text mt">{{item.kcal}} kcal · 蛋白质{{item.protein}}g · 碳水{{item.carbohydrate}}g · 脂肪{{item.fat}}g</view><view wx:for="{{item.ingredients}}" wx:for-item="ingredient" wx:key="name" class="small-text mt-sm">{{ingredient.name}} {{ingredient.grams}}g</view><view wx:for="{{item.steps}}" wx:for-item="step" wx:key="*this" class="caption mt-sm">{{step}}</view><view class="actions mt"><button size="mini" data-slot="{{item.slot}}" bindtap="regenerate" disabled="{{busy}}">换一餐（消耗1次）</button><button size="mini" data-slot="{{item.slot}}" bindtap="edit">手动调整</button></view></view></view></scroll-view><view class="plan-meals-hint">左右滑动查看早餐、午餐和晚餐</view><view class="caption mt">{{day.encouragement}}</view></view><view class="card section plan-daily-exercise"><view class="plan-card-head"><text>每日运动安排</text><text class="plan-exercise-tag">{{plan.request.weightStyleLabel || '历史安排'}}</text></view><view class="plan-exercise-date">{{day.date}}</view><block wx:if="{{plan.mode==='review'}}"><view class="plan-daily-exercise-name">待专业确认</view><view class="caption mt">运动偏好：{{day.exercise.requestedName || plan.request.exercise.name || '未记录'}} · {{day.exercise.requestedMinutes || plan.request.exercise.minutes || 0}}分钟 / 日</view><view class="caption mt">已保存你的偏好，本计划暂不安排自动执行的运动量。</view></block><block wx:else><view class="plan-daily-exercise-name">{{day.exercise.name}}</view><view class="plan-daily-exercise-amount"><text>{{day.exercise.minutes}}</text> 分钟 / 日</view></block><view class="caption mt">可用时段 {{day.exercise.time}}{{day.exercise.end?' — '+day.exercise.end:''}}</view><view class="plan-hint">这里是计划安排，实际完成后请记录；自填运动不自动估算热量。</view></view><view wx:if="{{editSlot}}" class="card section"><view class="title">手动调整（不扣次）</view><input class="config-row" value="{{editTitle}}" data-key="editTitle" bindinput="input"/><input class="config-row" type="digit" value="{{editKcal}}" data-key="editKcal" bindinput="input"/><button class="btn mt" bindtap="saveMeal">保存调整</button></view><view class="card section"><view class="title"><image class="section-symbol" src="/images/ui/sun.svg"/>每日任务与本机提醒标记</view><view class="caption mt">提醒仅保存在本机，未接微信订阅通知。</view><view wx:for="{{taskTypes}}" wx:key="id" class="task-row"><view class="row"><text>{{item.label}}</text><switch checked="{{plan.tasks[item.id].enabled}}" data-type="{{item.id}}" data-key="enabled" bindchange="toggleTask"/></view><view class="row mt"><picker mode="time" value="{{plan.tasks[item.id].time}}" data-type="{{item.id}}" bindchange="taskTime"><text>提醒时间 {{plan.tasks[item.id].time}}</text></picker><switch checked="{{plan.tasks[item.id].remind}}" data-type="{{item.id}}" data-key="remind" bindchange="toggleTask"/></view><button size="mini" class="mt" data-type="{{item.id}}" bindtap="task" disabled="{{busy}}">{{item.id === 'photo' ? '去识餐完成今日任务' : '完成今日任务'}}</button></view><view wx:for="{{plan.checks}}" wx:key="createdAt" class="caption mt-sm">{{item.date}} · {{item.type}} 已完成</view></view><button class="btn white section" bindtap="exportPlan">复制完整周期文本，供导出保存</button><button class="btn white mt" bindtap="exportExcel">导出完整周期Excel表格</button></block><view class="card section" wx:if="{{plans.length}}"><view class="title">计划历史</view><button wx:for="{{plans}}" wx:key="id" class="btn white mt" data-index="{{index}}" bindtap="history">{{item.start}} · {{item.request.days}}天 {{item.closedOn ? '（已归档）' : '（当前）'}}</button></view></view>