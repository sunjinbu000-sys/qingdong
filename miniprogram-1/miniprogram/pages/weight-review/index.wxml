<import src="../../components/states.wxml"/><view class="page"><template is="feedback" data="{{loading,error}}"/><view class="heading">体重人工复核</view><block wx:if="{{!loading && !error}}"><view class="notice">仅授权运营人员可复核，审核保留理由与审计。</view><view class="card mt" wx:for="{{rows}}" wx:key="id"><view>{{item.userId}} · {{item.kg}}kg · {{item.date}}</view><view>{{statusLabels[item.status] || item.status}} {{item.abnormal ? '异常下降' : ''}}</view><view>{{item.evidence}}</view><image wx:if="{{item.evidenceImage}}" src="{{item.evidenceImage}}" mode="widthFix" style="width:100%;margin-top:20rpx"/><view>{{item.appeal}}</view><form wx:if="{{item.status === 'pending' || item.status === 'appealed'}}" bindsubmit="review" data-id="{{item.id}}"><radio-group name="result"><label><radio value="approve" checked/>通过</label><label><radio value="reject"/>驳回</label></radio-group><view class="field"><input name="note" placeholder="审核理由（必填）"/></view><button class="btn primary" form-type="submit">确认审核</button></form></view></block></view>