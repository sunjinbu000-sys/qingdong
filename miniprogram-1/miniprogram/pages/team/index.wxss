.field{padding:20rpx 0}.field input,.field textarea{background:#f2f5ed;padding:20rpx;border-radius:12rpx}.item{padding:24rpx 0;border-bottom:1rpx solid #eee}.actions{display:flex;flex-wrap:wrap;gap:12rpx}.field textarea{width:90%}
.team-kicker{font-size:20rpx;letter-spacing:2rpx;color:#8b7aaa;font-weight:650}.team-main-heading{font-size:44rpx;color:#293553;font-weight:700;line-height:1.5;margin-top:8rpx}.team-subheading{font-size:25rpx;color:#9b8bad;margin-top:8rpx;margin-bottom:30rpx}.team-invitation-hero{position:relative;overflow:hidden;border-radius:48rpx;background:linear-gradient(120deg,#ebfff5,#ccebdc);padding:44rpx 36rpx 34rpx;min-height:420rpx}.team-hero-kicker{font-size:18rpx;letter-spacing:2rpx;color:#6c9e94;position:relative;z-index:2}.team-hero-title{font-size:44rpx;line-height:1.25;font-weight:700;color:#37746d;position:relative;z-index:2;margin-top:20rpx}.team-hero-subtitle{font-size:22rpx;color:#7ba69b;position:relative;z-index:2;margin-top:16rpx;max-width:410rpx}.team-hero-trophy{position:absolute;right:20rpx;top:50rpx;width:260rpx;height:260rpx;opacity:.92}.team-hero-people{position:absolute;right:0;top:240rpx;width:230rpx;height:130rpx;opacity:.7}.page .team-create{position:relative;z-index:3;width:100%;min-width:0;margin-top:32rpx;border-radius:42rpx;background:#fff;color:#397f75;padding:20rpx;font-size:25rpx;font-weight:600;line-height:1.5}.team-quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx;margin-top:28rpx}.page .team-quick{width:100%;min-width:0;position:relative;min-height:205rpx;overflow:hidden;border-radius:42rpx;padding:28rpx 24rpx;text-align:left;line-height:1.5;color:#293553}.team-quick-invite{background:#ffecdf}.team-quick-rank{background:#eae1ff}.team-quick-title{font-size:29rpx;font-weight:650;position:relative;z-index:2}.team-quick-subtitle{font-size:22rpx;color:#9b83a9;margin-top:8rpx;position:relative;z-index:2;max-width:240rpx}.team-quick-art{position:absolute;right:8rpx;bottom:10rpx;width:120rpx;height:120rpx}.team-empty{border:0;border-radius:44rpx;padding:34rpx}.team-empty-copy{font-size:24rpx;color:#9b8bb0;margin-top:8rpx}.team-kind-note{background:#eaf6f0;border-radius:26rpx;padding:24rpx;font-size:23rpx;color:#78998e;margin-top:26rpx;line-height:1.7}.team-refresh{color:#8c6dd4}
