<import src="../../components/states.wxml"/><view class="page qd-theme qd-team"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><view class="team-kicker">BETTER TOGETHER</view><view class="team-main-heading">一起坚持，更有力量</view><view class="team-subheading">找几个同频的人，把日常过好。</view><view class="team-invitation-hero"><view class="team-hero-kicker">7 DAYS · 轻盈习惯挑战</view><view class="team-hero-title">今天的坚持，<view>有人陪你一起</view></view><view class="team-hero-subtitle">认真吃饭、按时记录、互相鼓励</view><image class="team-hero-trophy" src="/images/home/shortcuts/rank.png" mode="aspectFit"/><image class="team-hero-people" src="/images/home/shortcuts/team.png" mode="aspectFit"/><button class="team-create" data-url="/pages/team-editor/index" bindtap="go">创建我的小队</button></view>
<view class="team-quick-grid"><button class="team-quick team-quick-invite" bindtap="joinInvite"><view class="team-quick-title">好友邀我一起</view><view class="team-quick-subtitle">输入邀请码加入</view><image class="team-quick-art" src="/images/home/shortcuts/forum.png"/></button><button class="team-quick team-quick-rank" bindtap="teamRank"><view class="team-quick-title">看看大家的坚持</view><view class="team-quick-subtitle">我的每一步都算数</view><image class="team-quick-art" src="/images/home/shortcuts/rank.png"/></button></view>
<view class="section-head section"><text class="section-title">我的小队</text><button class="link team-refresh" bindtap="refresh">刷新 ›</button></view><view wx:if="{{!myTeams.length}}" class="card team-empty"><view class="title">还没有加入小队</view><view class="team-empty-copy">创建自己的小队，或使用好友的邀请码加入。</view></view><view wx:for="{{myTeams}}" wx:key="id" class="card mt" data-url="/pages/team-detail/index?id={{item.id}}" bindtap="go"><view class="title">{{item.name}}</view><view class="team-empty-copy">{{item.city}} · {{item.members.length}} 人 · {{item.launched ? '挑战中' : '筹队中'}} ›</view></view>
<view class="team-kind-note">♧　PK 比的是好习惯完成率，不是掉秤速度。一起把身体照顾好。</view></block></view>