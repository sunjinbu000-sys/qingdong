<view class="page qd-theme qd-ops"><view wx:if="{{error}}" class="card">{{error}}<button bindtap="retry">重试</button></view><view wx:if="{{accessMessage}}" class="card">{{accessMessage}}<button data-url="/pages/account/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/edit.svg" mode="aspectFit"/><text>账号与身份</text></button></view><view wx:if="{{form}}" class="card"><view wx:if="{{!canHQ}}">当前身份仅可查看，编辑与上架由总部操作。</view><block wx:if="{{kind === 'plan'}}"><view class="title"><image class="section-symbol" src="/images/ui/member.svg"/>会员套餐</view><input disabled="{{!canHQ}}" data-key="form.name" value="{{form.name}}" bindinput="input" placeholder="套餐名称"/><view>有效天数（1–365整数）</view><input disabled="{{!canHQ}}" type="number" data-key="form.days" value="{{form.days}}" bindinput="input"/><view>每日识餐次数（1–1000整数）</view><input disabled="{{!canHQ}}" type="number" data-key="form.dailyLimit" value="{{form.dailyLimit}}" bindinput="input"/><view>价格（元，免费为0）</view><input disabled="{{!canHQ}}" type="digit" data-key="form.price" value="{{form.price}}" bindinput="input"/><view>套餐每人累计限领次数（1–1000）</view><input disabled="{{!canHQ}}" type="number" data-key="form.perUserLimit" value="{{form.perUserLimit||10}}" bindinput="input"/><view class="form-field mt"><text class="form-label">每月补卡次数 / 0–31</text><input disabled="{{!canHQ}}" class="input" type="number" value="{{form.backfillMonthly||0}}" data-key="form.backfillMonthly" bindinput="input"/></view><view class="form-label mt">套餐包含的权益</view><checkbox-group bindchange="features"><label wx:for="{{featureOptions}}" wx:key="id" class="form-label"><checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{!canHQ}}" color="#1d6651"/>{{item.label}}</label></checkbox-group><view>修订 {{form.revision||'新建'}}，保存生成新版本，历史奖励快照保持原样。</view></block><block wx:else><view class="title">首页展示位</view><input disabled="{{!canHQ}}" data-key="form.title" value="{{form.title}}" bindinput="input" placeholder="标题" maxlength="60"/><input disabled="{{!canHQ}}" data-key="form.subtitle" value="{{form.subtitle}}" bindinput="input" placeholder="副标题" maxlength="120"/><picker disabled="{{!canHQ}}" range="{{['站内页面','HTTPS网页','其他小程序','二维码']}}" bindchange="bannerKind"><view>跳转类型：{{form.kind}}</view></picker><input disabled="{{!canHQ}}" data-key="form.target" value="{{form.target}}" bindinput="input" placeholder="页面路径 / HTTPS链接 / AppID与路径 / 二维码说明"/><image wx:if="{{form.imagePath}}" src="{{form.imagePath}}"/><button wx:if="{{canHQ}}" bindtap="image">选择图片 / 二维码</button><button wx:if="{{canHQ && form.imagePath}}" bindtap="removeImage">移除图片</button><view>展示排序（小数值优先）</view><input disabled="{{!canHQ}}" type="number" data-key="form.sort" value="{{form.sort}}" bindinput="input"/></block><view>启用 / 上架 <switch disabled="{{!canHQ}}" data-key="form.enabled" checked="{{form.enabled}}" bindchange="input"/></view><button wx:if="{{canHQ}}" bindtap="save" disabled="{{busy}}">保存{{kind === 'plan'?'套餐':'展示位'}}</button></view></view>