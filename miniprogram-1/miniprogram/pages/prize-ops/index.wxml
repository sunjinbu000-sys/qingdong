<import src="../../components/states.wxml"/><view class="page qd-theme qd-ops"><template is="feedback" data="{{loading,error}}"/><view class="heading">榜单奖品与履约</view><block wx:if="{{!loading && !error}}"><view class="notice">仅运营、总部或管理员可用。档位不可重叠，冻结后不可改奖。</view><view class="card mt"><form bindsubmit="save"><view class="field"><view>月份 YYYY-MM</view><input name="month" type="text" value="{{form.month}}"/></view><view class="field"><view>城市（同城榜）</view><input name="city" type="text" value="{{form.city}}"/></view><view class="field"><view>奖品名称</view><input name="name" type="text" value="{{form.name}}"/></view><view class="field"><view>起始名次</view><input name="from" type="number" value="{{form.from}}"/></view><view class="field"><view>结束名次</view><input name="to" type="number" value="{{form.to}}"/></view><view class="field"><view>总库存</view><input name="quantity" type="number" value="{{form.quantity}}"/></view><view class="field"><view>会员天数</view><input name="days" type="number" value="{{form.days}}"/></view><view class="field"><view>会员每日额度</view><input name="dailyLimit" type="number" value="{{form.dailyLimit}}"/></view><radio-group name="scope"><label><radio value="city" checked/>同城</label><label><radio value="national"/>全国</label></radio-group><radio-group name="metric"><label><radio value="checkin" checked/>签到</label><label><radio value="loss"/>减重</label><label><radio value="teamTotal"/>小队总任务</label><label><radio value="teamAverage"/>小队人均</label></radio-group><radio-group name="type"><label><radio value="member" checked/>会员</label><label><radio value="physical"/>实物</label></radio-group><button class="btn primary mt" form-type="submit">保存档位</button></form></view><view class="card mt"><view class="title"><image class="section-symbol" src="/images/ui/edit.svg"/>已配置奖品</view><view class="item" wx:for="{{ops.prizes}}" wx:key="id">{{item.month}} · {{item.scope}} · {{item.metric}} · 第{{item.from}}–{{item.to}}名 · {{item.name}} · 库存{{item.quantity}}</view><form bindsubmit="settle"><view class="field"><input name="month" placeholder="已结束月份 YYYY-MM"/></view><button class="btn soft" form-type="submit">结算并冻结</button></form></view><view class="card mt"><view class="title">实物履约</view><form wx:for="{{ops.products}}" wx:key="id" bindsubmit="fulfill" data-id="{{item.id}}"><view class="item">{{item.userId}} · {{item.title}} · {{statusLabels[item.status] || item.status}}</view><radio-group name="status"><label><radio value="已发货" checked/>已发货</label><label><radio value="已完成"/>已完成</label></radio-group><button class="btn soft small" form-type="submit">更新履约</button></form></view></block></view>