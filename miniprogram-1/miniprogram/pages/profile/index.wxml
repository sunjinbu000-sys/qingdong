<import src="../../components/states.wxml"/>
<view class="page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading &amp;&amp; !error}}">
<view class="eyebrow">A LITTLE KINDNESS TO MYSELF</view><view class="heading">把自己，放在心上。</view><view class="subtitle mb">每一步，都是属于你的轻盈时光。</view><view class="hero section"><view class="row"><view class="avatar">{{initial}}</view><view class="grow"><view class="profile-title">{{snapshot.profile.nickname}}</view><view class="hero-desc">{{snapshot.signedIn ? (snapshot.profile.city || '还未确认城市') : '欢迎来到轻动俱乐部'}}</view></view><button class="link" data-url="/pages/account/index" bindtap="go">{{snapshot.signedIn ? '编辑 ›' : '开启 ›'}}</button></view><view class="divider"></view><view class="row"><text class="small-text">{{snapshot.signedIn ? '已经认真坚持' : '从今天开始，给自己一点鼓励'}}</text><text wx:if="{{snapshot.signedIn}}" class="number">{{snapshot.totalDays}}<text class="unit">天</text></text></view></view>
<view class="member-entry section" data-url="/pages/membership/index" bindtap="go"><view class="row"><view class="icon-box gold"><image class="icon" src="/images/ui/member.svg"/></view><view class="grow"><view class="title">我的会员权益</view><view class="small-text">查看体验卡、每日识餐额度与权益时光</view></view><text class="arrow">›</text></view></view>
<view class="card section"><button class="menu-item" data-url="/pages/account/index" bindtap="go"><view class="icon-box"><image class="icon" src="/images/ui/sprout.svg"/></view><view class="grow"><view class="title">个人与健康档案</view><text class="small-text">昵称、城市、身高与目标</text></view><text class="arrow">›</text></button><button class="menu-item" data-url="/pages/rewards/index" bindtap="go"><view class="icon-box gold"><image class="icon" src="/images/ui/gift.svg"/></view><view class="grow"><view class="title">我的奖励</view><text class="small-text">每一份坚持，都有回应</text></view><text class="arrow">›</text></button><button class="menu-item" data-url="/pages/health/index" bindtap="go"><view class="icon-box"><image class="icon" src="/images/ui/book.svg"/></view><view class="grow"><view class="title">我的健康日记</view><text class="small-text">把照顾自己的日子收好</text></view><text class="arrow">›</text></button><button class="menu-item" data-url="/pages/privacy/index" bindtap="go"><view class="icon-box"><image class="icon" src="/images/ui/shield.svg"/></view><view class="grow"><view class="title">隐私与数据</view><text class="small-text">分享多少，由你决定</text></view><text class="arrow">›</text></button></view><view class="notice section"><text class="mock-tag">模拟体验</text><view class="mt-sm">当前使用本机模拟账号，不进行真实微信登录。记录保存在此设备，清理缓存可能丢失。</view></view><button wx:if="{{snapshot.signedIn}}" class="btn ghost section" disabled="{{busy}}" bindtap="logout">退出模拟账号</button>
</block><view class="footnote">轻动 · 每一步坚持，都值得被看见</view></view>
