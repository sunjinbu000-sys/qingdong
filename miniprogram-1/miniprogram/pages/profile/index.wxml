<import src="../../components/states.wxml"/>
<view class="page profile-page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}">
<view class="profile-header"><view class="profile-avatar"><image class="profile-avatar-image" src="/images/profile/avatar.png" mode="aspectFit"/></view><view class="profile-name-block"><view class="profile-name">{{snapshot.signedIn ? snapshot.profile.nickname : '打卡用户'}}</view><view class="profile-motto">好好吃饭的每一天</view></view><button class="profile-edit" data-url="/pages/account/index" bindtap="go"><image class="profile-edit-image" src="/images/profile/edit.svg"/></button></view>
<view class="profile-member" data-url="/pages/membership/index" bindtap="go"><image class="profile-crown" src="/images/profile/crown.svg"/><view class="profile-member-copy"><view>轻盈会员，记录更从容</view><text class="profile-member-subtitle">解锁免广告餐食识别</text></view><button class="profile-member-button" data-url="/pages/membership/index" catchtap="go">去看看</button></view>
<view class="profile-stats"><view class="profile-stat-item"><text class="profile-stat-value">{{snapshot.signedIn ? stats.streak : '—'}}</text><text>连续记录 / 天</text></view><view class="profile-stat-item"><text class="profile-stat-value">{{snapshot.signedIn ? stats.meals : '—'}}</text><text>用心记录 / 餐</text></view><view class="profile-stat-item"><text class="profile-stat-value">{{snapshot.signedIn ? stats.badges : '—'}}</text><text>成长勋章 / 枚</text></view></view>
<view class="profile-menu-group"><button wx:for="{{healthMenus}}" wx:key="title" class="profile-menu-row" data-url="/pages/{{item.route}}/index" bindtap="go"><view class="profile-menu-icon"><image class="profile-row-image" src="/images/profile/{{item.icon}}.svg"/></view><view class="profile-menu-copy"><view>{{item.title}}</view><text class="profile-menu-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text></view><text class="profile-chevron">›</text></button></view>
<view class="profile-menu-group"><button wx:for="{{serviceMenus}}" wx:key="title" class="profile-menu-row" data-url="/pages/{{item.route}}/index" bindtap="go"><view class="profile-menu-icon"><image class="profile-row-image" src="/images/profile/{{item.icon}}.svg"/></view><view class="profile-menu-copy"><view>{{item.title}}</view></view><text class="profile-chevron">›</text></button><button class="profile-menu-row" bindtap="logout" disabled="{{busy || !snapshot.signedIn}}"><view class="profile-menu-icon profile-logout">‹</view><view class="profile-menu-copy"><view>{{snapshot.signedIn ? '退出登录' : '尚未登录'}}</view></view><text class="profile-chevron">›</text></button></view>
</block><view wx:if="{{adPlacement}}" class="mock-ad"><text class="pill">模拟广告位</text><view>{{adPlacement.unitId}}</view></view></view>
