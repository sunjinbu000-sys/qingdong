<import src="../../components/states.wxml"/>
<view class="page profile-page"><block wx:if="{{!profileReady}}"><template is="feedback" data="{{loading,error}}"/></block><view wx:elif="{{error}}" class="notice warn">{{error}}</view><block wx:if="{{profileReady || (!loading && !error)}}">
<view class="profile-header"><view class="profile-avatar"><image class="profile-avatar-image" src="/images/profile/avatar.png" mode="aspectFit"/></view><view class="profile-name-block"><view class="profile-name">{{snapshot.profile.nickname || '轻动新朋友'}}</view><view class="profile-motto">每一步，都是属于你的轻盈时光。</view><view wx:if="{{snapshot.signedIn}}" class="profile-account-summary">{{snapshot.profile.city || '待选择城市'}} · 累计坚持 {{snapshot.totalDays}} 天</view></view><button class="profile-edit" data-url="/pages/account/index" bindtap="go"><image class="profile-edit-image" src="/images/profile/edit.svg"/></button></view>
<view class="profile-member" data-url="/pages/membership/index" bindtap="go"><image class="profile-crown" src="/images/profile/crown.svg"/><view class="profile-member-copy"><view>我的会员权益</view><text class="profile-member-subtitle">体验卡、每日识餐额度与权益时光</text></view><button class="profile-member-button" data-url="/pages/membership/index" catchtap="go">去看看</button></view>
<view class="profile-stats"><view class="profile-stat-item"><text class="profile-stat-value">{{snapshot.signedIn ? stats.streak : '—'}}</text><text>连续记录 / 天</text></view><view class="profile-stat-item"><text class="profile-stat-value">{{snapshot.signedIn ? stats.meals : '—'}}</text><text>用心记录 / 餐</text></view><view class="profile-stat-item"><text class="profile-stat-value">{{snapshot.signedIn ? stats.badges : '—'}}</text><text>成长勋章 / 枚</text></view></view>
<view wx:for="{{menuGroups}}" wx:for-item="group" wx:key="title" class="profile-feature-group"><view class="profile-group-title">{{group.title}}</view><view class="profile-menu-group"><button wx:for="{{group.items}}" wx:key="route" class="profile-menu-row" data-url="/pages/{{item.route}}/index" bindtap="go"><view class="profile-menu-icon"><image class="profile-row-image" src="/images/profile/{{item.icon}}.svg"/></view><view class="profile-menu-copy"><view>{{item.title}}</view><text class="profile-menu-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text></view><text class="profile-chevron">›</text></button></view></view>
<view class="notice profile-local-note"><text class="mock-tag">模拟体验</text><view class="mt-sm">当前使用本机模拟账号，记录保存在此设备，尚未接入真实微信登录。</view></view>
<view class="profile-menu-group"><button wx:if="{{snapshot.signedIn}}" class="profile-menu-row" bindtap="logout" disabled="{{busy}}"><view class="profile-menu-icon profile-logout">‹</view><view class="profile-menu-copy"><view>退出登录</view></view><text class="profile-chevron">›</text></button><button wx:else class="profile-menu-row" data-url="/pages/account/index" bindtap="go"><view class="profile-menu-icon profile-logout">›</view><view class="profile-menu-copy"><view>登录并开始记录</view></view><text class="profile-chevron">›</text></button></view>
</block><view wx:if="{{adPlacement}}" class="mock-ad"><text class="pill">模拟广告位</text><view>{{adPlacement.unitId}}</view></view></view>
