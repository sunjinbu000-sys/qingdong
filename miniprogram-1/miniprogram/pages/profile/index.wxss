.profile-page{padding:30rpx 28rpx 40rpx;color:#263254}
.profile-header{display:flex;align-items:center;gap:24rpx;margin:0 6rpx 42rpx}.profile-avatar{width:144rpx;height:144rpx;flex-shrink:0;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden}.profile-avatar-image{width:132rpx;height:132rpx}.profile-name-block{flex:1;min-width:0}.profile-name{font-size:40rpx;line-height:1.4;font-weight:650;overflow-wrap:break-word}.profile-motto{font-size:24rpx;color:#7A7084;line-height:1.6}
.page .profile-edit{width:64rpx;min-width:0;padding:12rpx;background:transparent;flex-shrink:0;line-height:1}.profile-edit-image{width:36rpx;height:36rpx}
.profile-member{display:flex;align-items:center;gap:22rpx;padding:30rpx;border-radius:42rpx;background:linear-gradient(110deg,#ffecd1,#fff4e5);margin-bottom:26rpx}.profile-crown{width:76rpx;height:76rpx;flex-shrink:0}.profile-member-copy{flex:1;min-width:0;color:#aa7038;font-size:28rpx;font-weight:600;line-height:1.5}.profile-member-subtitle{display:block;font-size:22rpx;font-weight:400;color:#b58b61}.page .profile-member-button{width:auto;min-width:0;flex-shrink:0;background:#fff;color:#b47b47;border-radius:40rpx;padding:17rpx 24rpx;font-size:23rpx;line-height:1.5}
.profile-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:#fff;border-radius:44rpx;padding:28rpx 12rpx 34rpx;margin-bottom:26rpx}.profile-stat-item{display:flex;align-items:center;flex-direction:column;gap:10rpx;font-size:22rpx;color:#7A7084}.profile-stat-value{font-size:42rpx;color:#3D354A;font-weight:650;line-height:1.5}
.profile-menu-group{background:#fff;border-radius:44rpx;padding:12rpx 36rpx;margin-bottom:26rpx;overflow:hidden}.page .profile-menu-row{display:flex;align-items:center;gap:22rpx;width:100%;min-width:0;min-height:118rpx;padding:24rpx 0;background:transparent;text-align:left;border-radius:0;color:#263254;border-bottom:1rpx solid #F5F0F8;line-height:1.5}.profile-menu-row:last-child{border-bottom:0}.profile-menu-icon{width:66rpx;height:66rpx;border-radius:22rpx;background:#F5F0F8;flex-shrink:0;display:flex;align-items:center;justify-content:center}.profile-row-image{width:42rpx;height:42rpx}.profile-menu-copy{flex:1;min-width:0;font-size:26rpx;font-weight:600}.profile-menu-subtitle{display:block;font-size:21rpx;font-weight:400;color:#7A7084;margin-top:4rpx}.profile-chevron{font-size:36rpx;color:#805D9F}.profile-logout{font-size:54rpx;color:#7A7084;line-height:1}

.profile-group-title{font-size:24rpx;color:#805D9F;margin:26rpx 20rpx 14rpx;font-weight:600}.profile-local-note{font-size:22rpx;margin:4rpx 0 26rpx}

.profile-account-summary{font-size:21rpx;color:#7A7084;margin-top:7rpx}

/* Feature canvas matches native navigation. */
page{background:#F5F0F8;background-image:none}
