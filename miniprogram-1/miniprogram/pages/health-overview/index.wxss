.calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:7rpx}.calendar-label{text-align:center;font-size:21rpx;color:#8c9c7b}.calendar-day{background:#f6f8f2;border:0;padding:12rpx 0;border-radius:12rpx;font-size:24rpx;line-height:1.2;color:#546c4a}.selected-day{background:#d4ed9c;color:#143f35}.calendar-dots{font-size:15rpx;height:20rpx;margin-top:5rpx;display:flex;justify-content:center;gap:7rpx}.trend{display:flex;gap:18rpx;align-items:flex-end;min-height:210rpx;padding-top:20rpx}.trend-day{min-width:66rpx;text-align:center;font-size:18rpx;color:#8b9a7d}.trend-bars{height:160rpx;display:flex;gap:7rpx;align-items:flex-end;justify-content:center;border-bottom:1rpx solid #dce5d2;margin-bottom:12rpx}.actual-bar{width:17rpx;background:#447456;border-radius:6rpx 6rpx 0 0}.scenario-bar{width:17rpx;background:#bed2a3;border-radius:6rpx 6rpx 0 0}.number{font-size:35rpx}

.overview-date-row{display:grid;grid-template-columns:72rpx minmax(0,1fr) 72rpx;align-items:center;gap:16rpx}.overview-date-picker{min-width:0;justify-self:center}.overview-date-row .date-control{white-space:nowrap;font-weight:700;font-size:29rpx;line-height:1.5;padding:14rpx 24rpx;text-align:center}.page .overview-date-row .date-arrow{width:72rpx;min-width:0;margin:0;padding:10rpx 0;background:transparent}

.overview-dashboard{background:linear-gradient(145deg,#f0fff4,#f7fff9);min-height:100vh;padding:20rpx 24rpx calc(170rpx + env(safe-area-inset-bottom))}.overview-week{display:flex;background:white;border-radius:28rpx;padding:13rpx;box-shadow:0 6rpx 20rpx #80bd8c14;margin:15rpx 0 24rpx;gap:7rpx}.page .overview-week-day{flex:1;width:0;min-width:0;display:flex;flex-direction:column;align-items:center;gap:10rpx;line-height:1.4;padding:15rpx 0 6rpx;margin:0;background:transparent;color:#67775f;border-radius:40rpx}.page .overview-week-day.week-selected{background:#42ae70;color:white}.week-label{font-size:22rpx}.week-number{font-size:32rpx;font-weight:600}.week-dot{height:14rpx;font-size:13rpx}.overview-intake{display:flex;align-items:center;flex-wrap:wrap;background:white;border-radius:32rpx;padding:30rpx;gap:20rpx;box-shadow:0 6rpx 18rpx #8ec99914}.overview-intake-copy{flex:1;min-width:0}.overview-section-title{font-size:29rpx;font-weight:650;color:#3c533e;line-height:1.6;display:flex;justify-content:space-between;align-items:center}.overview-calories{font-size:61rpx;font-weight:700;color:#304b34;line-height:1.4;margin-top:21rpx}.overview-calories>text{font-size:25rpx;font-weight:400}.overview-subtitle{font-size:25rpx;color:#93a38d}.overview-energy-ring{width:230rpx;height:230rpx;border-radius:50%;padding:15rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.overview-ring-inner{background:white;width:200rpx;height:200rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:13rpx}.overview-goal{font-size:37rpx;font-weight:650;color:#36503b}.overview-goal>text{font-size:22rpx;font-weight:400}.overview-macros{display:flex;flex-wrap:wrap;gap:13rpx;width:100%}.overview-macros>text{font-size:22rpx;background:#eef9ee;color:#699a72;padding:8rpx 14rpx;border-radius:25rpx}.overview-pair{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20rpx;margin:24rpx 0}.overview-small-card{min-width:0;background:white;border-radius:30rpx;padding:24rpx 20rpx;box-shadow:0 5rpx 18rpx #8ec99914}.overview-small-card .overview-section-title{font-size:27rpx}.overview-small-unit{font-size:20rpx;color:#98a48f}.overview-exercise-stats{display:flex;justify-content:space-between;margin-top:45rpx;gap:10rpx}.overview-exercise-stats>view{display:flex;flex-direction:column;align-items:center;flex:1}.overview-orange-value{font-size:49rpx;color:#f18b3c;font-weight:650}.overview-mini-chart{height:140rpx;width:240rpx;position:relative;margin:10rpx auto}.overview-mini-line{position:absolute;height:4rpx;background:#f29a50;transform-origin:left center}.overview-mini-dot{position:absolute;width:13rpx;height:13rpx;border:3rpx solid #f39a48;background:white;border-radius:50%;transform:translate(-50%,-50%)}.overview-mini-empty{font-size:21rpx;color:#b1bea7;text-align:center;padding-top:50rpx}.overview-weight-delta{text-align:right;font-size:23rpx;color:#79a88a}.overview-scenes{background:white;border-radius:30rpx;padding:28rpx;margin-bottom:22rpx}.overview-scene-scroll{width:100%;margin-top:20rpx}.overview-scene-row{display:flex;gap:15rpx}.overview-scene{min-width:185rpx;flex-shrink:0;border:1rpx solid #e5ede0;border-radius:24rpx;padding:18rpx;text-align:center}.overview-scene-note{font-size:24rpx;color:#7e9476;max-width:230rpx;white-space:normal;word-break:break-all}.overview-scene-weight{font-size:35rpx;font-weight:650;color:#f18a3b;margin-top:10rpx}.overview-scene-weight>text{font-size:23rpx;font-weight:400;color:#89a07b}.overview-scene-empty{font-size:24rpx;line-height:1.8;color:#a5b59b;padding:22rpx 0}.page .overview-history-toggle{background:transparent;color:#91a986;font-size:23rpx;line-height:1.5;padding:12rpx 0;margin:10rpx 0 0;width:100%;min-width:0}.overview-tools{display:flex;gap:12rpx;margin:20rpx 0}.page .overview-tools button{flex:1;width:0;min-width:0;margin:0;padding:17rpx 5rpx;font-size:23rpx;line-height:1.5;background:#eaf5e9;color:#78a16e;border-radius:25rpx}.overview-record-footer{position:fixed;bottom:0;left:0;right:0;background:white;border-top:1rpx solid #eaf2e5;z-index:15;padding:22rpx 26rpx calc(22rpx + env(safe-area-inset-bottom));display:flex;gap:23rpx}.page .overview-record-meal,.page .overview-record-weight{flex:1;width:0;min-width:0;margin:0;padding:22rpx 8rpx;font-size:30rpx;line-height:1.5;border-radius:50rpx;background:#43ae70;color:white}.page .overview-record-weight{color:#61a876;background:#f2fcf3;border:2rpx solid #6bb382}

.overview-budget-line{font-size:22rpx;color:#8eac83;width:100%;line-height:1.7}.overview-data-note{font-size:20rpx;color:#acb9a3;line-height:1.7;width:100%}

.overview-weight-meta{display:flex;justify-content:space-between;gap:10rpx;font-size:23rpx;color:#e59a58}

/* Feature canvas matches native navigation. */
page{background:#F0F7F2;background-image:none}
