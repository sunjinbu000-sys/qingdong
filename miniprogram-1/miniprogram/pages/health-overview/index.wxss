.calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:7rpx}.calendar-label{text-align:center;font-size:21rpx;color:#8c9c7b}.calendar-day{background:#f6f8f2;border:0;padding:12rpx 0;border-radius:12rpx;font-size:24rpx;line-height:1.2;color:#546c4a}.selected-day{background:#d4ed9c;color:#143f35}.calendar-dots{font-size:15rpx;height:20rpx;margin-top:5rpx;display:flex;justify-content:center;gap:7rpx}.trend{display:flex;gap:18rpx;align-items:flex-end;min-height:210rpx;padding-top:20rpx}.trend-day{min-width:66rpx;text-align:center;font-size:18rpx;color:#8b9a7d}.trend-bars{height:160rpx;display:flex;gap:7rpx;align-items:flex-end;justify-content:center;border-bottom:1rpx solid #dce5d2;margin-bottom:12rpx}.actual-bar{width:17rpx;background:#447456;border-radius:6rpx 6rpx 0 0}.scenario-bar{width:17rpx;background:#bed2a3;border-radius:6rpx 6rpx 0 0}.number{font-size:35rpx}
