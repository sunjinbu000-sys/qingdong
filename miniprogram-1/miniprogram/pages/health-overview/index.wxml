<import src="../../components/states.wxml"/><view class="page overview-dashboard qd-theme qd-diary"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><view wx:if="{{!signedIn}}" class="card"><button class="btn" data-url="/pages/account/index" bindtap="go">登录查看健康记录</button></view><block wx:else><view class="row overview-date-row"><button class="date-arrow" data-days="-1" bindtap="shift">‹</button><picker class="overview-date-picker" mode="date" value="{{date}}" end="{{today}}" start="2000-01-01" bindchange="chooseDate"><view class="date-control">{{date}} ⌄</view></picker><button class="date-arrow" disabled="{{date>=today}}" data-days="1" bindtap="shift">›</button></view><view class="overview-week"><button wx:for="{{weekDays}}" wx:key="date" class="overview-week-day {{item.selected?'week-selected':''}}" disabled="{{item.future}}" data-date="{{item.date}}" bindtap="calendarDate"><text class="week-label">{{item.week}}</text><text class="week-number">{{item.day}}</text><text class="week-dot">{{item.hasRecords?'●':''}}</text></button></view>
<view class="overview-intake"><view class="overview-intake-copy"><view class="overview-section-title">{{date===today?'今日概览':'当日概览'}}</view><view class="overview-calories">{{overview.nutrition.calories}}<text> kcal</text></view><view class="overview-subtitle">已记录摄入</view></view><view class="overview-energy-ring" style="{{energyRingStyle}}"><view class="overview-ring-inner"><text class="overview-subtitle">{{overview.goalConfigured?'自设目标':'参考预算'}}</text><text class="overview-goal">{{overview.goal}}<text> kcal</text></text></view></view><view class="overview-macros"><text>蛋白质 {{overview.nutrition.protein}}g</text><text>碳水 {{overview.nutrition.carb}}g</text><text>脂肪 {{overview.nutrition.fat}}g</text></view><view class="overview-budget-line">预算剩余 {{overview.remaining}} kcal · 运动仅计已估算消耗</view><view class="overview-data-note">仅汇总已记录的营养，只填热量的记录不补算三项营养。</view><view wx:if="{{overview.warning}}" class="overview-data-note">已接近或超过记录预算，按自己的节奏照顾饮食。</view></view>
<view class="overview-pair"><view class="overview-small-card" data-url="/pages/exercise/index?date={{date}}" bindtap="go"><view class="overview-section-title">运动与消耗 ›</view><view class="overview-exercise-stats"><view><text class="overview-orange-value">{{overview.exerciseMinutes}}</text><text class="overview-small-unit">分钟</text></view><view><text class="overview-orange-value">{{overview.hasUnestimatedExercise && !overview.exerciseCalories?'—':overview.exerciseCalories}}</text><text class="overview-small-unit">{{overview.hasUnestimatedExercise?(overview.exerciseCalories?'部分估算 kcal':'消耗未估算'):'估算 kcal'}}</text></view></view></view><view class="overview-small-card" data-url="/pages/weight-trend/index" bindtap="go"><view class="overview-section-title">体重趋势<text class="overview-small-unit">14天 ›</text></view><view class="overview-mini-chart"><view wx:for="{{miniLines}}" wx:key="id" class="overview-mini-line" style="left:{{item.x}}rpx;top:{{item.y}}rpx;width:{{item.width}}rpx;transform:rotate({{item.angle}}deg)"></view><view wx:for="{{miniPoints}}" wx:key="date" class="overview-mini-dot" style="left:{{item.x}}rpx;top:{{item.y}}rpx"></view><view wx:if="{{!miniPoints.length}}" class="overview-mini-empty">暂无体重记录</view></view><view class="overview-weight-meta"><text>{{miniLatest===null?'':miniLatest+' kg'}}</text><text class="overview-weight-delta">{{weightDelta}}</text></view></view></view>
<view class="overview-scenes"><view class="overview-section-title">体重与记录情景</view><scroll-view scroll-x class="overview-scene-scroll"><view class="overview-scene-row"><view wx:for="{{overview.weightScenes}}" wx:key="id" class="overview-scene"><view class="overview-scene-note">{{item.note}}</view><view class="overview-scene-weight">{{item.kg}}<text>kg</text></view></view></view></scroll-view><view wx:if="{{!overview.weightScenes.length}}" class="overview-scene-empty">当日暂无体重记录，记录后会显示体重与备注。</view><button class="overview-history-toggle" bindtap="toggleHistory">{{showHistory?'收起历史与收支情景':'查看历史与收支情景'}} ›</button></view>
<view class="overview-tools"><button bindtap="toggleCalendar">{{showCalendar?'收起月历':'月度日历'}}</button><button data-url="/pages/food-library/index?date={{date}}" bindtap="go">食物与食谱</button><button data-url="/pages/health-profile/index" bindtap="go">预算与忌口</button></view><view wx:if="{{showCalendar}}" class="card section"><view class="section-head"><text class="section-title">{{date}} · 月度日历</text><text class="small-text">圆点表示有记录</text></view><view class="calendar"><text wx:for="{{weekdays}}" wx:key="*this" class="calendar-label">{{item}}</text><view wx:for="{{paddingCells}}" wx:key="*this"></view><button wx:for="{{overview.calendar}}" wx:key="date" class="calendar-day {{item.selected?'selected-day':''}}" disabled="{{item.future}}" data-date="{{item.date}}" bindtap="calendarDate"><text>{{item.day}}</text><view class="calendar-dots"><text wx:if="{{item.hasRecords}}">●</text><text wx:if="{{item.checkedIn}}">✓</text></view></button></view></view><view wx:if="{{showHistory}}" class="card section"><view class="section-title mb">体重与记录情景</view><view wx:if="{{!curve.length}}" class="empty">记下饮食、运动与体重后，这里会留下变化。</view><scroll-view wx:else scroll-x><view class="trend"><view wx:for="{{curve}}" wx:key="date" class="trend-day"><view class="trend-bars"><view class="actual-bar" style="height:{{item.actualHeight}}rpx"></view><view class="scenario-bar" style="height:{{item.scenarioHeight}}rpx"></view></view><text>{{item.dateLabel}}</text></view></view></scroll-view><view class="row mt"><text class="small-text">深绿：手动记录</text><text class="small-text">浅绿：收支情景</text></view><view wx:for="{{curve}}" wx:key="date" class="row record-row"><text class="small-text">{{item.date}}</text><text>{{item.actual === null ? '—' : item.actual}} / {{item.scenario === null ? '—' : item.scenario}} kg</text></view><view class="notice warn mt">浅绿色为原型的记录驱动情景，不是实际测量或可靠预测。缺少完整记录时不据此判断健康。</view></view><view class="card section"><text class="title">饮食与忌口提示</text><text class="caption">{{overview.advice}}</text><text class="caption">已设限制：{{overview.restrictions.length ? restrictionsText : '未设置'}}</text><button class="btn soft mt entry-plan" data-url="/pages/ai-plan/index" bindtap="go"><image class="feature-entry-icon" src="/images/home/shortcuts/ai-plan.png" mode="aspectFit"/><text>查看完整周期的模拟计划 ›</text></button></view><view class="overview-record-footer"><button class="overview-record-meal" data-url="/pages/records/index?type=meal&date={{date}}" bindtap="go">记饮食</button><button class="overview-record-weight" data-url="/pages/records/index?type=weight&date={{date}}" bindtap="go">记体重</button></view></block></block></view>