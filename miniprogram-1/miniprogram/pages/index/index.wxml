<import src="../../components/states.wxml"/>
<view class="page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}">
<view class="row home-location"><text class="home-location-label">你的轻动城市</text><button class="city home-city" data-url="/pages/account/index" bindtap="go"><text class="home-location-pin">⌖</text><text class="home-city-name">{{snapshot.profile.city || '选择城市'}}</text><text class="home-city-arrow">⌄</text></button></view>
<view class="welcome"><view class="welcome-main"><view class="heading home-greeting">嗨，{{snapshot.profile.nickname || '朋友'}}，{{greeting}}。</view><view class="welcome-copy">从一个小小的签到开始<text class="welcome-copy-line">不追赶谁，只比昨天多爱自己一点。</text></view></view><view class="welcome-checkin"><view class="check-ring"><view class="number">{{snapshot.totalDays}}</view><view class="label">累计坚持 / 天</view></view><button class="welcome-checkin-button" bindtap="checkIn" loading="{{busy}}" disabled="{{busy || snapshot.checkedIn}}">{{snapshot.checkedIn ? '今日已打卡' : '立即打卡'}}</button></view></view>
<view class="home-camera nutrition-card section" data-url="/pages/photo/index" bindtap="go">
  <view class="nutrition-wave nutrition-wave-back"></view><view class="nutrition-wave nutrition-wave-front"></view>
  <view class="nutrition-copy"><view class="nutrition-kicker">拍餐识别</view><view class="nutrition-title">这一餐，<view>吃得刚刚好</view></view><view class="nutrition-subtitle">拍下餐食，读懂每一口的营养</view></view>
  <image class="nutrition-art" src="/images/home/photo-nutrition.webp" mode="aspectFit"/>
  <button class="camera-cta" data-url="/pages/photo/index" catchtap="go"><image class="camera-cta-icon" src="/images/home/camera-white.svg"/><text>拍一拍，识别营养</text></button>
</view>
<view class="section full-shortcuts home-shortcuts"><button wx:for="{{shortcuts}}" wx:key="route" class="full-shortcut" data-url="/pages/{{item.route}}/index" bindtap="go"><image class="shortcut-illustration" src="/images/home/shortcuts/{{item.icon}}.webp" mode="aspectFit"/><text>{{item.title}}</text></button></view>
<view wx:if="{{platform.announcement}}" class="notice section">{{platform.announcement}}</view>
<swiper wx:if="{{banners.length}}" class="section" style="height:200rpx" indicator-dots autoplay circular><swiper-item wx:for="{{banners}}" wx:key="id"><view class="banner-slide" data-index="{{index}}" bindtap="banner"><image wx:if="{{item.imagePath}}" class="banner-bg" src="{{item.imagePath}}" mode="aspectFill"/><text class="pill">轻动俱乐部</text><view class="banner-title mt-sm">{{item.title}}</view><view class="banner-subtitle">{{item.subtitle}} ↗</view></view></swiper-item></swiper>
<view class="section nutrition-ledger"><view class="ledger-heading"><text class="ledger-title">今日营养手账</text><button class="ledger-records" data-url="/pages/health/index" bindtap="go">查看记录 ›</button></view><view class="ledger-card"><view class="ledger-card-heading"><text>当日热量收支</text><text class="ledger-formula">目标 + 运动 − 饮食</text></view><view class="ledger-grid">
<view class="ledger-cell"><text class="ledger-label">饮食摄入</text><text class="ledger-value">{{nutritionLedger.intake}}</text><text class="ledger-unit">千卡</text></view>
<view class="ledger-cell"><text class="ledger-label">运动消耗</text><text class="ledger-value">{{nutritionLedger.exercise}}</text><text class="ledger-unit">千卡</text></view>
<view class="ledger-cell ledger-mint"><text class="ledger-label">还可摄入</text><text class="ledger-value">{{nutritionLedger.remaining}}</text><text class="ledger-unit">千卡</text></view>
<view class="ledger-cell ledger-lilac"><text class="ledger-label">蛋白质</text><text class="ledger-value">{{nutritionLedger.protein}}</text><text class="ledger-unit">克</text></view>
<view class="ledger-cell ledger-mint"><text class="ledger-label">碳水</text><text class="ledger-value">{{nutritionLedger.carb}}</text><text class="ledger-unit">克</text></view>
<view class="ledger-cell ledger-peach"><text class="ledger-label">脂肪</text><text class="ledger-value">{{nutritionLedger.fat}}</text><text class="ledger-unit">克</text></view>
</view></view></view>
<view class="section"><view class="section-head"><text class="section-title">一起，做一点小改变</text><button class="link" data-url="/pages/challenges/index" bindtap="go">全部挑战 ›</button></view><view wx:for="{{snapshot.activities}}" wx:key="id" wx:if="{{index < 2}}" class="card activity-preview" data-url="/pages/activity/index?id={{item.id}}" bindtap="go"><view class="row"><view class="activity-art {{item.color}}"><image class="icon" src="/images/ui/{{item.icon}}.svg"/></view><view class="grow"><text class="pill">{{item.tag}}</text><view class="title mt-sm">{{item.title}}</view><view class="small-text mt-sm">累计签到 {{item.days}} 天 · 赠 {{item.rewardDays}} 天会员</view></view><text class="arrow">›</text></view></view></view>
<view class="rank-entry section" data-url="/pages/rank/index" bindtap="go"><view class="row"><image class="icon" src="/images/ui/rank.svg"/><view class="grow"><view class="title">每一份坚持，都闪闪发光</view><view class="small-text">去看看打卡榜上的轻动伙伴</view></view><text class="arrow">↗</text></view></view><view class="section"><view class="section-head"><text class="section-title">活动与奖励广场</text><button class="link" data-url="/pages/events/index" bindtap="go">发现全部 ›</button></view><view class="row mb"><picker range="{{cities}}" bindchange="browseCity"><view class="date-control">浏览 {{browse.city}} ⌄</view></picker><picker mode="date" fields="month" value="{{browse.month}}" bindchange="browseMonth"><view class="date-control">{{browse.month}} ⌄</view></picker></view><view wx:for="{{events}}" wx:key="id" class="card" data-url="/pages/event-detail/index?id={{item.id}}" bindtap="go"><text class="pill">{{item.scope==='all'?'总部活动':item.city+'同城活动'}}</text><view class="title mt">{{item.title}}</view><text class="caption">{{item.location}} · {{item.start}}</text><text class="link">了解并报名 ↗</text></view><button class="btn soft mt" data-url="/pages/reward-tasks/index" bindtap="go">签到、发帖、邀请等多档奖励 ›</button></view><view class="mock-note"><text class="mock-tag">模拟体验</text><text> 数据保存在本机，尚未连接后端服务</text></view>
</block><view wx:if="{{adPlacement}}" class="mock-ad"><text class="pill">模拟广告位</text><view>{{adPlacement.unitId}}</view><text class="caption">已启用该页面展示位，当前不加载真实广告</text></view><view class="footnote">轻动 · 每一步坚持，都值得被看见</view></view>
