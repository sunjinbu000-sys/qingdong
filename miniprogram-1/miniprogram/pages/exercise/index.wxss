.exercise-page{padding:26rpx 22rpx 170rpx}.exercise-page .heading{font-size:38rpx}.exercise-date{display:flex;justify-content:space-between;align-items:center;margin-top:25rpx;padding:24rpx;border:0;border-radius:42rpx}.exercise-date-value{font-size:23rpx;color:#8c6ccf}.exercise-search{display:flex;align-items:center;gap:15rpx;background:#fff;border:1rpx solid #e9e2f4;border-radius:23rpx;margin-top:22rpx;padding:0 22rpx}.search-icon{width:34rpx;height:34rpx;flex-shrink:0}.page .exercise-query{flex:1;min-width:0;background:transparent;border:0;padding:16rpx 0;font-size:24rpx}.exercise-list{background:#fff;border:1rpx solid #ece6f6;border-radius:27rpx;overflow:hidden;margin-top:15rpx}.page .exercise-option{display:flex;align-items:center;gap:18rpx;width:100%;min-width:0;padding:22rpx;text-align:left;border-radius:0;background:#fff;border-bottom:1rpx solid #eee8f5}.exercise-symbol{width:70rpx;height:70rpx;background:#e7f4ed;border-radius:20rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.exercise-icon{width:46rpx;height:46rpx}.exercise-name{font-size:26rpx;font-weight:600;color:#293553}.exercise-caption{font-size:22rpx;color:#9b87ae;line-height:1.7}.exercise-plus{font-size:33rpx;color:#6f6183}.page .exercise-more{background:#fff;color:#8a6bc9;border-radius:0;padding:22rpx;font-size:25rpx}.exercise-disclaimer{font-size:21rpx;color:#a18eae;margin-top:38rpx}.exercise-footer{position:fixed;bottom:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;padding:18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #eee8f5;font-size:22rpx;color:#9785ab}.exercise-total{font-size:29rpx;font-weight:700;color:#8665ce}.exercise-footer .exercise-done{width:210rpx;margin:0;background:#8969d3;color:#fff;border-radius:22rpx;font-size:27rpx}.exercise-sheet{position:fixed;z-index:20;left:16rpx;right:16rpx;bottom:130rpx;background:#fff;border:2rpx solid #dcd0ef;box-shadow:0 0 0 100vmax #30274350;padding:34rpx;border-radius:32rpx}
.manual-exercise-card{margin-top:22rpx;padding:28rpx;border-radius:32rpx}.manual-exercise-card .form-label{color:#55456f;font-size:25rpx}.manual-exercise-card .form-hint{line-height:1.7}
