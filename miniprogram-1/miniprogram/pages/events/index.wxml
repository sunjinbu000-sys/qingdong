<import src="../../components/states.wxml"/><view class="page events-page"><view class="heading">活动广场</view><view wx:if="{{filter!=='mine'}}" class="event-scopes"><button class="event-scope-button {{scope==='national'?'event-scope-selected':''}}" data-scope="national" bindtap="chooseScope">全国</button><button class="event-scope-button {{scope==='city'?'event-scope-selected':''}}" data-scope="city" bindtap="chooseScope">{{city || '选择地区'}}</button></view><view class="events-tabs"><button wx:for="{{filters}}" wx:key="key" class="events-tab {{filter===item.key?'events-tab-active':''}}" data-key="{{item.key}}" bindtap="selectFilter">{{item.label}}</button></view><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><view wx:if="{{filter==='mine' && !signedIn}}" class="card section"><view class="empty">登录后查看参与过的活动和领取的奖励。</view><button class="btn" data-url="/pages/account/index" bindtap="go">登录查看我的活动</button></view><block wx:else><view wx:if="{{filter==='mine'}}" class="events-mine-tabs"><button class="events-mine-tab {{mineFilter==='participated'?'events-mine-active':''}}" data-key="participated" bindtap="selectMine">参与过的活动 {{square.participated.length}}</button><button class="events-mine-tab {{mineFilter==='rewards'?'events-mine-active':''}}" data-key="rewards" bindtap="selectMine">领取的奖励 {{square.rewards.length}}</button></view><block wx:if="{{filter!=='mine' || mineFilter==='participated'}}"><view wx:if="{{!rows.length}}" class="card section empty">{{filter==='mine'?'还没有参与记录，去看看可参与的活动吧。':filter==='ongoing'?'暂时没有正在进行的活动。':'暂时没有可报名的活动，稍后再来看看。'}}</view><view class="card event-card event-list-card" wx:for="{{rows}}" wx:key="id" data-url="/pages/event-detail/index?id={{item.id}}" bindtap="go"><view class="event-list-title">{{item.title}}</view><view class="event-list-main"><image wx:if="{{item.coverImage}}" class="event-list-cover" src="{{item.coverImage}}" mode="aspectFill"/><view wx:else class="event-list-cover event-cover-placeholder"><image class="event-placeholder-icon" src="/images/ui/flag.svg"/><text>轻动活动</text></view><view class="event-list-info"><view class="event-info-line"><text class="event-info-symbol">◷</text><text>{{item.startLabel}}</text></view><view class="event-info-line"><text class="event-info-symbol">⌖</text><text class="event-place">{{item.location}}</text></view><view class="event-info-line event-list-rewards"><image class="event-info-icon" src="/images/ui/gift.svg"/><text>{{item.rewardNames}}</text></view><view class="event-list-region">{{item.scope==='all'?'全国活动':item.city+'活动'}}<text wx:if="{{filter==='mine' || item.registered}}"> · {{item.participationStatus}}</text><text wx:elif="{{filter==='ongoing'}}"> · 进行中</text></view></view></view><view class="event-list-bottom"><view class="event-attendees"><view wx:if="{{item.actualCount}}" class="event-avatar-strip"><image wx:for="{{item.participantMarkers}}" wx:for-item="marker" wx:key="*this" class="event-attendee-avatar" src="/images/ui/person.svg"/></view><text wx:if="{{!item.actualCount}}" class="event-attendee-label">等待伙伴加入</text></view><text class="event-list-count">{{item.actualCount}}/{{item.capacity}}</text><button class="event-join-button" data-url="/pages/event-detail/index?id={{item.id}}" catchtap="go" aria-label="查看活动详情及报名">{{item.registered?'›':'+'}}</button></view><view wx:if="{{item.displayCount>item.actualCount}}" class="event-extra-count">展示人数 {{item.displayCount}} 人 · 实际名额以报名人数为准</view><view wx:if="{{!item.canEnroll && !item.registered}}" class="event-city-limit">限 {{item.city}} 城市用户报名</view></view></block><block wx:else><view wx:if="{{!square.rewards.length}}" class="card section empty">还没有领取活动奖励，达成条件后记得来领取。</view><view wx:for="{{square.rewards}}" wx:key="id" class="card event-card"><view class="event-title">{{item.title}}</view><view class="caption">{{item.date?'领取于 '+item.date:'历史领取记录'}}</view><view wx:for="{{item.items}}" wx:for-item="reward" wx:key="index" class="event-received-reward"><image class="event-received-icon" src="/images/ui/gift.svg"/><view class="grow"><view class="title">{{reward.name}}</view><view class="caption">{{reward.type==='member'?reward.days+'天 · 每日'+reward.dailyLimit+'次':(reward.type==='product'||reward.type==='physical')?'数量 '+(reward.quantity||1):'已领取'}}</view><view wx:if="{{reward.status}}" class="caption">{{reward.status}}</view></view><text class="event-state">已领取</text></view><button class="btn soft mt" data-url="/pages/event-detail/index?id={{item.eventId}}" bindtap="go">查看对应活动 ›</button></view></block></block></block></view>