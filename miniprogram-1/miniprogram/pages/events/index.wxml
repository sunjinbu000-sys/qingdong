<import src="../../components/states.wxml"/><view class="page"><template is="feedback" data="{{loading,error}}"/><view class="heading">活动广场</view><block wx:if="{{!loading && !error}}"><view class="actions"><button class="btn soft small" bindtap="browse">可参与活动</button><button class="btn soft small" bindtap="manage">运营活动管理</button></view><button class="btn soft small" data-url="/pages/event-editor/index" bindtap="go">运营创建活动</button><view class="card mt" wx:for="{{rows}}" wx:key="id"><view class="title">{{item.title}}</view><view wx:if="{{managed}}">{{item.status === 'published' ? '上架中' : '已终止，未领奖资格作废'}}</view><view>{{item.scope === 'all' ? '总部全国' : item.city}} · {{item.location}}</view><view>{{item.start}} 至 {{item.end}}</view><view>展示报名 {{item.displayCount}} 人 · 实际上限 {{item.capacity}}</view><button class="btn soft mt" data-url="/pages/event-detail/index?id={{item.id}}" bindtap="go">详情 / 报名 / 领奖</button></view></block></view>