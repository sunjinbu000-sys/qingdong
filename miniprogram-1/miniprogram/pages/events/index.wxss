.events-page{padding:28rpx 26rpx 50rpx}.events-tabs{display:flex;gap:8rpx;padding:7rpx;background:#eee7f7;border-radius:27rpx;margin:24rpx 0}.page .events-tab{flex:1;min-width:0;width:auto;margin:0;padding:18rpx 3rpx;background:transparent;color:#a08bb6;border-radius:22rpx;font-size:23rpx;white-space:nowrap}.page .events-tab-active{background:#fff;color:#8664bb;font-weight:600}.events-mine-tabs{display:flex;gap:16rpx;margin:26rpx 0}.page .events-mine-tab{flex:1;width:auto;min-width:0;margin:0;padding:18rpx 5rpx;background:#eee6f8;color:#a48bb8;border-radius:24rpx;font-size:23rpx}.page .events-mine-active{background:#ddceef;color:#8060ac}.event-card{margin-top:24rpx;border:0;border-radius:36rpx;padding:28rpx}.event-scope{font-size:21rpx;color:#a68bbd;background:#f3ecfc;border-radius:22rpx;padding:5rpx 14rpx}.event-state{font-size:21rpx;color:#8c73ac;flex-shrink:0}.event-title{font-size:29rpx;font-weight:650;color:#3c3152;line-height:1.6;margin:18rpx 0 12rpx}.event-detail-line{font-size:23rpx;color:#a08bb2;line-height:1.8;overflow-wrap:anywhere}.event-reward-line{display:flex;align-items:center;gap:10rpx;font-size:23rpx;color:#aa84bd;line-height:1.7;margin-top:16rpx}.event-reward-icon{width:32rpx;height:32rpx;flex-shrink:0}.event-received-reward{display:flex;align-items:center;gap:18rpx;margin-top:20rpx;padding:22rpx 0;border-top:1rpx solid #eee7f5}.event-received-icon{width:60rpx;height:60rpx;flex-shrink:0}.event-received-reward .title{font-size:25rpx}
.event-scopes{display:flex;gap:18rpx;margin:25rpx 0 8rpx}.page .event-scope-button{flex:1;min-width:0;width:auto;margin:0;background:#f0eafa;color:#a18bb6;padding:17rpx 8rpx;border-radius:24rpx;font-size:25rpx;border:1rpx solid #e8def3}.page .event-scope-selected{background:#fff;color:#8460bc;border-color:#b89bdf;font-weight:600}.event-city-limit{font-size:21rpx;color:#aa8fbb;margin-top:12rpx}

.events-page .event-list-card{border-radius:24rpx;padding:25rpx 24rpx;margin-top:18rpx}.event-list-title{font-size:29rpx;font-weight:650;color:#3d3450;line-height:1.6;margin-bottom:19rpx}.event-list-main{display:flex;gap:21rpx;align-items:stretch}.event-list-cover{width:160rpx;height:210rpx;border-radius:13rpx;flex-shrink:0}.event-cover-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16rpx;background:linear-gradient(145deg,#e9ddfb,#eef7ef);color:#9f83bc;font-size:21rpx}.event-placeholder-icon{width:66rpx;height:66rpx}.event-list-info{flex:1;min-width:0}.event-info-line{display:flex;align-items:flex-start;gap:12rpx;font-size:24rpx;line-height:1.65;color:#8f849e;margin-bottom:9rpx}.event-info-symbol{font-size:29rpx;color:#aaa0b5;line-height:1.35;flex-shrink:0}.event-info-icon{width:30rpx;height:30rpx;flex-shrink:0;margin-top:5rpx}.event-place{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;word-break:break-all}.event-list-rewards{color:#a48abc;font-size:22rpx}.event-list-region{font-size:20rpx;color:#b2a4c0;margin-top:8rpx}.event-list-bottom{display:flex;align-items:center;gap:16rpx;margin-top:25rpx}.event-attendees{display:flex;align-items:center;flex:1;min-width:0;gap:12rpx}.event-avatar-strip{display:flex;padding-left:5rpx}.event-attendee-avatar{width:43rpx;height:43rpx;border-radius:50%;margin-left:-5rpx;border:2rpx solid white;background:#f1ebfa}.event-attendee-label{font-size:20rpx;color:#ab9bb9}.event-list-count{font-size:25rpx;color:#a28bb8;flex-shrink:0}.page .event-join-button{width:58rpx;height:58rpx;min-width:58rpx;flex-shrink:0;margin:0;padding:0;border-radius:50%;background:#9b83cf;color:white;font-size:39rpx;line-height:54rpx;font-weight:400}.event-extra-count{font-size:19rpx;color:#b5a6bf;margin-top:13rpx}
