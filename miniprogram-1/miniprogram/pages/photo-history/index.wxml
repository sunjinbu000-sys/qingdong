<import src="../../components/states.wxml"/><view class="page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><view class="eyebrow">MY LITTLE FOOD MEMORIES</view><view class="heading">认真吃过的每一餐，都收好。</view><view class="notice section">照片仅自己可见，按记录日期归档。模拟识餐已清楚标注。</view><view wx:if="{{!signedIn}}" class="card section"><button class="btn" data-url="/pages/account/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/edit.svg" mode="aspectFit"/><text>登录查看我的照片</text></button></view><block wx:else><view wx:if="{{!photos.length}}" class="card section empty">还没有照片，拍下今天的这一餐吧。</view><view wx:for="{{photos}}" wx:key="id" class="card section"><image class="history-photo" src="{{item.imagePath}}" mode="aspectFill" data-path="{{item.imagePath}}" bindtap="preview"/><view class="row mt"><view class="grow"><view class="title">{{item.name}}</view><text class="caption">{{item.date}} · {{item.kcal}} kcal</text></view><text class="pill">{{item.source==='recognition'?'模拟识餐':'饮食照片'}}</text></view><view class="footer-buttons mt"><button class="btn soft" data-url="/pages/health/index?date={{item.date}}" bindtap="go"><image class="feature-entry-icon" src="/images/ui/book.svg" mode="aspectFit"/><text>查看当天日记</text></button><button class="btn ghost" data-id="{{item.id}}" bindtap="remove">删除记录</button></view></view></block><button class="btn section" data-url="/pages/photo/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/camera.svg" mode="aspectFit"/><text>记下新的一餐 ↗</text></button></block><view class="footnote">轻动 · 让健康成为一种日常</view></view>
