.photo-history-page{padding:28rpx 24rpx 50rpx}.photo-history-page .heading{font-size:42rpx;margin:8rpx 0 14rpx}.history-intro{font-size:23rpx;color:#9183ad;line-height:1.9;margin-bottom:34rpx}.history-card{padding:26rpx 28rpx 20rpx;background:#fff;border-radius:44rpx;margin-top:24rpx}.history-slot{background:#efe8ff;color:#7c62cd;border-radius:25rpx;padding:6rpx 17rpx;font-size:21rpx}.history-date{font-size:23rpx;color:#8b7caa}.history-meal{display:flex;align-items:center;gap:17rpx;margin-top:22rpx}.history-thumb{width:80rpx;height:80rpx;border-radius:23rpx;flex-shrink:0;background:#f5f1fa}.history-name{font-size:26rpx;font-weight:600;color:#283453;overflow-wrap:anywhere}.history-status{font-size:22rpx;color:#9a8aaf;line-height:1.6;margin-top:4rpx}.history-kcal{font-size:26rpx;font-weight:700;color:#263454;flex-shrink:0;white-space:nowrap}.history-unit{font-size:21rpx}.history-actions{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx}.page .history-delete{background:transparent;color:#b3a8be;font-size:20rpx;padding:4rpx 0;width:auto;margin:0}.page .history-report{background:transparent;color:#8871d1;font-size:22rpx;padding:4rpx 0;width:auto;margin:0}.history-arrow{font-size:32rpx;color:#8b829e;margin-left:7rpx}.history-footnote{text-align:center;margin:34rpx 10rpx;color:#a192b6;font-size:21rpx}.history-empty-icon{width:110rpx;height:110rpx;margin-bottom:20rpx}
/* Feature canvas matches native navigation. */
page{background:#F1EDFA;background-image:none}
