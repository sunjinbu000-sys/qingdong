<import src="../../components/states.wxml"/><view class="page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><view class="eyebrow">PLATFORM OPERATIONS</view><view class="heading">每一次处理，都有迹可循。</view><view wx:if="{{!allowed}}" class="card section"><text>请切换管理员或总部身份查看运营记录。</text><button class="btn mt" data-url="/pages/ops/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/shield.svg" mode="aspectFit"/><text>切换体验身份</text></button></view><block wx:else><view class="segmented section"><button wx:for="{{tabs}}" wx:key="key" class="segment {{tab===item.key?'active':''}}" data-tab="{{item.key}}" bindtap="selectTab">{{item.label}}</button></view><view wx:if="{{tab==='refund'}}" class="section"><button class="btn soft mb" data-url="/pages/orders/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/member.svg" mode="aspectFit"/><text>订单与退款处理 ›</text></button><view wx:if="{{!records.orders.length}}" class="card empty">暂无订单</view><view wx:for="{{records.orders}}" wx:key="id" class="card"><view class="title">{{item.plan.name || item.name}}</view><text class="caption">{{item.id}} · {{statusLabels[item.status] || item.status}}</text><view class="row mt"><text>¥{{item.amount}}</text><button wx:if="{{item.status==='refund_pending'}}" class="btn small" data-id="{{item.id}}" bindtap="refund">确认模拟退款</button></view></view></view><view wx:elif="{{tab==='risk'}}" class="section"><view class="card"><view class="title mb">新增风控名单</view><input class="input" placeholder="用户编号，例如 demo-user" data-key="userId" value="{{risk.userId}}" bindinput="riskInput"/><input class="input mt" placeholder="必填处理原因" data-key="reason" value="{{risk.reason}}" bindinput="riskInput"/><button class="btn mt" bindtap="block" disabled="{{busy}}">加入名单</button></view><view wx:for="{{records.blocks}}" wx:key="id" class="card"><view class="title">{{item.userId}}</view><view class="caption">{{item.reason}}</view><button class="btn soft small mt" data-id="{{item.userId}}" bindtap="unblock">解除限制</button></view></view><view wx:elif="{{tab==='reports'}}" class="section"><view wx:if="{{!records.reports.length}}" class="card empty">暂无举报</view><view wx:for="{{records.reports}}" wx:key="id" class="card"><view class="title">{{item.postTitle || '论坛举报'}}</view><text class="caption">{{item.reason}} · {{statusLabels[item.status] || item.status}}</text><button class="btn soft small mt" data-post="{{item.postId}}" data-id="{{item.id}}" bindtap="resolve">填写处理结论</button></view><button class="btn soft mt" data-url="/pages/forum-ops/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/sun.svg" mode="aspectFit"/><text>前往内容审核 ›</text></button></view><view wx:elif="{{tab==='products'}}" class="section"><button class="btn soft mb" data-url="/pages/reward-ledger/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/sun.svg" mode="aspectFit"/><text>活动奖励撤回与履约 ›</text></button><view wx:for="{{records.products}}" wx:key="id" class="card"><view class="title">{{item.title}}</view><text class="caption">{{item.userId}} · {{statusLabels[item.status] || item.status}}</text><button class="btn soft small mt" data-id="{{item.id}}" bindtap="fulfill">确认已完成履约</button></view><view wx:if="{{!records.products.length}}" class="card empty">暂无实物履约任务</view></view><view wx:else class="section"><view wx:if="{{!records.audit.length}}" class="card empty">暂无操作记录</view><view wx:for="{{records.audit}}" wx:key="id" class="card"><view class="row"><view class="title">{{item.action}}</view><text class="pill">{{item.actor}}</text></view><view class="caption">{{item.detail || item.target}}</view><text class="caption">{{item.date}}</text></view></view></block></block><view class="footnote">轻动 · 让健康成为一种日常</view></view>
