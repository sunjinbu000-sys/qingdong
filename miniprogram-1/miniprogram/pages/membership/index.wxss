.membership-page{padding:22rpx 24rpx 50rpx}.membership-banner{position:relative;overflow:hidden;min-height:330rpx;border-radius:48rpx;padding:38rpx 30rpx;background:linear-gradient(120deg,#fff6dc,#fce5d4 62%,#f5d5d5);color:#865d35}.member-copy{position:relative;z-index:2;max-width:72%}.member-kicker{font-size:18rpx;font-weight:600;letter-spacing:2rpx}.member-caption{font-size:22rpx;margin-top:8rpx}.member-name{font-size:38rpx;font-weight:700;line-height:1.4;margin-top:10rpx}.member-expiry{font-size:22rpx;margin-top:10rpx}.member-balance{margin-top:24rpx;padding-top:16rpx;border-top:1rpx solid #d8b18b50;font-size:25rpx}.quota-number{font-size:40rpx;font-weight:700;margin-left:9rpx}.crown-stage{position:absolute;right:0;bottom:12rpx;width:280rpx;height:290rpx}.crown-art{position:absolute;right:5rpx;top:0;width:250rpx;height:250rpx;z-index:1;transform:rotate(8deg)}.crown-plinth{position:absolute;bottom:2rpx;right:8rpx;width:235rpx;height:56rpx;border-radius:50%;background:linear-gradient(#fff8e6,#edbb93);box-shadow:0 13rpx 0 #eac09f,0 22rpx 22rpx #c6917130}.section-head .section-title{font-size:30rpx;letter-spacing:0}.section-head .link{font-size:21rpx;flex-shrink:0}.member-plans{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx}.page .member-plan{width:100%;min-width:0;display:flex;flex-direction:column;align-items:center;padding:30rpx 8rpx;min-height:242rpx;background:#fff;border:2rpx solid #eee1d5;border-radius:38rpx;color:#293553;line-height:1.5}.page .member-plan-selected{background:#f4effd;border-color:#a68be4}.plan-name{font-size:27rpx}.plan-price{font-size:43rpx;line-height:1.3;font-weight:700;margin:20rpx 0 12rpx;white-space:nowrap}.price-currency{font-size:23rpx;margin-right:3rpx}.plan-detail,.plan-features{font-size:19rpx;color:#9384a4}.plan-features{margin-top:7rpx}.member-benefits{background:#fff;border-radius:46rpx;padding:25rpx 34rpx}.benefit{display:flex;align-items:center;gap:20rpx;padding:24rpx 0;border-bottom:1rpx solid #eee9f7}.benefit:last-child{border-bottom:0}.benefit-symbol{width:64rpx;height:64rpx;background:#f1ebfb;border-radius:18rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.benefit-symbol .benefit-line-icon{width:40rpx;height:40rpx}.benefit .title{font-size:25rpx}.benefit .caption{font-size:20rpx;margin-top:7rpx}.benefit-check{font-size:30rpx;color:#5b5378}.member-agreement{margin:30rpx 6rpx 22rpx}.agreement-label{display:flex;align-items:flex-start;font-size:21rpx;color:#8d80aa;line-height:1.8;gap:10rpx}.agreement-label checkbox{transform:scale(.72);transform-origin:top left;width:36rpx;flex-shrink:0;margin-top:3rpx}.page .agreement-link{background:transparent;text-align:left;padding:8rpx 0 0 46rpx;font-size:21rpx;color:#876bcf}.page .member-submit{min-height:96rpx;border-radius:30rpx;background:linear-gradient(120deg,#947fe9,#7762cd);border:0;font-size:26rpx}.purchase-hint{text-align:center;font-size:20rpx;color:#9b8fae;margin:20rpx 0}.timeline-dot{width:16rpx;height:16rpx;border:3rpx solid #c5b6e1;border-radius:50%;flex-shrink:0}.active-dot{background:#a08bd8}.timeline-card .title{font-size:25rpx}.timeline-card .caption{font-size:20rpx}.timeline-card .pill{white-space:nowrap}.page .login-member{margin-top:12rpx;font-size:23rpx}.membership-page .service-links .btn{font-size:22rpx}