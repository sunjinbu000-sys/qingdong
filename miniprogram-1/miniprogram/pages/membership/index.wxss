.member-hero{background:#ece8d6}.member-icon{width:62rpx;height:62rpx}.member-hero .hero-title{font-size:31rpx}.member-quota{display:grid;grid-template-columns:1fr 1fr 1fr;margin-top:28rpx;padding-top:24rpx;border-top:1rpx solid #dadcc4}.member-quota>view{padding-left:16rpx;border-left:1rpx solid #dadcc4}.member-quota>view:first-child{border:0;padding-left:0}.member-quota .number{font-size:50rpx;color:#4e6542}.timeline-dot{width:16rpx;height:16rpx;border:3rpx solid #b4c4a4;border-radius:50%;align-self:flex-start;margin-top:14rpx}.active-dot{background:#91ae73;border-color:#91ae73}.timeline-card{padding:25rpx 22rpx}.timeline-card .title{font-size:26rpx}.timeline-card .small-text{font-size:20rpx}.timeline-card .pill{white-space:nowrap}.benefit{display:flex;gap:18rpx;padding:20rpx 0}.benefit .inline-icon{flex-shrink:0;margin-top:8rpx}
