<import src="../../components/states.wxml"/>
<view class="page membership-page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}">
<view class="membership-banner"><view class="member-copy"><text class="member-kicker">轻动 · 轻盈会员</text><view class="member-caption">当前会员等级</view><view class="member-name">{{membership.activeGrant ? membership.activeGrant.title : '未开通会员'}}</view><view class="member-expiry">{{membership.activeGrant ? '有效至：' + membership.activeGrant.end + ' 00:00' : '有效期：未开通'}}</view><view class="member-balance">今日剩余 <text class="quota-number">{{membership.remaining}}</text> 次</view><view class="member-caption">已用 {{membership.used}} 次 · 每日额度 {{membership.dailyLimit}} 次</view></view><view class="crown-stage"><image class="crown-art" src="/images/home/shortcuts/rank.png" mode="aspectFit"/><view class="crown-plinth"></view></view></view>
<view wx:if="{{!signedIn}}" class="notice mt">登录后查看本人权益，新人体验卡以账号实际发放为准。<button class="login-member" data-url="/pages/account/index" bindtap="go">登录 / 完善资料 ›</button></view>
<view class="section-head section"><text class="section-title">选一份适合你的陪伴</text><button class="link" data-url="/pages/orders/index" bindtap="go">购买记录 ›</button></view>
<view class="member-plans"><button wx:for="{{plans}}" wx:key="id" class="member-plan {{selectedPlanId === item.id ? 'member-plan-selected' : ''}}" data-id="{{item.id}}" bindtap="selectPlan"><view class="plan-name">{{item.name}}</view><view class="plan-price"><text class="price-currency">¥</text>{{item.price}}</view><view class="plan-detail">{{item.days}} 天 · 每天 {{item.dailyLimit}} 次</view><view class="plan-features" wx:for="{{item.featureLabels}}" wx:for-item="feature" wx:key="*this">{{feature}}</view></button></view><view wx:if="{{!plans.length}}" class="empty card">暂无在售套餐</view>
<view class="member-benefits section"><view class="benefit"><view class="benefit-symbol"><image class="benefit-line-icon" src="/images/profile/camera.svg"/></view><view class="grow"><view class="title">拍餐识别，按套餐额度使用</view><view class="caption">免广告范围以生效权益配置为准</view></view><text class="benefit-check">✓</text></view><view class="benefit"><view class="benefit-symbol"><image class="benefit-line-icon" src="/images/ui/book.svg"/></view><view class="grow"><view class="title">营养分析与轻动计划</view><view class="caption">分析品质一致，计划次数按现有规则共用</view></view><text class="benefit-check">✓</text></view><view class="benefit"><view class="benefit-symbol"><image class="benefit-line-icon" src="/images/profile/shield.svg"/></view><view class="grow"><view class="title">权益清晰，随时可查</view><view class="caption">有效期、每日额度与订单状态实时查询</view></view><text class="benefit-check">✓</text></view></view>
<view class="member-agreement"><checkbox-group bindchange="agreementChanged"><label class="agreement-label"><checkbox value="agree" checked="{{agreed}}" color="#8872d6"/><text>我已阅读并同意会员服务说明，确认本次为固定期限、非自动续费的模拟会员。</text></label></checkbox-group><button class="agreement-link" bindtap="showAgreement">阅读《会员服务说明》 ›</button></view>
<button class="member-submit btn" bindtap="purchase" disabled="{{busy || !agreed || !selectedPlanId || !entry.available}}">确认所选套餐，模拟开通会员</button><view class="purchase-hint">{{entry.message}} · 不会真实扣款</view>
<view class="section"><view class="section-head"><text class="section-title">我的权益时光</text><text class="small-text">按领取先后顺延</text></view><view wx:if="{{!membership.timeline.length}}" class="card empty">暂无权益记录</view><view wx:for="{{membership.timeline}}" wx:key="id" class="card timeline-card"><view class="row"><view class="timeline-dot {{item.status === '生效中' ? 'active-dot' : ''}}"></view><view class="grow"><view class="title">{{item.title}}</view><view class="caption">{{item.start}} — {{item.end}} 00:00</view><view class="caption">{{item.days}} 天 · 每日 {{item.dailyLimit}} 次</view></view><text class="pill">{{item.status}}</text></view></view></view>
<view class="card section"><view class="title">使用规则</view><view class="caption">每日额度按北京时间 00:00 重置，不累积。新领取的权益依次排队，同一天仅一份权益提供额度。</view><view class="caption">取消选图不消耗次数；成功生成识别结果按规则扣次，保存日记不重复扣次，删除日记不返还。</view><view class="caption">当前尚未提供代币钱包及代币兑换，套餐价格使用现有配置。</view></view>
<view class="service-links section"><button class="btn soft" data-url="/pages/member-services/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/member.svg"/>会员补卡与提醒</button><button class="btn soft" data-url="/pages/ai-plan/index" bindtap="go"><image class="feature-entry-icon" src="/images/home/shortcuts/ai-plan.png"/>轻动计划</button><button class="btn soft" data-url="/pages/invite/index" bindtap="go"><image class="feature-entry-icon" src="/images/home/shortcuts/invite.png"/>邀请奖励</button><button class="btn soft" data-url="/pages/challenges/index" bindtap="go"><image class="feature-entry-icon" src="/images/home/shortcuts/badges.png"/>挑战体验卡</button></view>
<view class="notice warn section">当前为本地模拟版本，未接入真实支付；照片识别与计划的模拟状态以对应页面说明为准。</view></block></view>