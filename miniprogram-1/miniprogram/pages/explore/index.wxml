<import src="../../components/states.wxml"/><view class="page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><view class="eyebrow">THE WHOLE QINGDONG CLUB</view><view class="heading">每一种轻动，都在这里。</view><view class="subtitle">按原型完整呈现健康、生活、挑战与运营板块。</view><view class="hero section"><view class="row"><view><text class="pill light">{{roleLabel}}</text><view class="hero-title">{{sections.length}} 个原型板块，逐一探索。</view></view><button class="btn soft small" data-url="/pages/ops/index" bindtap="go">切换身份</button></view></view><view class="grid2 section"><button wx:for="{{extras}}" wx:key="route" class="shortcut-card" data-url="{{item.route}}" bindtap="go"><image class="icon" src="/images/ui/{{item.icon}}.svg"/><text>{{item.title}}</text></button></view><view class="section"><view class="section-title mb">健康、生活与个人服务</view><view class="card"><button wx:for="{{consumer}}" wx:key="id" class="menu-item" data-url="{{item.route}}" bindtap="go"><view class="grow"><view class="title">{{item.label}}</view><text class="caption">{{item.description}}</text></view><text class="arrow">›</text></button></view></view><view class="section"><view class="section-head"><text class="section-title">运营与总部工作台</text><text class="pill">按身份控制操作</text></view><view class="card"><button wx:for="{{operations}}" wx:key="id" class="menu-item" data-url="{{item.route}}" bindtap="openOps"><view class="grow"><view class="title">{{item.label}}</view><text class="caption">{{item.description}}</text></view><text class="arrow">›</text></button></view></view></block><view class="footnote">轻动 · 让健康成为一种日常</view></view>
