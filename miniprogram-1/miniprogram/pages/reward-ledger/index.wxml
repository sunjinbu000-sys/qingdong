<view class="page qd-theme qd-reward"><view wx:if="{{error}}" class="card">{{error}}<button bindtap="retry">重试</button></view><view wx:if="{{accessMessage}}" class="card">{{accessMessage}}<button data-url="/pages/account/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/edit.svg" mode="aspectFit"/><text>账号与身份</text></button></view><view wx:if="{{canAdmin}}" class="card"><view class="title">人工完成核验</view><picker range="{{activities}}" range-key="title" bindchange="activity"><view>{{activityTitle||'选择人工核验、活动或榜单任务'}}</view></picker><input data-key="userId" bindinput="input" placeholder="用户编号（必填）"/><button bindtap="confirmManual">确认完成证据</button><view>核验后用户需自行领取达标奖励；重复核验不会重复累计。</view></view><view wx:for="{{ledger}}" wx:key="id" class="card"><view class="title">{{item.title}} · {{item.tierName}}</view><view>{{item.userId}} · {{item.name}} · {{statusLabels[item.status] || item.status}}</view><view>{{item.date}} · {{item.rewardType}}</view><view wx:if="{{item.grantId}}">权益段 {{item.start}} 至 {{item.end}}</view><view wx:if="{{item.reason}}">撤回原因：{{item.reason}}</view><button wx:if="{{item.rewardType !== 'member' && item.status === '待履约'}}" data-id="{{item.id}}" bindtap="fulfill">确认实物 / 产品已履约</button><button wx:if="{{item.status !== '已撤回'}}" data-id="{{item.id}}" bindtap="chooseRevoke">撤回奖励</button><view wx:if="{{revokeId === item.id}}"><textarea data-key="reason" bindinput="input" placeholder="填写撤回原因（必填）" maxlength="300"/><button bindtap="revoke">确认撤回并记录原因</button></view></view><view wx:if="{{canAdmin && !ledger.length}}" class="card">暂无奖励发放记录</view></view>