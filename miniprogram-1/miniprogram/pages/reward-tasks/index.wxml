<import src="../../components/states.wxml"/><view class="page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><view class="eyebrow">EVERY EFFORT GETS A RESPONSE</view><view class="heading">每一次达标，都有轻盈奖励。</view><view class="subtitle">签到、分享、邀请、线下活动，共用会员奖励池。</view><view class="reward-filter section"><button class="reward-filter-trigger" bindtap="toggleDropdown"><view class="row start"><image class="reward-filter-icon" src="/images/ui/gift.svg"/><view><view class="reward-filter-label">选择奖励分类</view><view class="reward-filter-value">{{filterLabel}}</view></view></view><text class="reward-dropdown-arrow">{{dropdownOpen?'⌃':'⌄'}}</text></button><scroll-view wx:if="{{dropdownOpen}}" scroll-y class="reward-filter-options"><button wx:for="{{types}}" wx:key="key" class="reward-filter-option {{filter===item.key?'reward-option-selected':''}}" data-key="{{item.key}}" bindtap="filter"><text>{{item.key==='all'?'全部奖励':item.label+'奖励'}}</text><text>{{filter===item.key?'✓':''}}</text></button></scroll-view></view><view class="reward-results-head"><text>{{filterLabel}}</text><text class="reward-results-count">{{shown.length}} 个活动</text></view><view wx:if="{{!shown.length}}" class="card section empty">当前暂无相关活动。</view><view wx:for="{{shown}}" wx:key="id" class="card reward-activity"><view class="row"><text class="pill">{{item.typeLabel}}</text><text class="small-text">{{item.city==='all'?'总部活动':item.city}}</text></view><view class="reward-activity-title">{{item.title}}</view><text class="caption">活动时间：{{item.start}} — {{item.end}}</text><text class="caption">领取截止：{{item.claimUntil}}</text><text class="caption">当前进度 {{item.progress}} · {{item.claimMode==='highest'?'仅领取最高达标档':'各档独立领取'}}</text><button class="btn soft small mt" data-type="{{item.type}}" bindtap="goTask">去完成条件 ›</button><view wx:for="{{item.tiers}}" wx:for-item="tier" wx:key="id" class="tier-card reward-tier mt"><view class="row"><view class="grow"><view class="reward-tier-name">{{tier.name}}</view><view class="reward-tier-gift">{{tier.rewardName}}</view><text class="caption">目标 {{tier.target}} · 剩余 {{tier.remaining}} 份</text></view><text class="pill gold">{{tier.status}}</text></view><view class="progress mt"><view class="progress-fill" style="width:{{tier.progressPercent}}%"></view></view><button class="btn mt" disabled="{{!tier.canClaim || busy}}" data-activity="{{item.id}}" data-tier="{{tier.id}}" bindtap="claim">{{tier.status==='已领取'?'✓ 已领取':tier.canClaim?'领取这一档奖励':tier.status}}</button></view></view><button class="btn ghost section" data-url="/pages/rewards/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/gift.svg" mode="aspectFit"/><text>我的奖励与领取记录 ›</text></button><view class="notice mt">本机模拟奖励，不实际发放会员或实物。</view></block><view class="footnote">轻动 · 让健康成为一种日常</view></view>
