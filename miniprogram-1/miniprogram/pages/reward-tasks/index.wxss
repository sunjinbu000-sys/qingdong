.reward-filter{background:#fff;border:1rpx solid #FBF6EC;border-radius:30rpx;overflow:hidden}.page .reward-filter-trigger{display:flex;align-items:center;justify-content:space-between;width:100%;background:#fff;text-align:left;padding:23rpx 26rpx;border-radius:0}.reward-filter-icon{width:60rpx;height:60rpx;padding:10rpx;border-radius:18rpx;background:#FBF6EC}.reward-filter-label{font-size:20rpx;color:#746757}.reward-filter-value{font-size:29rpx;font-weight:600;color:#96672F;margin-top:3rpx}.reward-dropdown-arrow{font-size:32rpx;color:#746757}.reward-filter-options{max-height:520rpx;height:520rpx;border-top:1rpx solid #FBF6EC}.page .reward-filter-option{width:100%;display:flex;align-items:center;justify-content:space-between;margin:0;padding:20rpx 30rpx;background:#fff;border-radius:0;font-size:25rpx;color:#96672F;border-bottom:1rpx solid #FBF6EC}.page .reward-option-selected{background:#FBF6EC;color:#96672F;font-weight:600}.reward-results-head{display:flex;align-items:center;justify-content:space-between;margin:32rpx 4rpx 20rpx;font-size:29rpx;font-weight:600;color:#453B30}.reward-results-count{font-size:21rpx;font-weight:400;color:#96672F}.reward-activity{margin-top:22rpx;padding:28rpx;border-radius:36rpx}.reward-activity-title{font-size:33rpx;line-height:1.5;font-weight:700;color:#453B30;margin:20rpx 0 14rpx}.reward-tier{background:#FBF6EC;border:1rpx solid #FBF6EC;border-radius:26rpx;padding:24rpx}.reward-tier-name{font-size:25rpx;font-weight:600;color:#66513B}.reward-tier-gift{font-size:27rpx;font-weight:600;color:#96672F;margin-top:6rpx}.reward-tier .pill{flex-shrink:0}.reward-tier .btn{min-height:74rpx;font-size:24rpx}.reward-activity .caption{font-size:22rpx;line-height:1.8}.page .reward-activity>.btn{margin-top:20rpx}
/* Feature canvas matches native navigation. */
page{background:#FBF6EC;background-image:none}

.reward-total-progress{margin:24rpx 0 16rpx;padding:20rpx;border:1rpx solid #EFE5D5;border-radius:20rpx;background:#FFFDFA}.reward-progress-heading{display:flex;justify-content:space-between;align-items:center;gap:16rpx;font-size:24rpx;font-weight:600;color:#66513B}.reward-progress-percent{font-size:30rpx;font-weight:700}.reward-progress-track{height:16rpx;border-radius:16rpx;overflow:hidden;background:#E9E5DC;margin-top:14rpx}.reward-progress-bar{height:100%;border-radius:16rpx;transition:width .25s ease,background-color .25s ease}.reward-progress-detail{font-size:21rpx;color:#746757;margin-top:12rpx;line-height:1.7}.reward-tier-progress-label{font-size:23rpx;margin-top:22rpx;font-weight:600}
