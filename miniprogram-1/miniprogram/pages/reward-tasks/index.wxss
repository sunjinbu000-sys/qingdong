.reward-filter{background:#fff;border:1rpx solid #e9e0f5;border-radius:30rpx;overflow:hidden}.page .reward-filter-trigger{display:flex;align-items:center;justify-content:space-between;width:100%;background:#fff;text-align:left;padding:23rpx 26rpx;border-radius:0}.reward-filter-icon{width:60rpx;height:60rpx;padding:10rpx;border-radius:18rpx;background:#f0eafa}.reward-filter-label{font-size:20rpx;color:#a091b5}.reward-filter-value{font-size:29rpx;font-weight:600;color:#655181;margin-top:3rpx}.reward-dropdown-arrow{font-size:32rpx;color:#9c86bd}.reward-filter-options{max-height:520rpx;height:520rpx;border-top:1rpx solid #eee7f6}.page .reward-filter-option{width:100%;display:flex;align-items:center;justify-content:space-between;margin:0;padding:20rpx 30rpx;background:#fff;border-radius:0;font-size:25rpx;color:#9784ac;border-bottom:1rpx solid #f1ebf7}.page .reward-option-selected{background:#f2ecfc;color:#8160c4;font-weight:600}.reward-results-head{display:flex;align-items:center;justify-content:space-between;margin:32rpx 4rpx 20rpx;font-size:29rpx;font-weight:600;color:#403452}.reward-results-count{font-size:21rpx;font-weight:400;color:#a08cad}.reward-activity{margin-top:22rpx;padding:28rpx;border-radius:36rpx}.reward-activity-title{font-size:31rpx;line-height:1.5;font-weight:650;color:#293553;margin:20rpx 0 14rpx}.reward-tier{background:#f8f5fc;border:1rpx solid #ece4f5;border-radius:26rpx;padding:24rpx}.reward-tier-name{font-size:23rpx;color:#9c86b2}.reward-tier-gift{font-size:27rpx;font-weight:600;color:#65517d;margin-top:6rpx}.reward-tier .pill{flex-shrink:0}.reward-tier .btn{min-height:74rpx;font-size:24rpx}.reward-activity .caption{font-size:22rpx;line-height:1.8}.page .reward-activity>.btn{margin-top:20rpx}