<view class="page"><view wx:if="{{accessMessage}}" class="card">{{accessMessage}}<button data-url="/pages/account/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/edit.svg" mode="aspectFit"/><text>账号与登录</text></button></view><view wx:if="{{error}}" class="card">{{error}}<button bindtap="retry">重试</button></view><view class="card">总部专属：核对文字和全部图片，审核说明至少4字。<button data-url="/pages/word-ops/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/sun.svg" mode="aspectFit"/><text>词库管理</text></button></view><view wx:for="{{posts}}" wx:key="id" class="card"><view>{{item.nickname}} · {{statusLabels[item.status] || item.status}}</view><view>{{item.text}}</view><button wx:if="{{item.status !== 'deleted' && item.status !== 'withdrawn'}}" data-url="/pages/forum-editor/index?id={{item.id}}" bindtap="go"><image class="feature-entry-icon" src="/images/ui/sun.svg" mode="aspectFit"/><text>编辑内容并重新送审</text></button><image wx:for="{{item.images}}" wx:for-item="src" wx:key="*this" src="{{src}}"/><input data-id="{{item.id}}" bindinput="note" placeholder="审核说明 / 举报处理结论"/><view wx:if="{{item.status !== 'deleted' && item.status !== 'withdrawn' && item.status !== 'draft'}}"><button data-id="{{item.id}}" data-status="approved" bindtap="review">全部通过</button><button data-id="{{item.id}}" data-status="rejected" bindtap="review">拒绝 / 下架</button><button wx:if="{{item.status === 'approved'}}" data-id="{{item.id}}" bindtap="recommend">推荐 / 取消推荐</button></view><view wx:for="{{item.reports}}" wx:for-item="report" wx:key="id">举报：{{report.reason}} · {{report.status}}<button wx:if="{{report.status === 'pending'}}" data-id="{{report.id}}" data-post="{{item.id}}" bindtap="resolve">处理举报</button></view><view wx:for="{{item.audit}}" wx:for-item="audit" wx:key="index">{{audit.note}}</view></view></view>