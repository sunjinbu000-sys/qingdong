

.account-heading{font-size:42rpx;font-weight:700;line-height:1.5;color:#293553}.account-subtitle{font-size:24rpx;color:#9b8ab0;margin:12rpx 0 34rpx;line-height:1.7}.account-form{background:#fff;border-radius:48rpx;padding:34rpx}.account-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24rpx}.account-field{margin:20rpx 0 30rpx;min-width:0}.account-label{display:block;font-size:25rpx;color:#293553;margin-bottom:16rpx}.page .account-input,.account-picker{width:100%;min-width:0;box-sizing:border-box;border:1rpx solid #e5dcf3;border-radius:26rpx;background:#fcfaff;padding:23rpx;font-size:26rpx;color:#35425c;line-height:1.5;min-height:92rpx}.account-input{height:92rpx}.account-picker{display:flex;justify-content:space-between;gap:10rpx}.account-record-mode{border-radius:22rpx;background:#f6f2fc;color:#8b6ad0;padding:22rpx;font-size:23rpx;line-height:1.7}.account-health-note{border-radius:30rpx;background:#eaf6ef;color:#829f90;padding:25rpx;font-size:23rpx;line-height:1.8;margin-top:26rpx}.account-consent{display:flex;align-items:flex-start;gap:12rpx;color:#9a8bab;font-size:22rpx;line-height:1.9;margin-top:24rpx}.account-consent checkbox{transform:scale(.75);transform-origin:top left;flex-shrink:0;width:36rpx;margin-top:4rpx}.page .account-save{width:100%;min-width:0;border-radius:32rpx;background:linear-gradient(110deg,#9c83ec,#7d64d5);padding:27rpx;color:#fff;font-size:26rpx;font-weight:600;line-height:1.5;margin-top:28rpx}
