<import src="../../components/states.wxml"/>
<view class="page qd-theme qd-profile"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}">
<view class="account-heading">从了解自己开始</view><view class="account-subtitle">建立一份属于你的健康档案，慢慢找到舒服的节奏。</view><view wx:if="{{!signedIn}}" class="hero section"><view class="icon-box large"><image class="icon" src="/images/ui/sprout.svg"/></view><view class="hero-title">每一个开始，都值得鼓励</view><view class="hero-desc">先用模拟账号体验轻动。你的记录仅保存在这台设备。</view><button class="btn mt" loading="{{busy}}" disabled="{{busy}}" bindtap="login">使用模拟账号体验 ↗</button><view class="form-hint mt">此入口不进行真实微信登录，不获取手机号。</view></view>
<block><view class="account-form"><view class="account-field"><text class="account-label">怎么称呼你</text><input class="account-input" type="text" value="{{form.nickname}}" data-field="nickname" bindinput="input" placeholder="输入昵称"/></view><view class="account-field"><text class="account-label">所在城市 · 必选</text><view data-field="city" bindtap="openSelector"><view class="account-picker"><text>{{form.city || '请选择城市'}}</text><text>⌄</text></view></view></view><view class="account-grid"><view class="account-field"><text class="account-label">年龄</text><input class="account-input" type="number" value="{{form.age}}" data-field="age" bindinput="input" placeholder="填写年龄"/></view><view class="account-field"><text class="account-label">性别</text><view data-field="sex" bindtap="openSelector"><view class="account-picker"><text>{{form.sex}}</text><text>⌄</text></view></view></view><view class="account-field"><text class="account-label">身高（cm）</text><input class="account-input" type="digit" value="{{form.height}}" data-field="height" bindinput="input" placeholder="填写身高"/></view><view class="account-field"><text class="account-label">当前体重（kg）</text><input class="account-input" type="digit" value="{{form.currentWeight}}" data-field="currentWeight" bindinput="input" placeholder="填写体重"/></view></view><view class="account-field"><text class="account-label">我的方向</text><view data-field="direction" bindtap="openSelector"><view class="account-picker"><text>{{form.direction}}</text><text>⌄</text></view></view></view><view class="account-field"><text class="account-label">特殊健康状态（仅用于功能适配）</text><view data-field="healthStatus" bindtap="openSelector"><view class="account-picker"><text>{{form.healthStatus}}</text><text>⌄</text></view></view></view><view class="account-field"><text class="account-label">目标体重（kg，选填）</text><input class="account-input" type="digit" value="{{form.targetWeight}}" data-field="targetWeight" bindinput="input" placeholder="按照自己的节奏"/></view><view class="account-field"><text class="account-label">每日摄入热量目标（kcal，选填）</text><input class="account-input" type="digit" value="{{form.calorieGoal}}" data-field="calorieGoal" bindinput="input" placeholder="自行填写目标"/></view><view class="account-record-mode">当前使用记录模式，不生成摄入热量建议。</view><view class="account-field"><text class="account-label">起始体重（kg，选填）</text><input class="account-input" type="digit" value="{{form.initialWeight}}" data-field="initialWeight" bindinput="input" placeholder="用于体重趋势对比"/></view><view class="account-field"><text class="account-label">目标周期（天，选填）</text><input class="account-input" type="number" value="{{form.goalDays}}" data-field="goalDays" bindinput="input" placeholder="按照自己的节奏"/></view><view class="account-field"><text class="account-label">忌口 / 过敏（选填）</text><input class="account-input" type="text" value="{{form.restrictions}}" data-field="restrictions" bindinput="input" placeholder="例如：鸡蛋、牛奶"/></view></view><view class="account-health-note">♧　未成年人和特殊健康状态用户保留记录功能，不自动生成减重热量目标或参与减重竞赛。</view><checkbox-group bindchange="consent"><label class="account-consent"><checkbox value="agree" checked="{{consent}}" color="#9277dd"/><text>我同意为营养记录与健康功能处理上述信息，可在设置中查看、导出和删除。</text></label></checkbox-group><button class="account-save" disabled="{{busy}}" loading="{{busy}}" bindtap="save">保存档案，开始记录</button></block>
</block><view class="footnote">轻动 · 每一步坚持，都值得被看见</view></view>

<view wx:if="{{selector}}" class="account-select-overlay"><view class="account-select-mask" bindtap="closeSelector" catchtouchmove="stopScroll"></view><view class="account-select-sheet"><view class="account-select-heading">{{selector.title}}</view><scroll-view scroll-y class="account-select-options" style="height:{{selector.height}}rpx"><button wx:for="{{selector.options}}" wx:key="*this" class="account-select-option {{selector.selected===index?'is-selected':''}}" data-index="{{index}}" bindtap="selectOption"><text class="account-option-label">{{item}}</text><text class="account-option-mark">{{selector.selected===index?'✓':'○'}}</text></button></scroll-view><view class="account-select-footer"><button class="account-select-cancel" bindtap="closeSelector">取消</button><button class="account-select-confirm" bindtap="confirmSelector">确认选择</button></view></view></view>
