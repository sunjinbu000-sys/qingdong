.privacy-settings{padding:22rpx 22rpx 40rpx;color:#293553}.privacy-card{background:#fff;border-radius:48rpx;padding:38rpx 34rpx;margin-bottom:26rpx}.privacy-title{font-size:32rpx;font-weight:650;line-height:1.5;margin-bottom:22rpx}.privacy-switch-row{display:flex;justify-content:space-between;align-items:center;gap:22rpx;min-height:90rpx;font-size:25rpx}.privacy-switch-row switch{transform:scale(.78);transform-origin:right center;flex-shrink:0}.privacy-help{font-size:23rpx;color:#805D9F;line-height:1.85;margin-top:20rpx}.privacy-time-label{font-size:25rpx;margin:22rpx 0 12rpx}.privacy-time-picker{display:flex;justify-content:space-between;background:#fcfaff;border:1rpx solid #EDE3F3;border-radius:26rpx;padding:23rpx;font-size:27rpx}.page .privacy-primary{width:100%;min-width:0;border-radius:32rpx;background:linear-gradient(110deg,#7A7084,#805D9F);color:#fff;font-size:27rpx;font-weight:600;line-height:1.5;padding:24rpx;margin-top:20rpx;box-shadow:0 10rpx 24rpx #7A70841a}.privacy-actions{padding:14rpx 34rpx}.page .privacy-action{display:flex;align-items:center;gap:18rpx;width:100%;min-width:0;min-height:112rpx;padding:25rpx 0;background:transparent;border-radius:0;border-bottom:1rpx solid #F5F0F8;text-align:left;font-size:25rpx;line-height:1.5;color:#293553}.privacy-action:last-child{border:0}.privacy-action-label{flex:1;min-width:0}.privacy-shield{width:62rpx;height:62rpx;border-radius:22rpx;background:#F5F0F8;display:flex;align-items:center;justify-content:center}.privacy-shield-icon{width:42rpx;height:42rpx}.page .privacy-danger{color:#d17a91}.privacy-bottom-note{border-radius:28rpx;background:#F5F0F8;padding:24rpx;font-size:23rpx;color:#805D9F;line-height:1.8}.page .privacy-logout{width:auto;min-width:0;margin:38rpx auto 0;background:transparent;padding:12rpx 28rpx;color:#7A7084;font-size:25rpx;line-height:1.5}

/* Feature canvas matches native navigation. */
page{background:#F5F0F8;background-image:none}
