<import src="../../components/states.wxml"/><view class="page qd-theme qd-challenge"><template is="feedback" data="{{loading,error}}"/><view class="heading">历史榜与奖励</view><block wx:if="{{!loading && !error}}"><view class="notice">月结冻结成绩和奖品；每人仅领一次，按档位库存发放。</view><view class="card mt" wx:for="{{rows}}" wx:key="id" wx:for-item="archive"><view class="title">{{archive.month}} · {{archive.scope}} · {{archive.metric}}</view><view>冻结于 {{archive.frozenAt}}</view><view class="item" wx:for="{{archive.rows}}" wx:key="id">{{item.rank}} · {{item.nickname}} · {{item.score}}</view><view class="mt" wx:for="{{archive.prizes}}" wx:key="id">第{{item.from}}–{{item.to}}名：{{item.name}}</view><button class="btn primary mt" data-id="{{archive.id}}" bindtap="claim">领取我的奖励</button></view></block></view>