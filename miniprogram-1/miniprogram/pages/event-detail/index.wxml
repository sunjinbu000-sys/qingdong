<import src="../../components/states.wxml"/><view class="page activity-detail-page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{event}}"><image wx:if="{{event.coverImage}}" class="activity-detail-cover" src="{{event.coverImage}}" mode="aspectFill" bindtap="previewCover"/><view wx:else class="activity-detail-cover activity-cover-empty"><image class="activity-cover-icon" src="/images/ui/flag.svg"/><text>轻动 · 一起参与每一份改变</text></view><view class="activity-info"><view class="activity-title">{{event.title}}</view><view class="activity-info-row"><image class="activity-info-icon" src="/images/ui/flag.svg"/><text>{{event.scope==='all'?'全国活动':event.city+'城市活动'}}</text></view><view class="activity-info-row"><text class="activity-info-symbol">⌖</text><text>{{event.location}}</text></view><view class="activity-info-row"><text class="activity-info-symbol">◷</text><text>{{startLabel}} — {{endLabel}}</text></view><view class="activity-info-row"><image class="activity-info-icon" src="/images/ui/person.svg"/><text>已报名 {{event.actualCount}} 人，剩余 {{event.remaining}} 个名额</text></view><view class="activity-info-row"><image class="activity-info-icon" src="/images/ui/edit.svg"/><text>{{event.phase}}</text></view><view class="activity-registration-time">报名时间：{{regStartLabel}} — {{regEndLabel}}</view></view>
<view class="activity-section"><view class="activity-section-title">活动详情</view><view class="activity-description">{{event.detail}}</view></view><view class="activity-section"><view class="activity-section-title">参与条件与奖励</view><view class="activity-caption">完成全部条件，经运营逐项核验后，可一次领取全部奖励。</view><view wx:for="{{event.conditions}}" wx:key="*this" class="activity-condition"><text>{{index+1}}</text><view>{{item}}</view></view><view wx:for="{{event.rewards}}" wx:key="name" class="activity-reward"><image class="activity-info-icon" src="/images/ui/gift.svg"/><view><view>{{item.name}}</view><view class="activity-caption">{{item.type==='member'?item.days+'天会员 · 每日'+item.dailyLimit+'次':(item.type==='physical'?'实物奖励':'产品奖励')+' · '+(item.quantity||1)+'份'}}</view></view></view></view>
<view wx:if="{{event.registrations.length || event.canManage}}" id="event-progress" class="activity-section"><view class="activity-section-title">{{event.canManage?'报名与核验':'我的报名进度'}}</view><view wx:if="{{event.ownClaimed}}" class="activity-caption">已领取本活动奖励，可在“我的活动”查看记录。</view><view wx:for="{{event.registrations}}" wx:key="id" wx:for-item="reg" class="activity-registration"><view class="activity-registration-status">{{event.canManage?reg.userId+' · ':''}}{{statusLabels[reg.status]||reg.status}}</view><view wx:for="{{reg.schema}}" wx:key="key" class="activity-caption">{{item.label}}：{{reg.values[item.key]}}</view><form wx:if="{{event.canManage && reg.status==='registered'}}" bindsubmit="verify" data-user="{{reg.userId}}"><checkbox-group name="checks"><label wx:for="{{event.conditions}}" wx:key="index" class="activity-check"><checkbox value="{{index}}" checked="{{reg.verified[index]}}" color="#9677ce"/>{{item}}</label></checkbox-group><button class="btn soft mt" form-type="submit" disabled="{{busy}}">保存逐项核验</button></form><block wx:elif="{{reg.status==='registered'}}"><view wx:for="{{event.conditions}}" wx:key="index" class="activity-caption">{{reg.verified[index]?'✓ 已核验':'○ 待核验'}} · {{item}}</view></block></view><button wx:if="{{event.ownRegistration && !event.ownClaimed && event.status==='published'}}" class="activity-cancel" bindtap="confirmCancel" disabled="{{busy}}">取消本次报名</button><block wx:if="{{event.canManage}}"><button class="btn soft mt" data-url="/pages/event-editor/index?id={{event.id}}" bindtap="go">编辑活动</button><button class="activity-cancel" data-a="withdraw" bindtap="act" disabled="{{busy}}">下架并终止活动</button></block></view>
<button class="activity-share" open-type="share">↗<text>分享</text></button><view class="activity-bottom"><view class="activity-bottom-summary"><text>{{event.ownClaimed?'奖励已领取':event.ownRegistration?'你的参与，值得记录':'一起参与，收获改变'}}</text><view>{{event.ownClaimed?'可在我的活动查看':event.ownRegistration?'完成条件后领取奖励':'剩余 '+event.remaining+' 个名额'}}</view></view><button class="activity-primary" bindtap="primary" disabled="{{busy || ctaDisabled}}" loading="{{busy}}">{{cta}}</button></view></block>
<view wx:if="{{registrationOpen}}" class="activity-form-mask" bindtap="closeRegistration" catchtouchmove="preventMove"></view><view wx:if="{{registrationOpen}}" class="activity-form-sheet"><view class="activity-form-heading"><text>报名活动</text><button bindtap="closeRegistration">关闭</button></view><view class="activity-caption">{{event.title}}</view><form bindsubmit="enroll"><scroll-view scroll-y class="activity-form-scroll"><view class="activity-field" wx:for="{{event.fields}}" wx:key="key"><view>{{item.label}} {{item.required?'*':''}}</view><textarea wx:if="{{item.type==='textarea'}}" name="{{item.key}}" data-key="{{item.key}}" bindinput="registrationInput" value="{{registrationValues[item.key] || ''}}" maxlength="300" placeholder="请输入{{item.label}}"/><input wx:else name="{{item.key}}" data-key="{{item.key}}" bindinput="registrationInput" value="{{registrationValues[item.key] || ''}}" type="{{item.type==='number'?'digit':item.type==='tel'?'number':'text'}}" maxlength="{{item.type==='tel'?20:100}}" placeholder="请输入{{item.label}}"/></view><view wx:if="{{!event.fields.length}}" class="activity-caption">确认后将使用当前账号报名活动。</view></scroll-view><button class="activity-submit" form-type="submit" disabled="{{busy}}" loading="{{busy}}">确认报名</button></form></view></view>