<import src="../../components/states.wxml"/><view class="page"><template is="feedback" data="{{loading,error}}"/><view class="heading">活动详情</view><block wx:if="{{!loading && !error}}"><view wx:if="{{event}}"><view class="card"><image wx:if="{{event.coverImage}}" class="event-detail-cover" src="{{event.coverImage}}" mode="widthFix"/><view class="title">{{event.title}}</view><view>{{event.location}} · {{event.start}} 至 {{event.end}}</view><view class="mt">{{event.detail}}</view><view class="caption mt">报名 {{event.regStart}} 至 {{event.regEnd}}</view><view class="title mt">全部达标条件</view><view wx:for="{{event.conditions}}" wx:key="*this">• {{item}}</view><view class="title mt">达标一次领取全部奖励</view><view wx:for="{{event.rewards}}" wx:key="name">{{item.name}} · {{item.type === 'member' ? item.days + '天会员' : '实物 / 产品'}}</view><form bindsubmit="enroll"><view class="field" wx:for="{{event.fields}}" wx:key="key"><view>{{item.label}} {{item.required ? '*' : ''}}</view><textarea wx:if="{{item.type === 'textarea'}}" name="{{item.key}}" maxlength="300" placeholder="请输入{{item.label}}"/><input wx:else name="{{item.key}}" type="{{item.type === 'number' ? 'digit' : 'text'}}" maxlength="{{item.type === 'tel' ? 20 : 100}}" placeholder="请输入{{item.label}}"/></view><button class="btn primary mt" form-type="submit">提交报名</button></form><view class="actions mt"><button class="btn soft small" data-a="cancel" bindtap="act">取消报名</button><button class="btn primary small" data-a="claim" bindtap="act">领取全部奖励</button></view></view><view class="card mt"><view class="title">报名与核验</view><view class="item" wx:for="{{event.registrations}}" wx:key="id" wx:for-item="reg"><view>{{reg.userId}} · {{statusLabels[reg.status] || reg.status}}</view><view wx:for="{{reg.schema}}" wx:key="key">{{item.label}}：{{reg.values[item.key]}}</view><form wx:if="{{event.canManage}}" bindsubmit="verify" data-user="{{reg.userId}}"><checkbox-group name="checks"><label wx:for="{{event.conditions}}" wx:key="index"><checkbox value="{{index}}"/>{{item}}</label></checkbox-group><button class="btn soft mt" form-type="submit">运营逐项核验</button></form></view><button wx:if="{{event.canManage}}" class="btn soft mt" data-url="/pages/event-editor/index?id={{event.id}}" bindtap="go"><image class="feature-entry-icon" src="/images/ui/sun.svg" mode="aspectFit"/><text>运营编辑</text></button><button wx:if="{{event.canManage}}" class="btn soft mt" data-a="withdraw" bindtap="act">运营下架并终止</button></view></view></block></view>