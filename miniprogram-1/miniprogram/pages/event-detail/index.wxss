page{background:#f6f3fa}.page.activity-detail-page{padding:0 0 calc(145rpx + env(safe-area-inset-bottom));color:#463B35}.activity-detail-cover{width:100%;height:430rpx;display:block}.activity-cover-empty{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:25rpx;background:linear-gradient(145deg,#FAE6D8,#e3f3e8);color:#A36241;font-size:27rpx}.activity-cover-icon{width:95rpx;height:95rpx}.activity-info{background:white;padding:26rpx 26rpx 22rpx}.activity-title{font-size:33rpx;font-weight:650;line-height:1.6;margin-bottom:18rpx}.activity-info-row{display:flex;align-items:flex-start;gap:15rpx;padding:19rpx 0;border-top:1rpx solid #f3eef7;font-size:25rpx;line-height:1.65;color:#A36241;word-break:break-all}.activity-info-icon{width:35rpx;height:35rpx;flex-shrink:0;margin-top:3rpx}.activity-info-symbol{font-size:33rpx;color:#75685F;width:35rpx;text-align:center;flex-shrink:0;line-height:1.2}.activity-registration-time{font-size:21rpx;line-height:1.8;color:#75685F;padding-top:12rpx}.activity-section{background:white;margin-top:18rpx;padding:27rpx}.activity-section-title{font-size:29rpx;font-weight:650;margin-bottom:24rpx}.activity-description{font-size:27rpx;line-height:1.9;white-space:pre-wrap;word-break:break-all}.activity-caption{font-size:23rpx;color:#75685F;line-height:1.8;margin:10rpx 0}.activity-condition{display:flex;gap:16rpx;align-items:flex-start;margin:22rpx 0;font-size:26rpx;line-height:1.6}.activity-condition>text{display:block;background:#FCF2EB;color:#75685F;min-width:38rpx;border-radius:50%;text-align:center}.activity-reward{display:flex;gap:15rpx;align-items:flex-start;border-top:1rpx solid #f2edf6;padding:20rpx 0;font-size:26rpx}.activity-registration{padding:24rpx 0;border-bottom:1rpx solid #FCF2EB}.activity-registration-status{font-size:26rpx;font-weight:600;word-break:break-all}.activity-check{display:block;font-size:25rpx;line-height:1.7;margin:19rpx 0}.page .activity-cancel{width:auto;min-width:0;background:transparent;color:#75685F;font-size:25rpx;line-height:1.6;margin:24rpx 0 0;padding:12rpx 0}.page .activity-share{position:fixed;right:20rpx;bottom:calc(175rpx + env(safe-area-inset-bottom));border-radius:50%;background:#75685F;color:white;font-size:35rpx;width:82rpx;height:82rpx;min-width:0;line-height:1.1;padding:8rpx 0;box-shadow:0 4rpx 14rpx #75685F33;z-index:10}.activity-share text{display:block;font-size:21rpx;margin-top:3rpx}.activity-bottom{position:fixed;bottom:0;left:0;right:0;z-index:11;background:white;border-top:1rpx solid #FCF2EB;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));display:flex;align-items:center;gap:18rpx}.activity-bottom-summary{flex:1;min-width:0;font-size:24rpx;line-height:1.7;color:#A36241}.activity-bottom-summary>view{font-size:20rpx;color:#75685F}.page .activity-primary{width:330rpx;min-width:0;flex-shrink:0;border-radius:32rpx;background:linear-gradient(100deg,#75685F,#A36241);color:white;font-size:27rpx;padding:22rpx 10rpx;line-height:1.5;margin:0}.page .activity-primary[disabled]{background:#FAE6D8;color:#75685F}
