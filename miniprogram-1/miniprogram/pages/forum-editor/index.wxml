<view class="page composer"><view wx:if="{{error}}" class="notice warn">{{error}}<button class="link" bindtap="retry">重试</button></view><view class="composer-media"><view wx:for="{{images}}" wx:key="*this" class="composer-photo"><image class="composer-preview" src="{{item}}" mode="aspectFill"/><button class="media-remove" data-index="{{index}}" bindtap="remove">×</button></view><button wx:if="{{!video && images.length < 9}}" class="media-add" bindtap="addImage" disabled="{{busy}}"><image class="media-add-icon" src="/images/ui/gallery.svg"/><text>添加图片</text></button><button wx:if="{{!images.length && !video}}" class="media-add" bindtap="addVideo" disabled="{{busy}}"><image class="media-add-icon" src="/images/ui/video.svg"/><text>添加视频</text></button></view><view wx:if="{{video}}" class="composer-video-wrap"><video class="composer-video" src="{{video}}" controls/><button class="video-remove" bindtap="removeVideo">移除视频</button></view><input class="composer-title" data-key="title" value="{{title}}" bindinput="input" maxlength="60" placeholder="填写标题更容易上推荐哦～" placeholder-class="composer-placeholder"/><textarea class="composer-text" data-key="text" value="{{text}}" bindinput="input" maxlength="2000" placeholder="说点什么吧…" placeholder-class="composer-placeholder"/><view class="composer-counter">{{text.length}} / 2000</view><view class="topic-area"><button class="topic-trigger" bindtap="toggleTopics">{{kind ? '# ' + kind : '+ 添加话题'}}</button><view wx:if="{{topicOpen}}" class="topic-options"><view class="topic-caption">选择话题，即选择发布分类</view><button wx:for="{{kinds}}" wx:key="*this" class="topic-option {{kind === item ? 'topic-selected' : ''}}" data-kind="{{item}}" bindtap="chooseTopic"># {{item}}</button></view></view><view class="composer-privacy"><text>匿名发布</text><switch checked="{{anonymous}}" bindchange="anon" color="#927ad6"/></view><view class="composer-hint">可添加最多9张图片，或1个60秒内、20MB以内的视频。内容经人工审核通过后公开，编辑后会重新审核。</view><view class="composer-footer"><button class="draft-button" data-draft="{{true}}" bindtap="save" disabled="{{busy}}">保存草稿</button><button class="publish-button" bindtap="save" disabled="{{busy || !kind || (text.length < 5 && !images.length && !video)}}">发布笔记</button></view></view>