<view class="page"><view wx:if="{{error}}" class="card">{{error}}<button bindtap="retry">重试</button></view><view class="card"><input data-key="title" value="{{title}}" bindinput="input" maxlength="60" placeholder="标题（可选）"/><textarea data-key="text" value="{{text}}" bindinput="input" maxlength="2000" placeholder="分享生活（至少5字或图片）"/><picker range="{{kinds}}" bindchange="kind">分类：{{kind}}</picker><view>匿名 <switch checked="{{anonymous}}" bindchange="anon"/></view><view wx:for="{{images}}" wx:key="*this"><image src="{{item}}"/><button data-index="{{index}}" bindtap="remove">移除图片</button></view><button bindtap="addImage">相册 / 拍照（最多3张）</button><button data-draft="{{true}}" bindtap="save">保存草稿</button><button bindtap="save">提交总部审核</button><view>审核文字和全部图片后公开，编辑将重新送审。</view></view></view>