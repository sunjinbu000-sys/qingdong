.composer{padding:34rpx 24rpx 180rpx}.composer-media{display:flex;flex-wrap:wrap;gap:20rpx}.page .media-add{width:188rpx;height:188rpx;margin:0;padding:24rpx 8rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14rpx;border:1rpx solid #ded7e9;background:#ffffffb0;border-radius:18rpx;color:#a59bae;font-size:25rpx;line-height:1.5}.media-add-icon{width:62rpx;height:62rpx;opacity:.65}.composer-photo{position:relative;width:188rpx;height:188rpx}.composer-preview{width:100%;height:100%;border-radius:18rpx}.page .media-remove{position:absolute;right:5rpx;top:5rpx;width:42rpx;height:42rpx;border-radius:50%;padding:0;background:#473b6580;color:#fff;line-height:40rpx}.page .composer-title{margin:28rpx 0 0;background:transparent;border:0;border-bottom:1rpx solid #e4ddec;border-radius:0;padding:18rpx 0;height:94rpx;font-size:30rpx;width:100%;color:#293553}.page .composer-text{margin:0;width:100%;height:290rpx;min-height:290rpx;padding:26rpx 0 8rpx;background:transparent;border:0;border-radius:0;color:#35405a;font-size:28rpx;line-height:1.8}.composer-placeholder{color:#b1a7c0}.composer-counter{text-align:right;color:#b2a7bf;font-size:20rpx;padding:8rpx 0 18rpx;border-bottom:1rpx solid #e4ddec}.topic-area{padding:28rpx 0}.page .topic-trigger{margin:0;width:auto;display:inline-flex;min-height:58rpx;padding:8rpx 22rpx;align-items:center;border:1rpx solid #aa8add;border-radius:40rpx;background:#fff8;color:#8b68c6;font-size:25rpx}.topic-options{margin-top:20rpx;padding:24rpx;background:#fff;border-radius:26rpx;display:flex;flex-wrap:wrap;gap:14rpx}.topic-caption{width:100%;font-size:21rpx;color:#9587a9;margin-bottom:6rpx}.page .topic-option{margin:0;padding:12rpx 20rpx;background:#f5f1fb;color:#8a78aa;border-radius:20rpx;font-size:23rpx}.page .topic-selected{background:#e9dffa;color:#7753bd}.composer-privacy{display:flex;align-items:center;justify-content:space-between;font-size:24rpx;color:#847593;margin:14rpx 0}.composer-hint{font-size:21rpx;color:#a092af;line-height:1.8}.composer-footer{position:fixed;bottom:0;left:0;right:0;max-width:1000rpx;margin:0 auto;display:flex;align-items:center;gap:18rpx;padding:22rpx 24rpx calc(22rpx + env(safe-area-inset-bottom));background:#f8f5fcf5}.page .draft-button{width:190rpx;flex-shrink:0;margin:0;border-radius:50rpx;min-height:82rpx;background:#eee7f8;color:#8b74b6}.page .publish-button{flex:1;min-width:0;width:auto;margin:0;border-radius:50rpx;min-height:82rpx;background:linear-gradient(120deg,#a08ae5,#8269cc);color:#fff;font-weight:600}.page .publish-button[disabled]{background:#ddd8e4;color:#fff;opacity:1}.composer-video{width:100%;height:340rpx;border-radius:24rpx}.composer-video-wrap{margin-top:20rpx}.page .video-remove{font-size:22rpx;margin-top:10rpx;width:auto;color:#a17eaa}