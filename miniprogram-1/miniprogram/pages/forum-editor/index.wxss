.composer{padding:34rpx 24rpx 180rpx}.composer-media{display:flex;flex-wrap:wrap;gap:20rpx}.page .media-add{width:188rpx;height:188rpx;margin:0;padding:24rpx 8rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14rpx;border:1rpx solid #DEF0EE;background:#ffffffb0;border-radius:18rpx;color:#5B6F72;font-size:25rpx;line-height:1.5}.media-add-icon{width:62rpx;height:62rpx;opacity:.65}.composer-photo{position:relative;width:188rpx;height:188rpx}.composer-preview{width:100%;height:100%;border-radius:18rpx}.page .media-remove{position:absolute;right:5rpx;top:5rpx;width:42rpx;height:42rpx;border-radius:50%;padding:0;background:#293F4480;color:#fff;line-height:40rpx}.page .composer-title{margin:28rpx 0 0;background:transparent;border:0;border-bottom:1rpx solid #DEF0EE;border-radius:0;padding:18rpx 0;height:94rpx;font-size:30rpx;width:100%;color:#293553}.page .composer-text{margin:0;width:100%;height:290rpx;min-height:290rpx;padding:26rpx 0 8rpx;background:transparent;border:0;border-radius:0;color:#35405a;font-size:28rpx;line-height:1.8}.composer-placeholder{color:#5B6F72}.composer-counter{text-align:right;color:#5B6F72;font-size:20rpx;padding:8rpx 0 18rpx;border-bottom:1rpx solid #DEF0EE}.topic-area{padding:28rpx 0}.page .topic-trigger{margin:0;width:auto;display:inline-flex;min-height:58rpx;padding:8rpx 22rpx;align-items:center;border:1rpx solid #5B6F72;border-radius:40rpx;background:#fff8;color:#267F83;font-size:25rpx}.topic-options{margin-top:20rpx;padding:24rpx;background:#fff;border-radius:26rpx;display:flex;flex-wrap:wrap;gap:14rpx}.topic-caption{width:100%;font-size:21rpx;color:#267F83;margin-bottom:6rpx}.page .topic-option{margin:0;padding:12rpx 20rpx;background:#f5f1fb;color:#267F83;border-radius:20rpx;font-size:23rpx}.page .topic-selected{background:#EFF7F6;color:#267F83}.composer-privacy{display:flex;align-items:center;justify-content:space-between;font-size:24rpx;color:#267F83;margin:14rpx 0}.composer-hint{font-size:21rpx;color:#5B6F72;line-height:1.8}.composer-footer{position:fixed;bottom:0;left:0;right:0;max-width:1000rpx;margin:0 auto;display:flex;align-items:center;gap:18rpx;padding:22rpx 24rpx calc(22rpx + env(safe-area-inset-bottom));background:#f8f5fcf5}.page .draft-button{width:190rpx;flex-shrink:0;margin:0;border-radius:50rpx;min-height:82rpx;background:#EFF7F6;color:#267F83}.page .publish-button{flex:1;min-width:0;width:auto;margin:0;border-radius:50rpx;min-height:82rpx;background:linear-gradient(120deg,#5B6F72,#267F83);color:#fff;font-weight:600}.page .publish-button[disabled]{background:#DEF0EE;color:#fff;opacity:1}.composer-video{width:100%;height:340rpx;border-radius:24rpx}.composer-video-wrap{margin-top:20rpx}.page .video-remove{font-size:22rpx;margin-top:10rpx;width:auto;color:#267F83}
.composer-media{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx}.composer-photo{width:100%;height:0;padding-bottom:100%}.composer-preview{position:absolute;inset:0}.page .composer-media .media-add{width:100%;height:200rpx;min-width:0}.composer-media .media-add-icon{width:54rpx;height:54rpx}

/* Feature canvas matches native navigation. */
page{background:#EFF7F6;background-image:none}
