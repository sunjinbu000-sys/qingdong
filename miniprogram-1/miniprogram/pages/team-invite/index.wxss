@import "../team-join/index.wxss";
.invitation-title{text-align:center;font-size:31rpx;font-weight:700;color:#293553}.invitation-copy{font-size:23rpx;color:#a18ab5;line-height:1.9;text-align:center;margin:20rpx 0 28rpx}.invitation-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22rpx}.page .invitation-actions>button{width:100%;min-width:0;margin:0;min-height:96rpx;padding:20rpx 5rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:600;border-radius:32rpx}.page .invite-generate{background:linear-gradient(120deg,#a18ae4,#8269cb);color:#fff}.page .invite-poster{background:#f0e9fc;color:#8d6bcb}.page .invite-copy{background:#fbeff5;color:#ce91ae}.page .invite-wechat{background:#238473;color:#fff}.page .invitation-actions>button[disabled]{opacity:.45}.invitation-code-box{background:#f7f2fc;border-radius:24rpx;padding:20rpx;margin-bottom:24rpx;text-align:center}.invitation-code{font-size:25rpx;color:#8260bd;font-weight:600;word-break:break-all}.invitation-expiry{font-size:20rpx;color:#b09abe;margin-top:8rpx}.team-invite-canvas{position:fixed;left:-10000px;top:-10000px}
