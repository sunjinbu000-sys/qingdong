.weight-trend-page{color:#293553;padding:26rpx 24rpx}.weight-hero{border-radius:44rpx;background:linear-gradient(120deg,#b3a1e7,#9480d6);padding:34rpx;color:#fff}.weight-hero-title{font-size:27rpx}.weight-current{font-size:66rpx;font-weight:650;line-height:1.5;margin:36rpx 0 26rpx}.weight-current-unit{font-size:25rpx;font-weight:400;margin-left:6rpx}.weight-hero-bottom{display:flex;justify-content:space-between;align-items:center;gap:12rpx;font-size:20rpx}.weight-pills{display:flex;gap:8rpx;flex-wrap:wrap;justify-content:flex-end}.weight-pill{background:#f7f1ff;color:#8c75c1;border-radius:24rpx;padding:4rpx 9rpx;font-size:18rpx}.weight-chart-card{border-radius:44rpx;background:#fff;padding:32rpx;margin-top:28rpx}.weight-section-title{font-size:30rpx;font-weight:650}.weight-muted{color:#a08eb5;font-size:21rpx}.weight-ranges{display:flex;background:#efebf7;border-radius:25rpx;padding:7rpx;margin-top:22rpx}.page .weight-range{flex:1;min-width:0;width:0;background:transparent;border-radius:20rpx;color:#9a87b0;font-size:24rpx;padding:14rpx 0;line-height:1.4}.page .weight-range.selected{background:#fff;color:#8362d4}.weight-axis-title{font-size:18rpx;color:#a397b3;margin:48rpx 0 12rpx}.weight-graph{display:flex;gap:10rpx;height:280rpx}.weight-y-axis{position:relative;width:48rpx;flex-shrink:0;font-size:18rpx;color:#9c8db1}.weight-y-tick{position:absolute;left:0;transform:translateY(-50%)}.weight-plot{position:relative;width:540rpx;height:280rpx;flex-shrink:0}.weight-grid-line{position:absolute;left:0;right:0;border-top:1rpx dashed #e9e3f4}.weight-line{position:absolute;height:4rpx;background:#aa90de;transform-origin:left center}.weight-dot{position:absolute;width:12rpx;height:12rpx;border:3rpx solid #fff;border-radius:50%;background:#977ad2;transform:translate(-50%,-50%);box-shadow:0 0 0 2rpx #977ad2}.weight-no-points{position:absolute;top:40%;left:0;right:0;text-align:center;color:#a397b1;font-size:22rpx}.weight-x-axis{display:flex;justify-content:space-between;margin-left:58rpx;font-size:18rpx;color:#9a8aad}.weight-chart-note{text-align:center;font-size:20rpx;color:#9b88b6;margin-top:22rpx}.weight-health-cards{display:grid;grid-template-columns:1fr 1fr;gap:22rpx;margin-top:26rpx}.weight-bmi,.weight-goal{padding:24rpx;border-radius:40rpx;font-size:24rpx;color:#9d7a70;background:#ffecdf}.weight-goal{background:#e0f4ec;color:#7f9a8d}.weight-health-value{display:flex;align-items:center;justify-content:space-between;gap:8rpx;font-size:34rpx;font-weight:650;color:#343553;margin-top:20rpx}.weight-health-hint{font-size:16rpx;color:#9a80ba;font-weight:400}.page .weight-record-link{width:auto;min-width:0;padding:6rpx;background:transparent;color:#8b6cd2;font-size:25rpx;line-height:1.5}.weight-records{background:#fff;border-radius:40rpx;padding:20rpx 30rpx;margin-top:22rpx}.weight-record-empty{text-align:center;font-size:23rpx;color:#a593b7;padding:28rpx 0}.weight-record-row{display:flex;justify-content:space-between;font-size:25rpx;padding:20rpx 0;border-bottom:1rpx solid #eee8f6}.weight-record-row:last-child{border:0}.weight-tools{margin-top:26rpx}.page .weight-tools button{width:100%;min-width:0;background:#ffffff80;color:#9b86b8;border-radius:24rpx;padding:18rpx;font-size:23rpx;line-height:1.5;margin-top:14rpx}

.weight-forecast-line{position:absolute;height:0;border-top:4rpx dashed #55ad99;transform-origin:left center}.weight-forecast-note{font-size:21rpx;line-height:1.7;color:#8e83a2;margin-top:14rpx}
