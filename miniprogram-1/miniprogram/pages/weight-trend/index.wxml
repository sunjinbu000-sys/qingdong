<import src="../../components/states.wxml"/><view class="page weight-trend-page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><view class="weight-hero"><view class="weight-hero-title">每一次记录，都在靠近自己</view><view class="weight-current">{{current}}<text class="weight-current-unit">kg · 当前体重</text></view><view class="weight-hero-bottom"><text>记录自己的每一步</text><view class="weight-pills"><text class="weight-pill">较初始 {{difference}}</text><text class="weight-pill">距目标 {{goalGap}}</text></view></view></view>
<view class="weight-chart-card"><view class="row"><text class="weight-section-title">我的体重曲线</text><text class="weight-muted">{{lastDate}}</text></view><view class="weight-ranges"><button wx:for="{{ranges}}" wx:key="*this" class="weight-range {{days===item?'selected':''}}" data-days="{{item}}" bindtap="chooseRange">近{{item}}天</button></view><view class="weight-axis-title">体重 / kg</view><view class="weight-graph"><view class="weight-y-axis"><text class="weight-y-tick" wx:for="{{ticks}}" wx:key="y" style="top:{{item.y}}rpx">{{item.value}}</text></view><view class="weight-plot"><view wx:for="{{ticks}}" wx:key="y" class="weight-grid-line" style="top:{{item.y}}rpx"></view><view wx:for="{{lines}}" wx:key="id" class="weight-line" style="left:{{item.x}}rpx;top:{{item.y}}rpx;width:{{item.width}}rpx;transform:rotate({{item.angle}}deg)"></view><view wx:for="{{points}}" wx:key="date" class="weight-dot" style="left:{{item.x}}rpx;top:{{item.y}}rpx"></view><view wx:if="{{!points.length}}" class="weight-no-points">这个时间段还没有体重记录</view></view></view><view class="weight-x-axis"><text wx:for="{{labels}}" wx:key="*this">{{item}}</text></view><view class="weight-chart-note">横轴为日期 · 圆点为实际记录 · 连线为变化趋势</view></view>
<view class="weight-health-cards"><view class="weight-bmi"><view>身体质量指数</view><view class="weight-health-value">{{bmi}}<text class="weight-health-hint">BMI · 仅供参考</text></view></view><view class="weight-goal"><view>距离个人目标</view><view class="weight-health-value">{{goalGap}}<text class="weight-health-hint">kg · 按自己的节奏</text></view></view></view>
<view class="row section"><text class="weight-section-title">最近的记录</text><button class="weight-record-link" data-url="/pages/records/index?type=weight" bindtap="go">记体重 ›</button></view><view class="weight-records"><view wx:if="{{!records.length}}" class="weight-record-empty">每一步，都算数。记下今天的体重吧。</view><view wx:for="{{records}}" wx:key="id" class="weight-record-row"><text>{{item.date}}</text><text>{{item.kg}} kg</text></view></view><view class="weight-tools"><button data-url="/pages/health-profile/index" bindtap="go">起始体重与个人目标 ›</button><button data-url="/pages/weight/index" bindtap="go">体重核验与减重榜资格 ›</button><button data-url="/pages/health-overview/index" bindtap="go">营养与健康数据 ›</button></view></block></view>
