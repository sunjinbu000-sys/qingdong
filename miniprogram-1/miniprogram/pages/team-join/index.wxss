@import "../team-editor/index.wxss";
.team-join-page{padding:24rpx 26rpx 60rpx}.join-hero{position:relative;overflow:hidden;border-radius:48rpx;height:452rpx;background:linear-gradient(120deg,#ecfff1,#d7efe1 65%,#c9e7dc)}.join-hero-copy{position:relative;z-index:2;padding:54rpx 40rpx}.join-kicker{font-size:19rpx;color:#608a80;letter-spacing:2rpx}.join-heading{font-size:42rpx;font-weight:700;line-height:1.4;color:#326e68;margin-top:22rpx}.join-subtitle{font-size:23rpx;color:#72978c;margin-top:18rpx}.join-trophy{position:absolute;right:-15rpx;top:85rpx;width:310rpx;height:310rpx;transform:rotate(8deg)}.join-people{position:absolute;right:35rpx;bottom:8rpx;width:180rpx;height:145rpx}.join-hero-glow{position:absolute;left:-60rpx;bottom:-65rpx;width:420rpx;height:240rpx;border-radius:50%;background:#f1fff6aa}.join-card{padding:34rpx 34rpx 38rpx;margin-top:30rpx;background:#fff;border-radius:46rpx}.join-card-title{font-size:31rpx;font-weight:650;color:#293553;margin:0 0 26rpx}.join-form-label{font-size:25rpx;color:#514162;margin-bottom:15rpx}.page .join-code-input{width:100%;background:#fcf9ff;border:1rpx solid #e5daf3;border-radius:25rpx;min-height:95rpx;padding:20rpx 24rpx;font-size:25rpx;color:#615274}.page .join-view-button{width:100%;margin-top:30rpx;border-radius:30rpx;background:#9277d6;color:#fff;padding:24rpx;font-size:27rpx;font-weight:600}.page .join-view-button[disabled]{background:#f7f5f9;color:#cbc5d1;opacity:1}.page .join-help{width:100%;text-align:center;margin:28rpx 0 0;background:transparent;color:#8d68d0;font-size:24rpx;padding:20rpx 0}.join-privacy{font-size:21rpx;text-align:center;color:#b09cbe;margin:32rpx 16rpx;line-height:1.8}.join-details{border-top:1rpx solid #eee7f5;margin-top:28rpx;padding-top:24rpx}.join-team-name{font-size:29rpx;font-weight:600;color:#5d4a78}.join-detail-line{font-size:23rpx;color:#9e8aae;margin-top:9rpx}
.invitation-overview{text-align:center}.invitation-overview-name{font-size:33rpx;font-weight:700;color:#293553}.invitation-overview-caption{font-size:23rpx;color:#a28ab7;margin:20rpx 0 12rpx}.invitation-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx;color:#a58fba;font-size:22rpx}.invitation-metric-value{font-size:48rpx;color:#35405b;font-weight:700;margin-bottom:9rpx}.invitation-overview-dates{font-size:20rpx;color:#b3a0c1;margin-top:20rpx}.page .invitation-accept{width:100%;margin:24rpx 0 0;padding:24rpx 12rpx;background:linear-gradient(120deg,#a08ae5,#846ccc);border-radius:30rpx;color:#fff;font-size:26rpx;font-weight:650}.page .join-view-button{background:#f0e9fc;color:#8968ca}.invite-inline-error{font-size:23rpx;color:#b27c97;line-height:1.8;margin-top:20rpx}
