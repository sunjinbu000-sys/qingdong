<view class="page team-join-page"><view class="join-hero"><view class="join-hero-copy"><view class="join-kicker">给你的轻盈邀请</view><view class="join-heading">一个人走很快，<view>一起走得更远。</view></view><view class="join-subtitle">{{invitation?'邀你加入「'+invitation.name+'」':'和伙伴一起坚持记录'}}</view></view><view class="join-hero-glow"></view><image class="join-trophy" src="/images/home/shortcuts/rank.png" mode="aspectFit"/><image class="join-people" src="/images/home/shortcuts/team.png" mode="aspectFit"/></view><view class="join-card"><view class="join-card-title">加入好友的小队</view><view class="join-form-label">邀请码</view><input class="join-code-input" value="{{code}}" bindinput="input" maxlength="100" placeholder="粘贴好友分享的邀请码"/><button class="join-view-button" bindtap="viewInvite" disabled="{{busy || !code}}">查看邀请</button><view wx:if="{{inviteError}}" class="invite-inline-error">{{inviteError}}</view></view><view wx:if="{{invitation}}" class="join-card invitation-overview"><view class="invitation-overview-name">{{invitation.name}}</view><view class="invitation-overview-caption">{{invitation.memberCount}} / {{invitation.max}} 人 · {{days}} 天健康习惯挑战</view><view class="invitation-metrics"><view><view class="invitation-metric-value">{{days}}</view><text>挑战天数</text></view><view><view class="invitation-metric-value">{{invitation.taskCount}}</view><text>每日小习惯</text></view><view><view class="invitation-metric-value">0</view><text>参与费用</text></view></view><view class="invitation-overview-dates">{{invitation.city}} · {{invitation.start}} 至 {{invitation.end}}</view></view><button class="join-help" bindtap="rules">小队挑战怎么玩？再看一遍说明</button><button wx:if="{{invitation && invitation.alreadyJoined}}" class="invitation-accept" bindtap="openTeam">已加入，查看我的小队</button><button wx:elif="{{invitation}}" class="invitation-accept" bindtap="join" disabled="{{busy || invitation.alreadyRequested || invitation.closed}}">{{invitation.alreadyRequested?'申请已提交，等待队长处理':invitation.closed?'小队已结束':!signedIn?'登录后接受邀请':!hasCity?'完善城市后接受邀请':'接受邀请，加入小队'}}</button><button wx:elif="{{!signedIn}}" class="invitation-accept" data-url="/pages/account/index" bindtap="go">登录后加入好友小队</button><view class="join-privacy">加入后展示昵称与小队完成情况，不公开体重和餐食照片。</view><view wx:if="{{rulesOpen}}" class="team-rules-overlay" catchtouchmove="preventMove"><view class="team-rules-sheet"><view class="team-rules-header"><view><view class="team-rules-kicker">一起慢慢变好</view><view class="team-rules-title">小队挑战，怎么玩？</view></view><button class="team-rules-close" bindtap="closeRules" disabled="{{busy}}">关闭</button></view><scroll-view scroll-y class="team-rules-scroll"><view class="team-rules-body"><include src="../../components/team-rules-body.wxml"/></view></scroll-view><view class="team-rules-footer"><button class="team-rules-cancel" bindtap="closeRules" disabled="{{busy}}">再想一想</button><button wx:if="{{confirmingJoin}}" class="team-rules-confirm" bindtap="confirmJoin" disabled="{{busy}}">{{busy?'加入中…':'了解了，加入小队'}}</button><button wx:else class="team-rules-confirm" bindtap="closeRules">我知道啦</button></view></view></view></view>