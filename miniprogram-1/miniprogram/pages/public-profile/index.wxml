<view class="page"><view wx:if="{{error}}" class="card">{{error}}<button bindtap="retry">重试</button></view><view wx:if="{{profile}}" class="card"><view class="title">{{profile.nickname}}</view><view>审核通过的非匿名公开分享</view><button bindtap="block">{{profile.blocked?'解除拉黑':'拉黑'}}</button><view wx:for="{{profile.posts}}" wx:key="id"><button data-url="/pages/forum-detail/index?id={{item.id}}" bindtap="go">{{item.title||item.text}}</button></view><view wx:if="{{!profile.posts.length}}">暂无公开分享</view></view></view>