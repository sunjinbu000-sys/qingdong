<import src="../../components/states.wxml"/><view class="page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><view class="eyebrow">GOOD QUESTIONS, BETTER DECISIONS</view><view class="heading">把问题聊透，再一起出发。</view><view class="subtitle">{{done}} / {{issues.length}} 条规则已有选择；讨论结论不代表正式业务定稿。</view><view class="footer-buttons section"><button class="btn" disabled="{{busy || !canEdit}}" bindtap="save">保存全部结论</button><button class="btn soft" bindtap="exportFile">导出 Excel</button></view><button class="btn ghost mt" bindtap="copy">复制讨论文本</button><view wx:if="{{!canEdit}}" class="notice mt">当前可查看与导出。保存请切换运营或总部身份。</view><view wx:for="{{issues}}" wx:key="id" class="card section"><view class="row"><text class="pill">{{index+1}}</text><text class="pill {{item.choice==='待讨论'?'gold':''}}">{{item.choice==='待讨论'?'待讨论':'已有选择'}}</text></view><view class="title mt">{{item.title}}</view><text class="caption">{{item.desc}}</text><picker range="{{item.options}}" value="{{item.selected}}" data-index="{{index}}" bindchange="choice"><view class="picker mt">{{item.choice}} ⌄</view></picker><textarea class="mt" value="{{item.note}}" maxlength="1000" placeholder="补充适用范围、例外、负责人…" data-index="{{index}}" bindinput="note"/></view></block><view class="footnote">轻动 · 让健康成为一种日常</view></view>
