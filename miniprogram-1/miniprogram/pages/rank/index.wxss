.ranking-page{color:#263454}.rank-kicker{text-align:center;color:#986524;font-size:20rpx;letter-spacing:2rpx;font-weight:650}.rank-heading{text-align:center;font-size:38rpx;font-weight:700;margin:12rpx 0 26rpx;line-height:1.5}.rank-scopes{display:flex;justify-content:center;gap:16rpx;margin-bottom:20rpx}.page .rank-scope{width:auto;min-width:0;min-height:60rpx;padding:12rpx 46rpx;background:#ffffff70;color:#986524;border-radius:32rpx;font-size:25rpx;line-height:1.5}.page .rank-scope.selected{background:#7C7261;color:#fff}.rank-tabs{display:flex;padding:7rpx;background:#eeebf5;border-radius:26rpx;gap:8rpx}.page .rank-tab{flex:1;width:0;min-width:0;padding:14rpx 4rpx;background:transparent;border-radius:22rpx;color:#986524;font-size:24rpx;line-height:1.5}.page .rank-tab.selected{background:#fff;color:#986524;box-shadow:0 4rpx 12rpx #98652409}.rank-description{text-align:center;font-size:21rpx;color:#986524;margin:30rpx 0 50rpx;line-height:1.7}.rank-podium{display:flex;align-items:flex-end;justify-content:center;gap:18rpx;min-height:380rpx;margin:0 12rpx 42rpx}.podium-person{width:28%;display:flex;flex-direction:column;align-items:center;min-width:0}.podium-position-1{order:2}.podium-position-2{order:1}.podium-position-3{order:3}.podium-avatar{width:104rpx;height:104rpx;border:6rpx solid #fff;border-radius:50%;background:linear-gradient(145deg,#ffedb2,#f5c8b3);display:flex;align-items:center;justify-content:center;font-size:34rpx;color:#986524;font-weight:600}.podium-position-1 .podium-avatar{width:126rpx;height:126rpx}.podium-name{font-size:23rpx;font-weight:600;text-align:center;overflow-wrap:anywhere;margin:16rpx 0}.podium-step{width:100%;min-height:140rpx;border-radius:36rpx 36rpx 20rpx 20rpx;background:linear-gradient(180deg,#FAF5EA,#f7f3fc);display:flex;align-items:center;flex-direction:column;padding:20rpx 6rpx;gap:10rpx}.podium-position-1 .podium-step{min-height:185rpx;background:linear-gradient(180deg,#ffe7b9,#fff6e8)}.podium-number{font-size:48rpx;line-height:1.4;font-weight:700;color:#bd8a40}.podium-score{font-size:22rpx;color:#986524}.rank-empty{text-align:center;padding:90rpx 20rpx;color:#7C7261;font-size:24rpx}.rank-list{border-radius:28rpx;background:#ffffffa0;padding:8rpx 26rpx;margin-bottom:28rpx}.rank-list-row{display:flex;align-items:center;gap:22rpx;padding:22rpx 0;font-size:25rpx;border-bottom:1rpx solid #FAF5EA}.rank-list-row:last-child{border:0}.rank-place{width:40rpx;color:#986524}.rank-list-name{flex:1;min-width:0}.rank-city{display:block;font-size:20rpx;color:#7C7261}.rank-encouragement{padding:23rpx 24rpx;background:#edf7f1;border-radius:30rpx;color:#74928a;font-size:23rpx;line-height:1.7}.page .rank-manage{width:100%;min-width:0;margin-top:26rpx;border-radius:32rpx;background:#FAF5EA;color:#986524;font-size:26rpx;font-weight:600;padding:24rpx 12rpx;line-height:1.5}.rank-extra{display:flex;justify-content:center;gap:24rpx;margin-top:30rpx;flex-wrap:wrap}.page .rank-extra-link{width:auto;min-width:0;background:transparent;color:#7C7261;font-size:21rpx;padding:6rpx;line-height:1.5}

