<import src="../../components/states.wxml"/><view class="page ranking-page qd-theme qd-challenge"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><view class="rank-kicker">EVERY EFFORT COUNTS</view><view class="rank-heading">每一份坚持，都闪闪发光</view>
<view class="rank-scopes"><button class="rank-scope {{query.scope==='national'?'selected':''}}" data-scope="national" bindtap="chooseScope">全国</button><button class="rank-scope {{query.scope==='city'?'selected':''}}" data-scope="city" bindtap="chooseScope">{{city || '选择城市'}}</button></view>
<view class="rank-tabs"><button wx:for="{{metrics}}" wx:key="id" class="rank-tab {{query.metric===item.id?'selected':''}}" data-metric="{{item.id}}" bindtap="chooseMetric">{{item.title}}</button></view>
<view class="rank-month-row"><picker mode="date" fields="month" value="{{rank.month}}" start="2000-01" end="{{todayMonth}}" bindchange="chooseMonth"><view class="rank-month-picker">{{rank.month}} 月榜 ⌄</view></picker></view><view class="rank-description">{{date}} · {{query.scope==='national'?'全国':city}} · 仅展示已授权或可公开的记录</view>
<view wx:if="{{podium.length}}" class="rank-podium"><view wx:for="{{podium}}" wx:key="id" class="podium-person podium-position-{{item.position}}"><view class="podium-avatar">{{item.initial}}</view><view class="podium-name">{{item.nickname}}</view><view class="podium-step"><text class="podium-number">{{item.rank}}</text><text class="podium-score">{{item.score}} {{unit}}</text></view></view></view><view wx:else class="rank-empty">当前范围暂无公开排名，期待你的第一份坚持。</view>
<view wx:if="{{remainingRows.length}}" class="rank-list"><view wx:for="{{remainingRows}}" wx:key="id" class="rank-list-row"><text class="rank-place">{{item.rank}}</text><view class="rank-list-name">{{item.nickname}}<text class="rank-city">{{item.city}}</text></view><text>{{item.score}} {{unit}}</text></view></view>
<view class="rank-encouragement">♧　排名只是一次相互鼓励。规律记录，比名次更重要。</view><button class="rank-manage" data-url="/pages/privacy/index" bindtap="go">管理我的参榜与公开范围</button><view class="rank-extra"><button class="rank-extra-link" data-url="/pages/rank-history/index" bindtap="go">历史榜与我的奖励 ›</button><button class="rank-extra-link" data-url="/pages/prize-ops/index" bindtap="go">运营奖品配置 ›</button></view></block></view>
