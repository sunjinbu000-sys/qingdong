<import src="../../components/states.wxml"/><view class="page"><template is="feedback" data="{{loading,error}}"/><view class="heading">月度公开榜</view><block wx:if="{{!loading && !error}}"><view class="notice">本人自主开启公开榜；原始体重与照片不公开，减重使用核验通过记录。</view><form bindsubmit="filter"><view class="field"><input name="month" value="{{rank.month}}" placeholder="月份 YYYY-MM"/></view><view class="field"><input name="city" value="{{rank.city}}" placeholder="城市"/></view><radio-group name="scope"><label><radio value="city" checked/>同城</label><label><radio value="national"/>全国</label></radio-group><radio-group name="metric"><label><radio value="checkin" checked/>签到</label><label><radio value="loss"/>减重</label><label><radio value="teamTotal"/>小队总任务</label><label><radio value="teamAverage"/>小队人均</label></radio-group><button class="btn soft mt" form-type="submit">筛选</button></form><view class="card mt"><view class="item row" wx:for="{{rank.rows}}" wx:key="id"><view class="grow">{{item.rank}} · {{item.nickname}}</view><view>{{item.score}}</view></view></view><view class="actions mt"><button class="btn soft small" data-url="/pages/rank-history/index" bindtap="go">历史榜与我的奖励</button><button class="btn soft small" data-url="/pages/prize-ops/index" bindtap="go">运营奖品配置</button></view></block></view>