page{background:#f5f1fb}.event-enroll-page{padding:30rpx 26rpx}.enroll-summary{background:white;border-radius:30rpx;padding:26rpx;display:flex;align-items:center;gap:22rpx;margin-bottom:24rpx}.enroll-cover{width:130rpx;height:150rpx;border-radius:20rpx;flex-shrink:0}.enroll-title{font-size:30rpx;font-weight:650;color:#463B35;line-height:1.6}.enroll-location{font-size:24rpx;color:#A36241;margin-top:12rpx;line-height:1.7}.enroll-card{display:block;background:white;border-radius:32rpx;padding:32rpx}.enroll-heading{font-size:33rpx;font-weight:650;color:#463B35}.enroll-note{font-size:24rpx;line-height:1.8;color:#75685F;margin:18rpx 0 30rpx}.enroll-field{margin:30rpx 0;font-size:27rpx;color:#A36241}.enroll-field text{color:#ba8baa}.page .enroll-field input{display:block;box-sizing:border-box;width:100%;margin-top:18rpx;padding:24rpx;background:#f8f5fc;border:1rpx solid #FCF2EB;border-radius:23rpx;font-size:28rpx}.enroll-privacy{display:flex;align-items:flex-start;gap:12rpx;color:#75685F;font-size:22rpx;line-height:1.8;margin:30rpx 0}.enroll-privacy-icon{width:30rpx;height:30rpx;flex-shrink:0;margin-top:5rpx}.page .enroll-submit{width:100%;min-width:0;background:linear-gradient(110deg,#75685F,#A36241);color:white;border-radius:30rpx;font-size:29rpx;line-height:1.5;padding:23rpx;margin-top:25rpx}.page .enroll-submit[disabled]{background:#FAE6D8;color:#75685F}

/* Feature canvas matches native navigation. */
page{background:#FCF2EB;background-image:none}
