<import src="../../components/states.wxml"/><view class="page qd-theme qd-event invite-data-page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><view class="heading">{{title}}</view><block wx:if="{{mode==='activities'}}"><view id="invite-activities" class="section-title section">邀请活动与奖励档位</view><view wx:if="{{!activities.length}}" class="card mt empty">当前暂无上架邀请活动，成功绑定记录仍会保留。</view><view wx:for="{{activities}}" wx:for-item="activity" wx:key="id" class="card mt"><view class="title">{{activity.title}}</view><view class="caption mt">{{activity.start}} — {{activity.end}} · 领取截止 {{activity.claimUntil}}</view><view class="caption mt">已成功邀请 {{activity.progress}} 人 · {{activity.claimMode === 'highest' ? '仅最高达标档位' : '可按各档位领取'}}</view><view wx:for="{{activity.tiers}}" wx:for-item="tier" wx:key="id" class="config-row"><view class="title">{{tier.name}} · 邀请{{tier.target}}人</view><view class="caption mt">{{tier.rewardName}} {{tier.rewardType === 'member' ? '· '+tier.snapshot.days+'天 · 每日'+tier.snapshot.dailyLimit+'次' : '· 实物/商品奖励'}}</view><view class="caption mt">剩余名额 {{tier.remaining}} · {{tier.status}}</view><button class="btn white mt" data-activity="{{activity.id}}" data-tier="{{tier.id}}" bindtap="claim" disabled="{{!tier.canClaim || busy}}">{{tier.canClaim ? '领取模拟奖励' : tier.status}}</button></view></view><view wx:if="{{role==='hq' || role==='admin' || role==='operator'}}" class="card section"><view class="title">统一邀请活动配置</view><button class="btn mt" data-url="/pages/reward-ops/index?type=invite" bindtap="go">管理邀请活动与奖励档位</button></view></block><block wx:elif="{{mode==='records'}}"><view id="invite-records" class="card section"><view class="title"><image class="section-symbol" src="/images/ui/edit.svg"/>成功邀请记录</view><view wx:if="{{!invite.records.length}}" class="empty">暂无新用户绑定</view><view wx:for="{{invite.records}}" wx:key="id" class="config-row"><view>{{item.nickname}}</view><view class="caption mt">{{item.date}} · 首次注册已绑定</view></view></view></block><block wx:else><view id="invite-rewards" class="card section"><view class="title"><image class="section-symbol" src="/images/ui/edit.svg"/>邀请奖励领取记录</view><view wx:if="{{!rewards.length}}" class="empty">暂无邀请活动奖励</view><view wx:for="{{rewards}}" wx:key="id" class="config-row"><view>{{item.title}} · {{item.tierName}}</view><view class="caption mt">{{item.date}} · {{item.name}} · {{statusLabels[item.status] || item.status}}</view><view wx:if="{{item.rewardType === 'member'}}" class="caption mt">{{item.days}}天 · 权益已进入统一会员队列</view></view></view></block></block></view>