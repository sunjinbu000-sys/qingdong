<view class="page"><view wx:if="{{error}}" class="card">{{error}}<button bindtap="retry">重试</button></view><view wx:if="{{accessMessage}}" class="card">{{accessMessage}}<button data-url="/pages/account/index" bindtap="go">账号与身份</button></view><view class="card"><view class="title">首页展示位</view><view>{{canHQ?'配置展示顺序与跳转':'查看当前启用的首页内容'}}</view><button wx:if="{{canHQ}}" data-url="/pages/config-editor/index?kind=banner" bindtap="go">新增展示位</button></view><view wx:for="{{banners}}" wx:key="id" class="card"><view class="title">{{item.title}}</view><view>{{item.subtitle}}</view><image wx:if="{{item.imagePath}}" src="{{item.imagePath}}"/><view>类型 {{item.kind}} · 排序 {{item.sort}} · {{item.enabled?'启用':'停用'}}</view><view>{{item.target}}</view><button data-url="/pages/config-editor/index?kind=banner&id={{item.id}}" bindtap="go">{{canHQ?'编辑 / 审阅':'查看详情'}}</button><button wx:if="{{canHQ}}" data-id="{{item.id}}" bindtap="remove">删除展示位</button></view></view>