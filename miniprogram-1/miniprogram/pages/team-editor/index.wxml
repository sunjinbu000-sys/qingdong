<import src="../../components/states.wxml"/><view class="page"><template is="feedback" data="{{loading,error}}"/><view class="heading">筹建小队</view><block wx:if="{{!loading && !error}}"><form bindsubmit="submit"><view class="field"><view>队名</view><input name="name" type="text" value="{{form.name}}"/></view><view class="field"><view>人数上限 3–100</view><input name="max" type="number" value="{{form.max}}"/></view><view class="field"><view>开始 YYYY-MM-DD</view><input name="start" type="text" value="{{form.start}}"/></view><view class="field"><view>结束 YYYY-MM-DD</view><input name="end" type="text" value="{{form.end}}"/></view><radio-group name="method"><label><radio value="open" checked/>公开</label><label><radio value="approval"/>审核</label><label><radio value="invite"/>邀请码</label></radio-group><view class="field">至少选择2项任务<checkbox-group name="tasks"><label><checkbox value="signin" checked/>签到</label><label><checkbox value="weight" checked/>体重</label><label><checkbox value="early"/>早起</label></checkbox-group></view><button class="btn primary" form-type="submit">创建筹队</button></form></block></view>