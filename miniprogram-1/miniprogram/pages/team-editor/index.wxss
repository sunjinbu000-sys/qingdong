@import "../../components/team-rules.wxss";
.team-create{padding:28rpx 24rpx 50rpx}.team-create-header{display:flex;align-items:center;gap:18rpx;margin-bottom:30rpx}.team-create-art{width:110rpx;height:110rpx;flex-shrink:0}.team-create-heading{font-size:36rpx;font-weight:700;color:#293553;line-height:1.5}.team-create-subtitle{font-size:23rpx;color:#287D73;margin-top:8rpx}.team-create-form{border:0;border-radius:48rpx;padding:60rpx 36rpx 28rpx}.team-create .form-label{font-size:25rpx;color:#2B413B}.team-create .form-field{margin-bottom:32rpx}.team-create .input,.team-create .picker{background:#faf8fd;border:1rpx solid #DCF0E7;border-radius:25rpx;color:#2B413B;min-height:94rpx;padding:22rpx 24rpx;font-size:26rpx}.picker-chevron{float:right;color:#287D73}.team-rule-row{display:flex;align-items:center;justify-content:space-between;padding:34rpx 0;border-bottom:1rpx solid #EEF7F3;font-size:24rpx;color:#287D73;gap:18rpx}.team-rule-row:nth-last-child(3){border-bottom:0}.team-rule-value{font-weight:600;color:#2B413B}.page .team-settings-toggle{background:transparent;color:#5B7067;font-size:22rpx;margin-top:15rpx}.team-advanced{margin-top:26rpx;padding-top:28rpx;border-top:1rpx solid #EEF7F3}.team-task{display:flex;align-items:center;font-size:24rpx;color:#287D73;margin:20rpx 0}.team-task checkbox{transform:scale(.8)}.team-create-notice{display:flex;align-items:flex-start;gap:16rpx;background:#EEF7F3;border-radius:30rpx;margin-top:26rpx;padding:25rpx 28rpx;color:#287D73;font-size:23rpx;line-height:1.7}.team-notice-icon{width:30rpx;height:30rpx;flex-shrink:0;margin-top:5rpx}.team-schedule{font-size:20rpx;margin-top:8rpx}.page .team-help{background:transparent;color:#287D73;margin:28rpx 0;font-size:24rpx}.page .team-create-submit{width:100%;min-height:96rpx;border-radius:30rpx;background:linear-gradient(120deg,#5B7067,#5B7067);color:#fff;font-weight:600;font-size:27rpx}.page .team-create-submit[disabled]{background:#DCF0E7;color:#EEF7F3;opacity:1}

/* Feature canvas matches native navigation. */
page{background:#EEF7F3;background-image:none}

.team-default-tasks{margin:30rpx 0;padding-top:25rpx;border-top:1rpx solid #CCE5DB}.team-default-tasks .team-task{display:flex;align-items:flex-start;gap:12rpx;margin:20rpx 0;color:#2B413B}.team-default-tasks .team-task>view{min-width:0;flex:1}.team-task-hint{font-size:21rpx;color:#5B7067;line-height:1.8;margin-top:5rpx}.team-early-field{padding:22rpx;border:1rpx solid #CCE5DB;border-radius:24rpx;background:#F3FAF6}.team-early-invalid{border-color:#B66A54;background:#FFF7F1}.team-required{font-size:20rpx;color:#A76148;margin-left:12rpx}.team-create .team-time-empty{color:#6C8178}

.team-default-tasks .team-task .team-task-check{flex:0 0 36rpx;width:36rpx;height:36rpx;background:#287D73;color:#fff;border-radius:10rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx;line-height:1;margin-top:3rpx}
