.team-create{padding:28rpx 24rpx 50rpx}.team-create-header{display:flex;align-items:center;gap:18rpx;margin-bottom:30rpx}.team-create-art{width:110rpx;height:110rpx;flex-shrink:0}.team-create-heading{font-size:36rpx;font-weight:700;color:#293553;line-height:1.5}.team-create-subtitle{font-size:23rpx;color:#9281a9;margin-top:8rpx}.team-create-form{border:0;border-radius:48rpx;padding:60rpx 36rpx 28rpx}.team-create .form-label{font-size:25rpx;color:#3b3458}.team-create .form-field{margin-bottom:32rpx}.team-create .input,.team-create .picker{background:#faf8fd;border:1rpx solid #e4dcf3;border-radius:25rpx;color:#514361;min-height:94rpx;padding:22rpx 24rpx;font-size:26rpx}.picker-chevron{float:right;color:#897a9a}.team-rule-row{display:flex;align-items:center;justify-content:space-between;padding:34rpx 0;border-bottom:1rpx solid #eee8f5;font-size:24rpx;color:#5f4d85;gap:18rpx}.team-rule-row:nth-last-child(3){border-bottom:0}.team-rule-value{font-weight:600;color:#3a3155}.page .team-settings-toggle{background:transparent;color:#9c88b5;font-size:22rpx;margin-top:15rpx}.team-advanced{margin-top:26rpx;padding-top:28rpx;border-top:1rpx solid #ede7f5}.team-task{display:flex;align-items:center;font-size:24rpx;color:#77658c;margin:20rpx 0}.team-task checkbox{transform:scale(.8)}.team-create-notice{display:flex;align-items:flex-start;gap:16rpx;background:#eee8f8;border-radius:30rpx;margin-top:26rpx;padding:25rpx 28rpx;color:#9a86b2;font-size:23rpx;line-height:1.7}.team-notice-icon{width:30rpx;height:30rpx;flex-shrink:0;margin-top:5rpx}.team-schedule{font-size:20rpx;margin-top:8rpx}.page .team-help{background:transparent;color:#8b69d0;margin:28rpx 0;font-size:24rpx}.page .team-create-submit{width:100%;min-height:96rpx;border-radius:30rpx;background:linear-gradient(120deg,#a58ce8,#8770ce);color:#fff;font-weight:600;font-size:27rpx}.page .team-create-submit[disabled]{background:#cbbced;color:#eee7f8;opacity:1}
.team-rules-overlay{position:fixed;inset:0;z-index:100;background:#30274270;display:flex;align-items:center;justify-content:center;padding:12rpx}.team-rules-sheet{width:100%;max-width:960rpx;background:#fff;border-radius:38rpx;overflow:hidden}.team-rules-header{display:flex;align-items:center;justify-content:space-between;padding:24rpx 30rpx 14rpx}.team-rules-kicker{font-size:22rpx;color:#ac95ca}.team-rules-title{font-size:31rpx;color:#4c3c67;font-weight:700;margin-top:6rpx}.page .team-rules-close{width:86rpx;min-width:0;margin:0;padding:14rpx 0;background:#f5f0fb;color:#9d86b9;font-size:24rpx;border-radius:22rpx}.team-rules-scroll{height:62vh;overflow-y:auto}.team-rules-body{padding:0 30rpx 20rpx}.team-rules-intro{background:#f5effc;border-radius:24rpx;padding:20rpx;color:#9785ab;font-size:25rpx;line-height:1.8;margin-top:8rpx}.team-rule-section{padding:25rpx 0;border-bottom:1rpx solid #ede4f7}.team-rule-heading{font-size:28rpx;font-weight:650;color:#685080;line-height:1.6;margin-bottom:14rpx}.team-rule-copy{font-size:24rpx;color:#9c89ac;line-height:1.95}.team-rule-highlight{background:#f0f9f4;border:1rpx solid #e5f0e9;padding:22rpx;border-radius:22rpx;margin-top:16rpx}.team-rule-subheading{font-size:24rpx;font-weight:600;color:#668b7c;margin:14rpx 0 7rpx}.team-rule-last{border-bottom:0}.team-rules-footer{display:flex;gap:18rpx;padding:20rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));background:#fff}.page .team-rules-cancel,.page .team-rules-confirm{flex:1;width:auto;min-width:0;margin:0;min-height:88rpx;display:flex;align-items:center;justify-content:center;border-radius:34rpx;font-size:25rpx;font-weight:600;padding:18rpx 10rpx}.page .team-rules-cancel{background:#f0e9fc;color:#8c6dc9}.page .team-rules-confirm{background:linear-gradient(120deg,#a18ae5,#8269cc);color:#fff}
