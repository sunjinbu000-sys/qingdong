.meal-record-page{padding-bottom:170rpx}.meal-heading{font-size:36rpx;font-weight:700;color:#293553}.page .meal-photo-link{padding:0;background:transparent;font-size:22rpx;color:#307F65;margin:0;flex-shrink:0}.meal-date-card{background:#fff;border-radius:40rpx;padding:26rpx;margin-top:30rpx}.meal-date-value{font-size:25rpx;color:#307F65}.meal-slots{display:flex;background:#F0F7F2;padding:6rpx;border-radius:22rpx;margin-top:20rpx}.page .meal-slot{flex:1;min-width:0;width:auto;background:transparent;color:#307F65;margin:0;border-radius:17rpx;font-size:24rpx;padding:15rpx 4rpx}.page .meal-slot-active{background:#fff;color:#307F65}.page .meal-search{width:100%;display:block;margin-top:24rpx;background:#fff;border:1rpx solid #E2F1E7;border-radius:26rpx;padding:20rpx 24rpx;font-size:25rpx}.meal-food-list{background:#fff;border:1rpx solid #F0F7F2;border-radius:28rpx;overflow:hidden}.page .meal-food-row{display:flex;align-items:center;gap:16rpx;background:#fff;border-bottom:1rpx solid #F0F7F2;border-radius:0;text-align:left;padding:20rpx;width:100%;min-width:0}.meal-food-symbol{background:#F0F7F2;border-radius:20rpx;width:70rpx;height:70rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.meal-food-icon{width:42rpx;height:42rpx}.meal-food-name{font-size:26rpx;font-weight:600;color:#293553}.meal-food-caption{font-size:22rpx;color:#307F65;margin-top:5rpx}.meal-food-plus{background:#F0F7F2;border-radius:50%;font-size:30rpx;color:#5E7064;width:42rpx;text-align:center;flex-shrink:0}.page .meal-more,.page .meal-manual-link{background:transparent;color:#5E7064;font-size:24rpx;padding:24rpx}.meal-reference{font-size:21rpx;color:#5E7064;line-height:1.8;margin-top:22rpx}.meal-footer{position:fixed;bottom:0;left:0;right:0;display:flex;gap:16rpx;padding:18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #F0F7F2}.meal-footer-total{flex:1;text-align:center;border-radius:24rpx;background:#F0F7F2;color:#307F65;padding:10rpx;font-size:21rpx}.meal-footer-total>view{font-size:28rpx;font-weight:700}.meal-footer .meal-complete{flex:1;width:auto;margin:0;background:#5E7064;color:#fff;border-radius:24rpx;font-size:27rpx}.meal-footer .meal-complete[disabled]{background:#f0edf5;color:#5E7064;opacity:1}.meal-food-sheet{position:fixed;z-index:20;left:20rpx;right:20rpx;bottom:130rpx;padding:32rpx;background:#fff;border-radius:32rpx;box-shadow:0 0 0 100vmax #293E3650}
.weight-entry-motto{text-align:center;color:#307F65;font-size:24rpx;margin:6rpx 0 40rpx}.weight-entry-card{padding:44rpx 36rpx 38rpx;background:#fff;border-radius:48rpx;margin-bottom:26rpx}.weight-entry-label{font-size:24rpx;color:#307F65}.weight-entry-unit-pill{background:#F0F7F2;color:#307F65;border-radius:30rpx;padding:6rpx 18rpx;font-size:22rpx}.weight-input-wrap{display:flex;align-items:center;border:1rpx solid #E2F1E7;background:#fcfaff;border-radius:26rpx;margin-top:24rpx;padding:8rpx 24rpx}.page .weight-entry-input{background:transparent;border:0;text-align:center;min-width:0;width:100%;height:94rpx;padding:0;color:#307F65;font-size:58rpx;font-weight:700}.weight-entry-placeholder{font-size:52rpx;font-weight:650;color:#5E7064}.weight-entry-unit{font-size:44rpx;color:#307F65;margin-left:12rpx}.weight-entry-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin:30rpx 0 22rpx;text-align:center;color:#5E7064;font-size:22rpx}.weight-entry-value{font-size:36rpx;color:#293E36;font-weight:600;line-height:1.5;margin-bottom:12rpx}.weight-entry-purple{color:#5E7064}.weight-entry-caption{text-align:center;font-size:22rpx;color:#5E7064;line-height:1.7}.weight-entry-card .form-label{font-size:26rpx;color:#293E36}.weight-entry-card .form-field:last-child{margin-bottom:12rpx}.weight-entry-card .input,.weight-entry-card .picker{background:#fbf9fe;border-color:#E2F1E7;border-radius:25rpx}.weight-date-arrow{float:right;color:#307F65}.weight-entry-notice{display:flex;align-items:flex-start;gap:16rpx;border-radius:30rpx;margin:28rpx 0}.weight-entry-leaf{width:30rpx;height:30rpx;flex-shrink:0;margin-top:5rpx}.page .weight-entry-save{border:0;border-radius:30rpx;background:linear-gradient(120deg,#5E7064,#5E7064);min-height:98rpx}

