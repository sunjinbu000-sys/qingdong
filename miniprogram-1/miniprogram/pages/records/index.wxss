.meal-record-page{padding-bottom:170rpx}.meal-heading{font-size:36rpx;font-weight:700;color:#293553}.page .meal-photo-link{padding:0;background:transparent;font-size:22rpx;color:#8b6bcc;margin:0;flex-shrink:0}.meal-date-card{background:#fff;border-radius:40rpx;padding:26rpx;margin-top:30rpx}.meal-date-value{font-size:25rpx;color:#8a6ac9}.meal-slots{display:flex;background:#f1ecf8;padding:6rpx;border-radius:22rpx;margin-top:20rpx}.page .meal-slot{flex:1;min-width:0;width:auto;background:transparent;color:#9582ad;margin:0;border-radius:17rpx;font-size:24rpx;padding:15rpx 4rpx}.page .meal-slot-active{background:#fff;color:#7f60bd}.page .meal-search{width:100%;display:block;margin-top:24rpx;background:#fff;border:1rpx solid #e7def2;border-radius:26rpx;padding:20rpx 24rpx;font-size:25rpx}.meal-food-list{background:#fff;border:1rpx solid #e9e1f4;border-radius:28rpx;overflow:hidden}.page .meal-food-row{display:flex;align-items:center;gap:16rpx;background:#fff;border-bottom:1rpx solid #eee7f6;border-radius:0;text-align:left;padding:20rpx;width:100%;min-width:0}.meal-food-symbol{background:#f1eafb;border-radius:20rpx;width:70rpx;height:70rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.meal-food-icon{width:42rpx;height:42rpx}.meal-food-name{font-size:26rpx;font-weight:600;color:#293553}.meal-food-caption{font-size:22rpx;color:#9a85af;margin-top:5rpx}.meal-food-plus{background:#f4eefa;border-radius:50%;font-size:30rpx;color:#9b83ba;width:42rpx;text-align:center;flex-shrink:0}.page .meal-more,.page .meal-manual-link{background:transparent;color:#916dd1;font-size:24rpx;padding:24rpx}.meal-reference{font-size:21rpx;color:#9d8eaf;line-height:1.8;margin-top:22rpx}.meal-footer{position:fixed;bottom:0;left:0;right:0;display:flex;gap:16rpx;padding:18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #eee7f5}.meal-footer-total{flex:1;text-align:center;border-radius:24rpx;background:#f0e9fb;color:#8c6dce;padding:10rpx;font-size:21rpx}.meal-footer-total>view{font-size:28rpx;font-weight:700}.meal-footer .meal-complete{flex:1;width:auto;margin:0;background:#9275d6;color:#fff;border-radius:24rpx;font-size:27rpx}.meal-footer .meal-complete[disabled]{background:#f0edf5;color:#bfb5ca;opacity:1}.meal-food-sheet{position:fixed;z-index:20;left:20rpx;right:20rpx;bottom:130rpx;padding:32rpx;background:#fff;border-radius:32rpx;box-shadow:0 0 0 100vmax #30274350}