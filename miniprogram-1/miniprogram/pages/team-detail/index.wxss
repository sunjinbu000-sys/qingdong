@import "../../components/team-rules.wxss";
.team-detail-page{padding:26rpx 28rpx 50rpx}.team-detail-summary{text-align:center}.team-status-badge{display:inline-block;background:#e5f5ee;color:#3f7c70;border-radius:30rpx;padding:7rpx 18rpx;font-size:20rpx}.team-detail-name{font-size:42rpx;font-weight:700;color:#293553;margin:26rpx 0 12rpx}.team-detail-subtitle{font-size:23rpx;color:#a18db2}.team-pk-card,.team-members-card{padding:32rpx;background:#fff;border-radius:46rpx;margin-top:30rpx}.team-section-title{font-size:31rpx;font-weight:650;color:#293553}.team-wait-pill{font-size:21rpx;color:#8b6bc9;background:#f0e9fc;padding:6rpx 15rpx;border-radius:22rpx}.team-pk-copy{font-size:23rpx;color:#9c87ae;line-height:1.8;margin-top:20rpx}.team-schedule{font-size:20rpx;color:#b19dbd;margin-top:10rpx}.team-detail-notice{background:#eaf6ef;border-radius:30rpx;padding:24rpx;margin-top:26rpx;font-size:23rpx;color:#75998a;line-height:1.8}.page .team-detail-help{width:100%;background:transparent;color:#8f6ad1;font-size:24rpx;padding:24rpx 0;margin:18rpx 0}.team-member-row{display:flex;align-items:center;gap:20rpx;padding:18rpx 0;border-bottom:1rpx solid #eee7f5}.team-member-row:last-child{border-bottom:0}.team-member-avatar{width:85rpx;height:85rpx;flex-shrink:0}.team-member-name{font-size:26rpx;font-weight:600;color:#3c3256}.team-member-role{font-size:22rpx;color:#a28db4;margin-top:7rpx}.team-member-transfer{font-size:19rpx;width:auto;margin:0}.team-main-actions{display:flex;gap:24rpx;margin-top:26rpx}.page .team-invite-button,.page .team-launch-button{flex:1;width:auto;min-width:0;margin:0;padding:24rpx 8rpx;border-radius:30rpx;font-size:27rpx;font-weight:600;background:#eee7fb;color:#8967c9}.page .team-launch-button{background:#9277d4;color:#fff}.page .team-launch-button[disabled]{background:#c9baec;color:#ad99d2;opacity:1}.page .team-dissolve-button{width:100%;background:transparent;color:#a188ba;font-size:23rpx;padding:24rpx}.team-detail-privacy{font-size:21rpx;color:#b09cbd;text-align:center;margin-top:50rpx}.team-task-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:20rpx 0;border-bottom:1rpx solid #eee7f5;font-size:24rpx}
.dashboard-team{background:linear-gradient(155deg,#dff7e7,#f8fbf7 500rpx);min-height:100vh;padding-bottom:calc(170rpx + env(safe-area-inset-bottom))}.squad-overview{position:relative;background:white;border-radius:34rpx;padding:30rpx;display:flex;align-items:center;gap:18rpx;flex-wrap:wrap}.squad-overview-main{flex:1;min-width:0}.squad-caption{font-size:22rpx;color:#98a494;line-height:1.7}.squad-title{font-size:31rpx;font-weight:650;line-height:1.5;color:#344735;margin-top:8rpx;word-break:break-all}.squad-period{font-size:22rpx;color:#91a18e;margin-top:8rpx}.squad-stat-row{display:flex;gap:26rpx;margin:23rpx 0 10rpx;font-size:21rpx;color:#8e9c89}.squad-stat-row>view{display:flex;flex-direction:column;gap:5rpx}.squad-stat-value{font-size:36rpx;font-weight:650;color:#374c35}.squad-ring{width:190rpx;height:190rpx;flex-shrink:0;border-radius:50%;padding:15rpx;display:flex;align-items:center;justify-content:center}.squad-ring-inner{width:160rpx;height:160rpx;border-radius:50%;background:white;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#a3aa9b;font-size:19rpx}.squad-ring-value{font-size:46rpx;font-weight:700;color:#263e2b;margin-bottom:7rpx}.squad-timeline{width:100%;height:11rpx;border-radius:20rpx;background:#e9ede7;overflow:hidden;margin-top:5rpx}.squad-timeline>view{height:100%;background:#ff9e4a;border-radius:20rpx}.squad-today-card{background:linear-gradient(110deg,#fff9e6,#faffed);padding:28rpx;border-radius:30rpx;margin-top:24rpx}.squad-section-title{font-size:29rpx;font-weight:650;color:#3c4e39}.squad-task{display:flex;align-items:center;gap:18rpx;margin-top:24rpx;padding-top:17rpx;border-top:1rpx solid #eaf0de}.squad-task-name{font-size:29rpx;font-weight:600;color:#405237;margin-bottom:8rpx}.page .squad-check-button{width:160rpx;flex-shrink:0;min-width:0;padding:13rpx 7rpx;line-height:1.5;border-radius:40rpx;background:#48b776;color:white;font-size:26rpx}.page .squad-check-button[disabled]{background:#e4eddd;color:#a1b394}.page .squad-weight-link{background:transparent;color:#68a86d;font-size:22rpx;padding:5rpx 0;margin:8rpx 0 0;width:auto;min-width:0;text-align:left;line-height:1.5}.squad-members{margin-top:30rpx}.squad-members-heading{display:flex;justify-content:space-between;align-items:center;gap:10rpx;margin-bottom:24rpx}.squad-filters{display:flex;gap:8rpx}.page .squad-filters button{width:auto;min-width:0;padding:6rpx 12rpx;background:#e9f2e6;color:#8fa588;border-radius:20rpx;font-size:20rpx;line-height:1.5;margin:0}.page .squad-filters button.selected{color:#378c53;background:#d9eddb}.squad-member-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12rpx}.squad-member-tile{position:relative;background:white;border:1rpx solid #e6eee1;border-radius:24rpx;text-align:center;padding:28rpx 8rpx 18rpx;min-width:0}.squad-member-badge{position:absolute;right:0;top:0;background:#ffc281;color:white;padding:3rpx 10rpx;border-radius:18rpx;font-size:16rpx}.squad-member-badge.complete{background:#50b679}.squad-member-avatar{width:76rpx;height:76rpx;border-radius:50%;margin:10rpx auto}.squad-member-name{font-size:23rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#485942}.squad-member-meta{font-size:18rpx;color:#9ba792;margin-top:7rpx}.squad-captain-label{font-size:17rpx;color:#7aaf79}.page .squad-expand{width:100%;min-width:0;background:transparent;color:#8aa67d;font-size:24rpx;padding:20rpx 0;margin-top:12rpx;line-height:1.5}.squad-empty{padding:35rpx 10rpx;text-align:center;color:#9caa93;font-size:24rpx}.squad-footer{position:fixed;bottom:0;left:0;right:0;background:white;border-top:1rpx solid #e9eee5;padding:18rpx 25rpx calc(18rpx + env(safe-area-inset-bottom));display:flex;gap:20rpx;z-index:12}.page .squad-share-reminder,.page .squad-pending-button{flex:1;width:0;min-width:0;margin:0;border-radius:45rpx;line-height:1.5;padding:22rpx 8rpx;font-size:27rpx;background:#f3f8ed;color:#6d9b5c}.page .squad-pending-button{background:#41b16e;color:white}
