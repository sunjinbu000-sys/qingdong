<import src="../../components/states.wxml"/><view class="page"><template is="feedback" data="{{loading,error}}"/><view class="heading">小队详情</view><block wx:if="{{!loading && !error}}"><view class="card" wx:if="{{team}}"><view class="title">{{team.name}}</view><view>{{team.start}} 至 {{team.end}}</view><view>{{team.members.length}}/{{team.max}}人 · {{team.launched ? "挑战进行中" : "筹队中"}}</view><view class="notice mt">队友仅见任务状态，不共享原始体重和核验照片。</view><button wx:if="{{team.isMember && team.launched}}" class="btn primary mt" data-a="reward" bindtap="act">领取全队达标奖励</button><view class="mt">完成 {{team.progress.done}} / {{team.progress.needed}} 项</view><view wx:if="{{team.isMember}}" wx:for="{{team.tasks}}" wx:key="*this" class="item">{{item}}<button class="btn soft small" data-a="task" data-task="{{item}}" bindtap="act" disabled="{{!team.launched}}">完成今日任务</button></view><form wx:if="{{!team.isMember && !team.closed}}" bindsubmit="join"><view class="field"><input name="code" placeholder="邀请码（邀请码队必填）"/></view><button class="btn primary" form-type="submit">加入 / 申请</button></form><view wx:if="{{team.isCaptain && !team.closed}}" class="actions mt"><button class="btn primary small" data-a="launch" bindtap="act" wx:if="{{!team.launched}}">正式发起</button><button class="btn soft small" data-url="/pages/team-invite/index?id={{team.id}}" bindtap="go">邀请</button></view><button wx:if="{{team.isMember && !team.isCaptain && !team.closed}}" class="btn soft mt" data-a="leave" bindtap="act">离开小队</button><view class="item" wx:for="{{team.members}}" wx:key="*this">{{item}}<button wx:if="{{team.isCaptain && item !== team.owner}}" class="btn soft small" data-a="transfer" data-user="{{item}}" bindtap="act">转让队长</button></view><block wx:if="{{team.isCaptain}}"><view class="item" wx:for="{{team.requests}}" wx:key="*this">{{item}}<button class="btn soft small" data-a="approve" data-user="{{item}}" data-pass="yes" bindtap="act">通过</button><button class="btn soft small" data-a="approve" data-user="{{item}}" data-pass="no" bindtap="act">拒绝</button></view><view class="card mt" wx:if="{{team.contributions.length}}"><view class="title">在队日期与历史贡献</view><view class="item" wx:for="{{team.contributions}}" wx:key="index">{{item.userId}} · {{item.joined}} 至 {{item.left || "在队"}} · {{item.done}}项</view></view></block></view></block></view>