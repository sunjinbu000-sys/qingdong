<import src="../../components/states.wxml"/><view class="page team-detail-page {{dashboardMode?'dashboard-team':''}}"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error && team}}"><block wx:if="{{dashboardMode}}"><view class="squad-overview"><view class="squad-overview-main"><view class="squad-caption">小队概览</view><view class="squad-title">{{team.name}}</view><view class="squad-period">第 {{dayNumber}} 天 / 共 {{days}} 天 · {{phase}}</view><view class="squad-stat-row"><view><text class="squad-stat-value">{{team.members.length}}</text><text>位成员</text></view><view><text class="squad-stat-value">{{completeCount}}</text><text>今日完成</text></view></view><view class="squad-caption">今日未完成 {{pendingCount}} 人</view></view><view class="squad-ring" style="{{ringStyle}}"><view class="squad-ring-inner"><text class="squad-ring-value">{{todayPercent}}%</text><text>今日完成率</text></view></view><view class="squad-timeline"><view style="width:{{dayNumber/days*100}}%"></view></view></view><view wx:if="{{!team.launched && !team.cancelled}}" class="team-detail-notice">{{needed?'还需 '+needed+' 位伙伴，至少3人才能开赛。':'伙伴已凑齐，等待队长开始挑战。'}} 挑战时间：{{team.start}} 至 {{team.end}}</view><view class="squad-today-card"><view class="squad-section-title">今日打卡任务</view><view wx:for="{{todayTasks}}" wx:key="id" class="squad-task"><view class="grow"><view class="squad-task-name">{{item.label}}</view><view class="squad-caption">{{item.done?'今天已经完成':item.id==='weight'?'先保存今日体重，再完成小队任务':item.id==='early'?'按本版早起时间规则完成':'记录今天的坚持'}}</view><button wx:if="{{item.id==='weight' && !item.done && todayActive}}" class="squad-weight-link" data-url="/pages/records/index?type=weight" bindtap="go">去记体重 ›</button></view><button class="squad-check-button" data-a="task" data-task="{{item.id}}" bindtap="act" disabled="{{busy || item.done || !todayActive}}">{{item.done?'已完成':todayActive?'去打卡':phase}}</button></view><button wx:if="{{phase==='已结束' && !team.cancelled}}" class="btn soft mt" data-a="reward" bindtap="act" disabled="{{busy}}">领取全队达标奖励</button></view><view id="dashboard-members" class="squad-members"><view class="squad-members-heading"><view class="squad-section-title">伙伴打卡动态</view><view class="squad-filters"><button class="{{memberFilter==='all'?'selected':''}}" data-filter="all" bindtap="chooseMemberFilter">全部</button><button class="{{memberFilter==='pending'?'selected':''}}" data-filter="pending" bindtap="chooseMemberFilter">未完成 {{pendingCount}}</button></view></view><view class="squad-member-grid"><view wx:for="{{visibleMembers}}" wx:key="userId" class="squad-member-tile"><text class="squad-member-badge {{item.complete?'complete':''}}">{{item.status}}</text><image class="squad-member-avatar" src="/images/ui/person.svg"/><view class="squad-member-name">{{item.nickname}}{{item.isMe?'（我）':''}}</view><view class="squad-member-meta">{{item.streak?'连续'+item.streak+'天':item.done+'/'+item.total+'项任务'}}</view><text wx:if="{{item.isCaptain}}" class="squad-captain-label">队长</text></view></view><view wx:if="{{!visibleMembers.length}}" class="squad-empty">{{todayActive?'伙伴们已经完成今天的任务啦':'当前不在挑战打卡时间内'}}</view><button wx:if="{{filteredCount>8}}" class="squad-expand" bindtap="toggleMembers">{{showAllMembers?'收起成员':'展开全部 '+filteredCount+' 位成员'}}⌄</button></view><view class="squad-footer"><button open-type="share" class="squad-share-reminder">分享小队提醒</button><button class="squad-pending-button" bindtap="pendingMembers">查看未完成成员</button></view></block><block wx:else><view class="team-detail-summary"><text class="team-status-badge">{{days}} 天轻盈习惯挑战 · {{team.cancelled?'已解散':team.closed?'已结束':team.launched?'挑战中':'招募中'}}</text><view class="team-detail-name">{{team.name}}</view><view class="team-detail-subtitle">{{team.members.length}} / {{team.max}} 位伙伴，朝着同一个小目标</view></view><view class="team-pk-card"><view class="row"><view class="team-section-title">小队友好 PK</view><text class="team-wait-pill">{{team.launched?'一起坚持':team.cancelled?'已解散':'等待开赛'}}</text></view><view class="team-pk-copy">每天完成约定的习惯任务。PK 比的是照顾自己的坚持，不是掉秤速度。</view><view class="team-schedule">{{team.start}} 至 {{team.end}}</view><view wx:if="{{team.launched}}" class="team-pk-copy">完成 {{team.progress.done}} / {{team.progress.needed}} 项</view></view><view class="team-detail-notice"><block wx:if="{{!team.launched && !team.cancelled && !team.closed}}">{{needed ? '还需要 ' + needed + ' 位伙伴，至少 3 人才能开赛。' : '伙伴已凑齐，队长可以开始挑战。'}}开赛后按设定日期一起坚持 {{days}} 天。</block><block wx:else>按实际在队日期核验习惯完成情况。退出后不能继续为本队打卡。</block></view></block><button class="team-detail-help" bindtap="rules">小队挑战怎么玩？再看一遍说明</button><block wx:if="{{!dashboardMode || team.isCaptain}}"><view class="team-section-title section">{{dashboardMode?'成员与队长管理':'小队成员'}}</view><view class="team-members-card"><view wx:for="{{team.memberProfiles}}" wx:key="userId" class="team-member-row"><image class="team-member-avatar" src="/images/profile/avatar.png"/><view class="grow"><view class="team-member-name">{{item.nickname}}{{item.isMe?'（我）':''}}</view><view class="team-member-role">{{item.isCaptain?'队长':'同行伙伴'}}</view></view><button wx:if="{{team.isCaptain && !item.isCaptain && !team.closed && !team.cancelled}}" class="team-member-transfer" data-a="transfer" data-user="{{item.userId}}" bindtap="act">转让队长</button></view></view></block><view wx:if="{{team.isCaptain && !team.closed && !team.cancelled}}" class="team-main-actions"><button class="team-invite-button" data-url="/pages/team-invite/index?id={{team.id}}" bindtap="go">邀请伙伴</button><button class="team-launch-button" wx:if="{{!team.launched}}" data-a="launch" bindtap="act" disabled="{{busy || needed>0}}">开始挑战</button></view><button wx:if="{{team.isCaptain && !team.launched && !team.closed && !team.cancelled}}" class="team-dissolve-button" bindtap="dissolve">解散小队</button><button wx:if="{{team.isMember && !team.isCaptain && !team.closed && !team.cancelled}}" class="btn soft mt" data-a="leave" bindtap="act">离开小队</button><view wx:if="{{!dashboardMode && team.isMember && team.launched && !team.closed && !team.cancelled}}" class="card section"><view class="title">今天的小习惯</view><view wx:for="{{taskLabels}}" wx:key="id" class="team-task-row"><text>{{item.label}}</text><button class="btn soft small" data-a="task" data-task="{{item.id}}" bindtap="act" disabled="{{busy}}">完成今日任务</button></view><button class="btn mt" data-a="reward" bindtap="act" disabled="{{busy}}">领取全队达标奖励</button></view><form wx:if="{{!team.isMember && !team.closed && !team.cancelled}}" class="card section" bindsubmit="join"><input class="input" name="code" placeholder="邀请码（邀请码队必填）"/><button class="btn mt" form-type="submit">加入 / 申请</button></form><view wx:if="{{team.isCaptain && team.requests.length && !team.cancelled}}" class="card section"><view class="title">加入申请</view><view class="team-task-row" wx:for="{{team.requests}}" wx:key="*this"><text class="grow">{{item}}</text><button data-a="approve" data-user="{{item}}" data-pass="yes" bindtap="act">通过</button><button data-a="approve" data-user="{{item}}" data-pass="no" bindtap="act">拒绝</button></view></view><view wx:if="{{team.isCaptain && team.launched && team.contributions.length}}" class="card section"><view class="title">在队日期与历史贡献</view><view wx:for="{{team.contributions}}" wx:key="index" class="caption">{{item.userId}} · {{item.joined}} 至 {{item.left || '在队'}} · {{item.done}} 项</view></view><view class="team-detail-privacy">饮食详情、体重和 BMI 默认仅自己可见。</view></block><view wx:if="{{!loading && !error && !team}}" class="empty">暂无小队，先创建或加入一个小队吧。</view><include src="../../components/team-rules-view.wxml"/></view>