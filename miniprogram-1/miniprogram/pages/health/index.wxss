.diary-summary .number{font-size:37rpx}.meal-empty{font-size:22rpx;color:#98a18e;padding-top:20rpx}.diary-summary .grid3{gap:3rpx}

.calendar-caption{display:flex;flex-direction:column;gap:8rpx;font-size:27rpx;color:#385947;margin-bottom:20rpx}.calendar-caption text{font-size:21rpx;color:#95a18d}
.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8rpx}
.calendar-weekday{text-align:center;font-size:23rpx;color:#97a28f;padding:8rpx 0}
.page .calendar-day{width:100%;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5rpx;padding:12rpx 0;background:transparent;color:#49614c;font-size:25rpx;line-height:1.4;border-radius:18rpx}
.page .calendar-day.selected{background:#1d6651;color:#fff}.calendar-day[disabled]{opacity:.28}.calendar-dot{width:7rpx;height:7rpx;border-radius:50%;background:transparent}.calendar-dot.marked{background:#96b47a}.selected .calendar-dot.marked{background:#e6f3d4}
.day-health{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;font-size:22rpx;color:#708463;border-top:1rpx solid #d3dfc8;padding-top:20rpx}.diary-summary .number{overflow-wrap:anywhere}

.journal-date-header{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:30rpx}.journal-kicker{font-size:20rpx;color:#8e7dab;letter-spacing:2rpx;font-weight:650;line-height:1.3}.journal-date-title{display:flex;align-items:baseline;color:#263454;font-size:46rpx;font-weight:700;line-height:1.4}.journal-weekday-title{font-size:23rpx;color:#7c6f94;font-weight:400;margin-left:4rpx}.page .journal-backfill{width:auto;min-width:0;padding:8rpx 0;background:transparent;color:#8068d8;font-size:24rpx;line-height:1.5}
.journal-week{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8rpx;margin-bottom:28rpx}.page .journal-day{width:100%;min-width:0;padding:16rpx 0;display:flex;flex-direction:column;align-items:center;gap:8rpx;border-radius:30rpx;background:transparent;line-height:1.4;color:#263454}.journal-weekday{font-size:23rpx;color:#9b8db5}.journal-day-number{font-size:30rpx;font-weight:650}.journal-day-dot{width:8rpx;height:8rpx;border:1rpx solid #c7bcdb;border-radius:50%}.journal-day-dot.has-records{background:#a18acb;border-color:#a18acb}.page .journal-day.is-selected{background:#8870e3;color:#fff;box-shadow:0 10rpx 26rpx #8870e32b}.is-selected .journal-weekday{color:#eee8ff}.is-selected .journal-day-dot{border-color:#cbbdf5}.is-selected .journal-day-dot.has-records{background:#fff;border-color:#fff}

.page .daily-meals-entry{width:100%;display:flex;align-items:center;gap:20rpx;padding:30rpx 26rpx;background:#fff;border-radius:42rpx;text-align:left;min-height:180rpx}.daily-meals-icon{width:120rpx;height:120rpx;flex-shrink:0}.daily-meals-title{font-size:29rpx;font-weight:650;color:#293553;line-height:1.5}.daily-meals-caption{font-size:23rpx;color:#a08ab9;margin-top:10rpx;line-height:1.7}.daily-meals-arrow{font-size:32rpx;color:#b4a6c6}
