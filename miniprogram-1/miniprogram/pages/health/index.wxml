<import src="../../components/states.wxml"/>
<view class="page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}">
<view class="journal-date-header"><view><view class="journal-kicker">MY FOOD JOURNAL</view><picker mode="date" value="{{date}}" start="2000-01-01" end="{{today}}" bindchange="selectDate"><view class="journal-date-title"><text>{{dateTitle}}</text><text class="journal-weekday-title">{{weekdayTitle}}</text></view></picker></view><button class="journal-backfill" data-url="/pages/records/index?type=meal&date={{date}}" bindtap="go"><image class="feature-entry-icon" src="/images/ui/edit.svg" mode="aspectFit"/><text>＋ 补记</text></button></view>
<view class="journal-week"><button wx:for="{{weekDates}}" wx:key="date" class="journal-day {{item.selected ? 'is-selected' : ''}}" data-date="{{item.date}}" disabled="{{item.future}}" bindtap="selectCalendarDate"><text class="journal-weekday">{{item.weekday}}</text><text class="journal-day-number">{{item.day}}</text><view class="journal-day-dot {{item.hasRecords ? 'has-records' : ''}}"></view></button></view>
<view class="hero diary-summary mt"><view class="row"><text class="section-kicker">{{date}} · 当天概览</text><text class="pill">{{dayCheckedIn ? '已签到' : '未签到'}}</text></view><view class="grid3 mt"><view><view class="number">{{diary.summary.calories}}<text class="unit">千卡</text></view><text class="label">饮食摄入</text></view><view><view class="number">{{diary.summary.minutes}}<text class="unit">分钟</text></view><text class="label">运动时长</text></view><view><view class="number">{{diary.summary.weight}}<text class="unit">kg</text></view><text class="label">当日体重</text></view></view><view class="day-health mt"><text>运动消耗 {{overview.exerciseCalories}} 千卡</text><text>蛋白质 {{overview.nutrition.protein}} 克</text><text>碳水 {{overview.nutrition.carb}} 克</text><text>脂肪 {{overview.nutrition.fat}} 克</text></view><view class="small-text mt">{{signedIn ? '以下为你在当天保存的个人记录。' : '登录后查看自己的记录，当前未加载个人数据。'}}</view></view>
<view wx:if="{{!signedIn}}" class="card section"><view class="empty"><text class="empty-title">开启你的健康日记</text>登录模拟账号，记录属于自己的每一天。</view><button class="btn" data-url="/pages/account/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/edit.svg" mode="aspectFit"/><text>开始记录 ↗</text></button></view>
<block wx:if="{{signedIn}}"><view class="service-links section"><button class="btn soft" data-url="/pages/health-overview/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/weight.svg" mode="aspectFit"/><text>日历 · 营养 · 变化</text></button><button class="btn soft" data-url="/pages/food-library/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/sun.svg" mode="aspectFit"/><text>食物库与食谱</text></button><button class="btn soft" data-url="/pages/team/index" bindtap="go"><image class="feature-entry-icon" src="/images/home/shortcuts/team.png" mode="aspectFit"/><text>小队打卡</text></button><button class="btn soft" data-url="/pages/ai-plan/index" bindtap="go"><image class="feature-entry-icon" src="/images/home/shortcuts/ai-plan.png" mode="aspectFit"/><text>轻动计划与任务</text></button></view>
<view class="section"><view class="section-head"><text class="section-title">我的一日三餐</text></view><button class="daily-meals-entry" data-url="/pages/daily-meals/index?date={{date}}" bindtap="go"><image class="daily-meals-icon" src="/images/home/shortcuts/ai-plan.png" mode="aspectFit"/><view class="grow"><view class="daily-meals-title">{{diary.meals.length ? '认真吃过的每一餐，都在这里' : '从第一餐，开始照顾自己'}}</view><view class="daily-meals-caption">{{diary.meals.length ? date + ' · 已记录 ' + diary.meals.length + ' 条餐食，点击查看' : '这里会收好你的每一餐和每一个小进步。'}}</view></view><text class="daily-meals-arrow">›</text></button></view>
<view class="section"><view class="section-head"><text class="section-title">轻轻运动</text><button class="link" data-url="/pages/records/index?type=exercise&date={{date}}" bindtap="go"><image class="feature-entry-icon" src="/images/ui/edit.svg" mode="aspectFit"/><text>＋ 记运动</text></button></view><view class="card"><view wx:if="{{!diary.exercises.length}}" class="empty">散步、拉伸，也是一份小小的坚持。</view><view wx:for="{{diary.exercises}}" wx:key="id" class="record-row"><view class="icon-box"><image class="icon" src="/images/ui/walk.svg"/></view><view class="grow"><view class="title">{{item.name}}</view><text class="small-text">{{item.minutes}} 分钟</text></view><button class="delete" data-id="{{item.id}}" bindtap="remove">删除</button></view></view></view>
<view class="section"><view class="section-head"><text class="section-title">认识自己的变化</text><button class="link" data-url="/pages/records/index?type=weight&date={{date}}" bindtap="go"><image class="feature-entry-icon" src="/images/ui/edit.svg" mode="aspectFit"/><text>＋ 记体重</text></button></view><view class="card"><view wx:if="{{!diary.weights.length}}" class="empty">暂时没有体重记录，每一次记录都只属于你。</view><view wx:for="{{diary.weights}}" wx:key="id" class="record-row"><view class="icon-box"><image class="icon" src="/images/ui/weight.svg"/></view><view class="grow"><view class="number">{{item.kg}}<text class="unit">kg</text></view><text class="small-text">{{item.date}} · 仅自己可见</text></view><button class="delete" data-id="{{item.id}}" bindtap="remove">删除</button></view></view></view></block>
</block><view wx:if="{{adPlacement}}" class="mock-ad"><text class="pill">模拟广告位</text><view>{{adPlacement.unitId}}</view><text class="caption">已启用该页面展示位，当前不加载真实广告</text></view><view class="footnote">轻动 · 每一步坚持，都值得被看见</view></view>
