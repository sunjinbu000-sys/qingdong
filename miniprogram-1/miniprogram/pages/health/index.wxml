<import src="../../components/states.wxml"/>
<view class="page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}">
<view class="eyebrow">MY DAILY LITTLE THINGS</view><view class="heading">好好生活，慢慢记录。</view><view class="subtitle">每一餐、每一步，都是照顾自己的证据。</view>
<view wx:if="{{!signedIn}}" class="card section"><view class="empty"><text class="empty-title">开启你的健康日记</text>登录模拟账号，记录属于自己的每一天。</view><button class="btn" data-url="/pages/account/index" bindtap="go">开始记录 ↗</button></view>
<block wx:else><view class="row section"><view class="row"><button class="date-arrow" data-days="-1" disabled="{{date <= '2000-01-01'}}" bindtap="shift">‹</button><picker mode="date" value="{{date}}" start="2000-01-01" end="{{today}}" bindchange="selectDate"><view class="date-control">{{date}} ⌄</view></picker><button class="date-arrow" data-days="1" disabled="{{date >= today}}" bindtap="shift">›</button></view><text class="pill">{{date === today ? '今天' : '往日时光'}}</text></view>
<view class="diary-calendar card mt"><view class="calendar-caption">我的日记 · {{monthLabel}}<text>有记录的日期会标记圆点</text></view><view class="calendar-grid"><text wx:for="{{weekdays}}" wx:key="*this" class="calendar-weekday">{{item}}</text><view wx:for="{{paddingCells}}" wx:key="*this"></view><button wx:for="{{overview.calendar}}" wx:key="date" class="calendar-day {{item.selected ? 'selected' : ''}}" data-date="{{item.date}}" disabled="{{item.future}}" bindtap="selectCalendarDate"><text>{{item.day}}</text><view class="calendar-dot {{item.hasRecords || item.checkedIn ? 'marked' : ''}}"></view></button></view></view>
<view class="hero diary-summary mt"><view class="row"><text class="section-kicker">{{date}} · 当天概览</text><text class="pill">{{dayCheckedIn ? '已签到' : '未签到'}}</text></view><view class="grid3 mt"><view><view class="number">{{diary.summary.calories}}<text class="unit">千卡</text></view><text class="label">饮食摄入</text></view><view><view class="number">{{diary.summary.minutes}}<text class="unit">分钟</text></view><text class="label">运动时长</text></view><view><view class="number">{{diary.summary.weight}}<text class="unit">kg</text></view><text class="label">当日体重</text></view></view><view class="day-health mt"><text>运动消耗 {{overview.exerciseCalories}} 千卡</text><text>蛋白质 {{overview.nutrition.protein}} 克</text><text>碳水 {{overview.nutrition.carb}} 克</text><text>脂肪 {{overview.nutrition.fat}} 克</text></view><view class="small-text mt">以下为你在当天保存的个人记录。</view></view>
<view class="service-links section"><button class="btn soft" data-url="/pages/health-overview/index" bindtap="go">日历 · 营养 · 变化</button><button class="btn soft" data-url="/pages/food-library/index" bindtap="go">食物库与食谱</button><button class="btn soft" data-url="/pages/team/index" bindtap="go">小队打卡</button><button class="btn soft" data-url="/pages/ai-plan/index" bindtap="go">轻动计划与任务</button></view>
<view class="section"><view class="section-head"><text class="section-title">好好吃饭</text><button class="link" data-url="/pages/records/index?type=meal&date={{date}}" bindtap="go">＋ 记一餐</button></view><view class="card" wx:for="{{mealGroups}}" wx:key="key"><view class="row"><view class="row start"><image class="inline-icon" src="/images/ui/{{item.icon}}.svg"/><text class="title">{{item.label}}</text></view><text class="small-text">{{item.total}} kcal</text></view><view wx:if="{{!item.records.length}}" class="meal-empty">还没有记录，记下认真吃饭的自己。</view><view wx:for="{{item.records}}" wx:for-item="record" wx:key="id" class="record-row"><image wx:if="{{record.imagePath}}" class="thumb" mode="aspectFill" src="{{record.imagePath}}"/><view class="grow"><view class="title">{{record.name}}</view><text class="small-text">{{record.kcal}} kcal · {{record.source === 'recognition' ? '模拟识餐' : '手动记录'}}</text></view><button class="delete" data-id="{{record.id}}" bindtap="remove">删除</button></view></view><button wx:if="{{date === today}}" class="btn soft mt" data-url="/pages/photo/index" bindtap="go"><image class="inline-icon" src="/images/ui/camera.svg"/>拍照，记下这一餐</button></view>
<view class="section"><view class="section-head"><text class="section-title">轻轻运动</text><button class="link" data-url="/pages/records/index?type=exercise&date={{date}}" bindtap="go">＋ 记运动</button></view><view class="card"><view wx:if="{{!diary.exercises.length}}" class="empty">散步、拉伸，也是一份小小的坚持。</view><view wx:for="{{diary.exercises}}" wx:key="id" class="record-row"><view class="icon-box"><image class="icon" src="/images/ui/walk.svg"/></view><view class="grow"><view class="title">{{item.name}}</view><text class="small-text">{{item.minutes}} 分钟</text></view><button class="delete" data-id="{{item.id}}" bindtap="remove">删除</button></view></view></view>
<view class="section"><view class="section-head"><text class="section-title">认识自己的变化</text><button class="link" data-url="/pages/records/index?type=weight&date={{date}}" bindtap="go">＋ 记体重</button></view><view class="card"><view wx:if="{{!diary.weights.length}}" class="empty">暂时没有体重记录，每一次记录都只属于你。</view><view wx:for="{{diary.weights}}" wx:key="id" class="record-row"><view class="icon-box"><image class="icon" src="/images/ui/weight.svg"/></view><view class="grow"><view class="number">{{item.kg}}<text class="unit">kg</text></view><text class="small-text">{{item.date}} · 仅自己可见</text></view><button class="delete" data-id="{{item.id}}" bindtap="remove">删除</button></view></view></view></block>
</block><view wx:if="{{adPlacement}}" class="mock-ad"><text class="pill">模拟广告位</text><view>{{adPlacement.unitId}}</view><text class="caption">已启用该页面展示位，当前不加载真实广告</text></view><view class="footnote">轻动 · 每一步坚持，都值得被看见</view></view>
