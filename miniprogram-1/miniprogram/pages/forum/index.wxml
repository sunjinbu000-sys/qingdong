<view class="page"><view wx:if="{{error}}" class="card">{{error}}<button bindtap="retry">重试</button></view><view class="card"><button data-key="sort" data-value="hot" bindtap="option">热门</button><button data-key="sort" data-value="new" bindtap="option">最新</button><button data-key="sameCity" data-value="{{!sameCity}}" bindtap="option">{{sameCity?'全部城市':'同城'}}</button><button wx:for="{{['','生活分享','饮食打卡','运动打卡','小队打卡']}}" wx:key="*this" data-key="kind" data-value="{{item}}" bindtap="option">{{item||'全部分类'}}</button><button data-mode="public" bindtap="filter">公开</button><button data-mode="mine" bindtap="filter">我的</button><button data-mode="draft" bindtap="filter">草稿</button><button data-url="/pages/forum-editor/index" bindtap="go">发布图文</button></view><view class="card" wx:for="{{posts}}" wx:key="id"><button data-url="/pages/forum-detail/index?id={{item.id}}" bindtap="go">{{item.title||item.kind}} · {{statusLabels[item.status] || item.status}}</button><view>{{item.author}} · {{item.city}}</view><view>{{item.text}}</view><image wx:for="{{item.images}}" wx:for-item="src" wx:key="*this" src="{{src}}"/><view>赞 {{item.likeCount}} · 收藏 {{item.favoriteCount}}</view></view><view wx:if="{{!posts.length}}" class="card">暂无帖子</view></view>