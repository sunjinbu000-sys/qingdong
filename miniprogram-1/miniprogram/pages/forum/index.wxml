<view class="page forum-page">
  <view class="forum-header">
    <view class="eyebrow">SHARE A LITTLE EVERY DAY</view>
    <view class="forum-heading">生活里的轻动，和你一起。</view>
    <view class="forum-tabs"><button wx:for="{{tabs}}" wx:key="id" class="forum-tab {{tab===item.id?'is-active':''}}" data-id="{{item.id}}" bindtap="changeTab">{{item.label}}</button></view>
  </view>
  <view wx:if="{{tab==='mine'}}" class="mine-tabs"><button wx:for="{{mineTabs}}" wx:key="id" class="mine-tab {{mine===item.id?'is-active':''}}" data-id="{{item.id}}" bindtap="changeMine">{{item.label}}</button></view>
  <view wx:if="{{tab==='local'}}" class="card region-card"><view class="row"><view class="grow"><view class="title">{{locating?'正在识别当前城市…':region?region.label:'定位你所在的城市'}}</view><text class="caption">{{region?'显示该城市的公开笔记':'开启定位后，查看身边轻友的日常'}}</text></view><button class="location-button" bindtap="locate" disabled="{{locating}}">{{locating?'定位中…':'重新定位'}}</button></view><view wx:if="{{locationError}}" class="error-inline">{{locationError}}</view><button wx:if="{{locationError}}" class="manual-city-button" bindtap="manualLocate">手动选择位置 ›</button></view>
  <view wx:if="{{loading}}" class="feed-message">正在加载文章…</view>
  <view wx:elif="{{error}}" class="card feed-message">{{error}}<button bindtap="retry">重新加载</button></view>
  <view wx:elif="{{tab==='mine'&&!signedIn}}" class="card feed-message">登录后查看你的文章和互动记录<button class="btn mt" data-url="/pages/account/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/edit.svg" mode="aspectFit"/><text>去登录</text></button></view>
  <block wx:else>
    <view wx:if="{{!posts.length && (tab!=='local'||region)}}" class="card feed-empty"><view class="empty-mark">✧</view><view>{{emptyText}}</view></view>
    <view wx:for="{{posts}}" wx:key="id" class="card post-card"><view class="post-author-row"><image class="post-author-avatar" src="/images/profile/avatar.png" data-id="{{item.id}}" bindtap="author"/><view class="grow" data-id="{{item.id}}" bindtap="author"><view class="author-name">{{item.author}}</view><view class="post-meta">{{item.timeLabel}} · {{item.city}}</view></view><button wx:if="{{!item.anonymous && !item.mine && item.status==='approved'}}" class="post-follow {{item.following?'is-following':''}}" data-user="{{item.userId}}" bindtap="follow" disabled="{{busy}}">{{item.following?'已关注':'关注'}}</button><button class="post-more" data-id="{{item.id}}" bindtap="more">⋮</button></view><view class="post-main"><view data-url="/pages/forum-detail/index?id={{item.id}}" bindtap="go"><view wx:if="{{item.title}}" class="post-title">{{item.title}}</view><view class="post-content">{{item.text}}<text class="post-topic">#{{item.kind}}</text></view><text wx:if="{{tab==='mine'&&mine==='mine'&&(item.status==='draft'||item.status==='withdrawn'||item.status==='deleted')}}" class="post-status">{{statusLabels[item.status]||item.status}}</text></view><view wx:if="{{item.images.length}}" class="post-images {{item.images.length===1?'single-photo':''}}"><image class="post-grid-photo" wx:for="{{item.images}}" wx:for-item="src" wx:key="*this" mode="aspectFill" src="{{src}}" data-current="{{src}}" data-images="{{item.images}}" bindtap="preview"/></view><video wx:if="{{item.video}}" class="post-video" src="{{item.video}}" controls/><button class="post-life-prompt" bindtap="publish"><text>✦</text><text class="grow">记录日常，分享生活里的每一份改变</text><text>›</text></button><view class="post-footer"><button class="post-favorite" data-url="/pages/forum-detail/index?id={{item.id}}" bindtap="go">{{item.status==='draft'?'查看草稿':'查看笔记'}} ›</button><view class="post-interactions"><button class="post-like {{item.liked?'is-liked':''}}" data-id="{{item.id}}" bindtap="like" disabled="{{busy || item.status!=='approved'}}"><image class="post-interaction-icon" src="/images/ui/heart.svg"/><text>{{item.likeCount}}</text></button><button class="post-comment" data-url="/pages/forum-detail/index?id={{item.id}}" bindtap="go"><image class="post-interaction-icon" src="/images/ui/comment.svg"/><text>{{item.comments.length}}</text></button></view></view></view></view>
  </block>
</view>
<view class="forum-compose-bar"><button class="forum-publish" bindtap="publish">＋ 发布</button></view>
