.forum-page{padding-top:0;padding-bottom:calc(180rpx + env(safe-area-inset-bottom))}
.forum-header{position:sticky;top:0;z-index:10;background:#f6f7f2;padding-top:28rpx;margin-bottom:24rpx}
.forum-heading{font-size:34rpx;font-weight:650;color:#244b3b;margin-bottom:22rpx}
.forum-tabs{display:flex;border-bottom:1rpx solid #dfe6d8;gap:8rpx}
.forum-tabs .forum-tab{flex:1;min-width:0;width:auto;background:transparent;border-radius:0;font-size:27rpx;color:#8a9682;padding:18rpx 0;border-bottom:5rpx solid transparent}
.forum-tabs .forum-tab.is-active{color:#1d6651;border-bottom-color:#1d6651;font-weight:650}
.mine-tabs{display:flex;gap:12rpx;margin-bottom:24rpx}.mine-tabs .mine-tab{flex:1;width:auto;min-width:0;font-size:23rpx;padding:13rpx 4rpx;background:#eaf0e4;color:#7d8d72}.mine-tabs .is-active{background:#1d6651;color:#fff}
.region-card{margin-bottom:24rpx}.region-card .location-button{width:auto;min-width:0;flex-shrink:0;font-size:22rpx;padding:14rpx 18rpx}
.feed-message{text-align:center;padding:36rpx 20rpx;color:#7d8e72}.feed-empty{text-align:center;padding:65rpx 25rpx;color:#87967b;font-size:25rpx}.empty-mark{font-size:60rpx;color:#a9bb8a;margin-bottom:15rpx}
.post-card{margin-bottom:22rpx}.author-name{font-size:26rpx;font-weight:600}.post-meta{font-size:20rpx;color:#98a18f}.post-category{font-size:20rpx;color:#739b62;margin:8rpx 0 22rpx}.post-status{color:#a58d5c}.post-title{font-size:30rpx;font-weight:650;margin-bottom:12rpx}.post-content{white-space:pre-wrap;font-size:27rpx;line-height:1.8;overflow-wrap:break-word}.post-images{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx;margin-top:22rpx}.post-images .post-grid-photo{width:100%;height:170rpx;border-radius:14rpx}.post-footer{display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #edf0e8;margin-top:24rpx;padding-top:18rpx;color:#99a58f;font-size:21rpx}.post-footer .read-post{width:auto;min-width:0;background:transparent;color:#618952;padding:4rpx;font-size:22rpx}
.forum-compose-bar{position:fixed;bottom:0;left:0;right:0;z-index:30;background:#f6f7f2f5;border-top:1rpx solid #e3e9dd;display:flex;justify-content:center;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom))}
.forum-compose-bar .forum-publish{width:260rpx;min-width:0;line-height:1.5;padding:20rpx 30rpx;border-radius:60rpx;background:#1d6651;color:#fff;font-size:29rpx;box-shadow:0 8rpx 24rpx #1d665126}

/* One continuous lavender header and a single-row navigation. */
.forum-header{margin-left:-32rpx;margin-right:-32rpx;padding:28rpx 32rpx 0;background:#eee8fa}
.forum-header .eyebrow{color:#9a88b8}.forum-heading{color:#3d3158}
.forum-tabs{display:flex;flex-wrap:nowrap;gap:0;border-bottom:1rpx solid #dfd4ef;background:#eee8fa}
.forum-tabs .forum-tab{background:#eee8fa;color:#9a88b8;white-space:nowrap;font-size:26rpx;padding:20rpx 0}
.forum-tabs .forum-tab.is-active{background:#eee8fa;color:#795bb8;border-bottom-color:#9676ce}
.mine-tabs .mine-tab{background:#eee8fa;color:#9a88b8}.mine-tabs .mine-tab.is-active{background:#ddd0f1;color:#795bb8}

.post-card{border:0;border-radius:32rpx;padding:28rpx 22rpx;margin-bottom:22rpx}.post-author-row{display:flex;align-items:center;gap:15rpx}.post-author-avatar{width:76rpx;height:76rpx;border-radius:50%;background:#eee7fa;flex-shrink:0}.post-author-row .author-name{font-size:26rpx;color:#6a6175;font-weight:600}.post-author-row .post-meta{font-size:20rpx;color:#afa3bc;margin-top:6rpx}.page .post-follow{width:auto;min-width:0;margin:0;padding:5rpx 20rpx;background:transparent;border:1rpx solid #aa8fd8;border-radius:30rpx;color:#9a77cf;font-size:24rpx;line-height:1.5}.page .post-follow.is-following{color:#b3a4c1;border-color:#e0d7eb}.page .post-more{width:30rpx;min-width:0;margin:0;padding:0;background:transparent;color:#b8abca;font-size:38rpx;line-height:1.4}.post-main{margin-left:91rpx;margin-top:15rpx;min-width:0}.post-title{font-size:29rpx;color:#453857;line-height:1.6;font-weight:600}.post-content{font-size:26rpx;color:#6e617d;line-height:1.8;word-break:break-all}.post-topic{color:#a182ca}.post-images{margin-top:16rpx;gap:8rpx}.post-images .post-grid-photo{height:130rpx;margin:0;border-radius:12rpx}.post-images.single-photo{grid-template-columns:minmax(0,1fr)}.post-images.single-photo .post-grid-photo{height:520rpx;width:100%;border-radius:16rpx}.post-video{width:100%;height:400rpx;border-radius:20rpx;margin-top:16rpx}.page .post-life-prompt{width:100%;display:flex;align-items:center;gap:9rpx;margin:20rpx 0 0;padding:8rpx 13rpx;background:#fcfaff;border:1rpx solid #eee7f4;border-radius:40rpx;color:#aa94bf;text-align:left;font-size:19rpx;line-height:1.5}.post-footer{border-top:0;padding-top:14rpx;margin-top:0;gap:8rpx}.page .post-favorite{background:transparent;color:#b3a0c4;margin:0;padding:6rpx 0;font-size:20rpx;width:auto;flex-shrink:0}.post-interactions{display:flex;gap:24rpx;align-items:center}.page .post-like,.page .post-comment{display:flex;align-items:center;gap:7rpx;background:transparent;color:#b6a6c5;margin:0;padding:5rpx 0;width:auto;font-size:23rpx;line-height:1.4}.page .post-like.is-liked{color:#b17bcc}.post-interaction-icon{width:38rpx;height:38rpx}.page .manual-city-button{background:transparent;text-align:left;font-size:23rpx;color:#9273be;margin:10rpx 0 0;padding:6rpx 0}.region-card .title{font-size:26rpx}.forum-compose-bar{background:#f5f0fbf5;border-color:#e8def3}.forum-compose-bar .forum-publish{background:#9276ce;box-shadow:0 8rpx 24rpx #8a68ba20}

.post-topic{display:inline-block;white-space:nowrap;margin-left:8rpx}

.forum-personal-page .forum-header{margin-bottom:0}.forum-personal-hero{margin:0 -32rpx;padding:34rpx 28rpx 30rpx;background:linear-gradient(130deg,#e5d9f4,#f6dfe6 70%,#ffe5d9)}.forum-personal-identity{display:flex;align-items:center;gap:25rpx}.forum-personal-avatar{width:140rpx;height:140rpx;border-radius:50%;background:#fff;border:4rpx solid #fff;flex-shrink:0}.forum-personal-name{font-size:31rpx;font-weight:650;line-height:1.6;color:#3e3453;overflow-wrap:anywhere}.forum-personal-id{font-size:21rpx;color:#a08aaf;margin-top:6rpx;word-break:break-all}.page .forum-personal-bio{width:100%;min-width:0;display:flex;align-items:center;gap:16rpx;text-align:left;background:transparent;margin:20rpx 0 0;padding:0;color:#9e83ad;font-size:24rpx;line-height:1.7}.forum-personal-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18rpx;text-align:center;color:#8c739b;font-size:24rpx;margin-top:34rpx}.forum-personal-count{font-size:30rpx;color:#594466}.forum-personal-page .mine-tabs{margin:0 -32rpx 0;background:#fff;padding:10rpx 16rpx;gap:0;border-radius:28rpx 28rpx 0 0}.forum-personal-page .mine-tabs .mine-tab{background:#fff;border-radius:0;color:#aa9ab6;font-size:24rpx;border-bottom:4rpx solid transparent;padding:20rpx 4rpx}.forum-personal-page .mine-tabs .mine-tab.is-active{color:#7657a5;background:#fff;border-bottom-color:#a17bcd}.personal-notes-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:start;gap:16rpx;margin:0 -12rpx;padding-top:12rpx}.personal-note-card{position:relative;min-width:0;background:#fff;border-radius:18rpx;overflow:hidden;box-shadow:0 6rpx 20rpx #9576bb08}.personal-note-cover{width:100%;height:335rpx;display:block;background:#f0e9f8}.personal-note-text-cover{height:260rpx;background:linear-gradient(135deg,#eee6fa,#fcece4);padding:28rpx 22rpx;display:-webkit-box;-webkit-line-clamp:6;-webkit-box-orient:vertical;overflow:hidden;font-size:28rpx;line-height:1.8;color:#8d739f}.personal-note-video{height:310rpx;background:#eee7f8;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:20rpx;color:#a28bb8;font-size:24rpx}.personal-note-video-icon{width:72rpx;height:72rpx}.personal-note-status{position:absolute;top:10rpx;left:10rpx;background:#76608799;color:#fff;font-size:20rpx;padding:3rpx 10rpx;border-radius:8rpx}.personal-note-copy{padding:15rpx 14rpx 20rpx}.personal-note-title{font-size:25rpx;font-weight:600;color:#4b3b5b;line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-all}.personal-note-author{display:flex;align-items:center;gap:6rpx;margin-top:16rpx;font-size:18rpx;color:#a18bb2}.personal-note-avatar{width:29rpx;height:29rpx;border-radius:50%;flex-shrink:0}.personal-note-author-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.personal-note-heart{width:28rpx;height:28rpx;flex-shrink:0}.forum-compose-bar.personal-compose-bar{left:auto;right:26rpx;bottom:34rpx;padding:0;background:transparent;border:0}.personal-compose-bar .forum-publish{width:100rpx;height:100rpx;min-width:0;min-height:0;border-radius:50%;padding:0;font-size:66rpx;line-height:94rpx;background:#a17acb;box-shadow:0 8rpx 25rpx #9270b335}
