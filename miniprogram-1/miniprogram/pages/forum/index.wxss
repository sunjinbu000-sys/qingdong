.forum-page{padding-top:0;padding-bottom:calc(180rpx + env(safe-area-inset-bottom))}
.forum-header{position:sticky;top:0;z-index:10;background:#f6f7f2;padding-top:28rpx;margin-bottom:24rpx}
.forum-heading{font-size:34rpx;font-weight:650;color:#244b3b;margin-bottom:22rpx}
.forum-tabs{display:flex;border-bottom:1rpx solid #dfe6d8;gap:8rpx}
.forum-tabs .forum-tab{flex:1;min-width:0;width:auto;background:transparent;border-radius:0;font-size:27rpx;color:#8a9682;padding:18rpx 0;border-bottom:5rpx solid transparent}
.forum-tabs .forum-tab.is-active{color:#1d6651;border-bottom-color:#1d6651;font-weight:650}
.mine-tabs{display:flex;gap:12rpx;margin-bottom:24rpx}.mine-tabs .mine-tab{flex:1;width:auto;min-width:0;font-size:23rpx;padding:13rpx 4rpx;background:#eaf0e4;color:#7d8d72}.mine-tabs .is-active{background:#1d6651;color:#fff}
.region-card{margin-bottom:24rpx}.region-card .location-button{width:auto;min-width:0;flex-shrink:0;font-size:22rpx;padding:14rpx 18rpx}
.feed-message{text-align:center;padding:36rpx 20rpx;color:#7d8e72}.feed-empty{text-align:center;padding:65rpx 25rpx;color:#87967b;font-size:25rpx}.empty-mark{font-size:60rpx;color:#a9bb8a;margin-bottom:15rpx}
.post-card{margin-bottom:22rpx}.author-name{font-size:26rpx;font-weight:600}.post-meta{font-size:20rpx;color:#98a18f}.post-category{font-size:20rpx;color:#739b62;margin:8rpx 0 22rpx}.post-status{color:#a58d5c}.post-title{font-size:30rpx;font-weight:650;margin-bottom:12rpx}.post-content{white-space:pre-wrap;font-size:27rpx;line-height:1.8;overflow-wrap:break-word}.post-images{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx;margin-top:22rpx}.post-images image{width:100%;height:170rpx;border-radius:14rpx}.post-footer{display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #edf0e8;margin-top:24rpx;padding-top:18rpx;color:#99a58f;font-size:21rpx}.post-footer .read-post{width:auto;min-width:0;background:transparent;color:#618952;padding:4rpx;font-size:22rpx}
.forum-compose-bar{position:fixed;bottom:0;left:0;right:0;z-index:30;background:#f6f7f2f5;border-top:1rpx solid #e3e9dd;display:flex;justify-content:center;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom))}
.forum-compose-bar .forum-publish{width:260rpx;min-width:0;line-height:1.5;padding:20rpx 30rpx;border-radius:60rpx;background:#1d6651;color:#fff;font-size:29rpx;box-shadow:0 8rpx 24rpx #1d665126}
