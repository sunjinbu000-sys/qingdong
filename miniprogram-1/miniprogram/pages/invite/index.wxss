page{background:#f7f5f9}.invite-dashboard{position:relative;padding:26rpx 24rpx 55rpx;color:#293553}.invite-header-bg{position:absolute;z-index:0;left:0;right:0;top:0;height:285rpx;background:linear-gradient(120deg,#ffb36f,#ff8d51)}.invite-profile-card,.invite-summary-card,.invite-menu-card,.invite-code-card,.invite-poster-card{position:relative;z-index:1;background:#fff;border-radius:26rpx;padding:28rpx;margin-bottom:20rpx}.invite-profile-row{display:flex;align-items:center;gap:18rpx}.invite-avatar{width:88rpx;height:88rpx;border-radius:50%}.invite-name{font-size:29rpx;font-weight:650}.invite-tag{display:inline-block;border-radius:18rpx;background:#f4ecfa;color:#a08abb;font-size:19rpx;padding:4rpx 12rpx;margin-top:9rpx}.page .invite-header-share{width:auto;min-width:0;background:#fff1e8;color:#cf8b64;font-size:22rpx;padding:6rpx 15rpx;border-radius:30rpx;line-height:1.5}.invite-hero-stats{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:30rpx}.invite-hero-stats text{font-size:23rpx;color:#a598af}.invite-hero-stats>view>view{font-size:44rpx;font-weight:700;margin-top:8rpx}.invite-card-heading{display:flex;align-items:center;justify-content:space-between;font-size:28rpx;font-weight:600}.page .invite-card-heading button{width:auto;min-width:0;margin:0;padding:0;color:#afa0ba;background:transparent;font-size:22rpx;font-weight:400;line-height:1.5}.invite-stat-grid{display:grid;grid-template-columns:1fr 1fr;margin:20rpx 0 26rpx;gap:0}.invite-stat-grid>view{padding:18rpx 0;border-bottom:1rpx solid #f3eef6}.invite-stat-grid>view>text{font-size:23rpx;color:#a69aaf}.invite-stat-grid>view>view{font-size:33rpx;font-weight:650;margin-top:8rpx}.invite-stat-grid>view>view>text{font-size:22rpx;font-weight:400}.invite-highlight{color:#f28b4c}.page .invite-primary{width:100%;min-width:0;border-radius:40rpx;padding:18rpx;background:linear-gradient(100deg,#ffa653,#ff8750);color:white;line-height:1.5;font-size:28rpx;font-weight:600;box-shadow:0 6rpx 14rpx #ff995022}.invite-menu-card{display:grid;grid-template-columns:1fr 1fr;gap:28rpx 14rpx}.page .invite-menu-card button{display:flex;align-items:center;gap:16rpx;width:100%;min-width:0;background:transparent;padding:6rpx 0;text-align:left;line-height:1.6;border-radius:0;margin:0}.invite-menu-card image{width:43rpx;height:43rpx;flex-shrink:0}.invite-menu-card button>view{min-width:0}.invite-menu-card text{font-size:26rpx;color:#51425e}.invite-menu-card button>view>view{font-size:20rpx;color:#ada0b8}.invite-code{font-size:25rpx;color:#aa86c7;word-break:break-all;line-height:1.7;padding:20rpx 0}.invite-aux{display:flex;gap:16rpx;margin-top:16rpx}.page .invite-aux button{flex:1;width:0;min-width:0;padding:8rpx;font-size:22rpx;color:#a190b3;background:transparent;line-height:1.5}.invite-local-note{font-size:21rpx;color:#a99bb5;line-height:1.7;margin:20rpx 10rpx 30rpx}.invite-poster-card .poster{width:100%;height:auto}.invite-dashboard .config-row{padding:24rpx 0;border-bottom:1rpx solid #eee7f4}.invite-dashboard .empty{font-size:24rpx;padding:30rpx 0;color:#a79bb1}

.invite-hero-value{font-size:44rpx;font-weight:700;margin-top:8rpx}.invite-stat-cell{padding:18rpx 0;border-bottom:1rpx solid #f3eef6}.invite-stat-label{font-size:23rpx;color:#a69aaf}.invite-stat-value{font-size:33rpx;font-weight:650;margin-top:8rpx}.invite-stat-value text{font-size:22rpx;font-weight:400}.invite-menu-icon{width:43rpx;height:43rpx;flex-shrink:0}.invite-menu-copy{min-width:0}.invite-menu-caption{font-size:20rpx;color:#ada0b8}
