<import src="../../components/states.wxml"/><view class="page invite-dashboard"><template is="feedback" data="{{loading,error}}"/>
<view class="invite-header-bg"></view><view class="invite-profile-card"><view class="invite-profile-row"><image class="invite-avatar" src="/images/profile/avatar.png"/><view class="grow"><view class="invite-name">{{profile.nickname || '轻动伙伴'}}</view><view class="invite-tag">一起记录，一起改变</view></view><button class="invite-header-share" open-type="share">↗ 分享</button></view><view class="invite-hero-stats"><view><text>成功邀请（人）</text><view class="invite-hero-value">{{invite.records.length}}</view></view><view data-section="invite-rewards" bindtap="jump"><text>已领取奖励 ›</text><view class="invite-hero-value">{{rewards.length}}</view></view></view></view>
<view class="invite-summary-card"><view class="invite-card-heading"><text>我的邀请成果</text><button data-section="invite-rewards" bindtap="jump">领取记录 ›</button></view><view class="invite-stat-grid"><view class="invite-stat-cell"><text class="invite-stat-label">可领取档位</text><view class="invite-stat-value invite-highlight">{{claimableCount}} <text>档</text></view></view><view class="invite-stat-cell"><text class="invite-stat-label">已领取奖励</text><view class="invite-stat-value">{{rewards.length}} <text>份</text></view></view><view class="invite-stat-cell"><text class="invite-stat-label">成功邀请</text><view class="invite-stat-value">{{invite.records.length}} <text>人</text></view></view><view class="invite-stat-cell"><text class="invite-stat-label">邀请活动</text><view class="invite-stat-value">{{activities.length}} <text>场</text></view></view></view><button class="invite-primary" data-section="invite-activities" bindtap="jump">{{claimableCount?'查看可领取奖励':'查看邀请活动与奖励'}}</button></view>
<view class="invite-menu-card"><button data-section="invite-records" bindtap="jump"><image class="invite-menu-icon" src="/images/ui/book.svg"/><view class="invite-menu-copy"><text>我的邀请</text><view class="invite-menu-caption">{{invite.records.length}} 位好友已绑定</view></view></button><button data-section="invite-rewards" bindtap="jump"><image class="invite-menu-icon" src="/images/ui/gift.svg"/><view class="invite-menu-copy"><text>奖励记录</text><view class="invite-menu-caption">查看已领取的权益</view></view></button><button data-section="invite-activities" bindtap="jump"><image class="invite-menu-icon" src="/images/ui/rank.svg"/><view class="invite-menu-copy"><text>邀请活动</text><view class="invite-menu-caption">查看奖励档位</view></view></button><button bindtap="rules"><image class="invite-menu-icon" src="/images/ui/shield.svg"/><view class="invite-menu-copy"><text>邀请规则</text><view class="invite-menu-caption">了解绑定与领取说明</view></view></button><button bindtap="poster" disabled="{{busy}}"><image class="invite-menu-icon" src="/images/ui/gallery.svg"/><view class="invite-menu-copy"><text>邀请海报</text><view class="invite-menu-caption">生成专属分享图片</view></view></button><button bindtap="copy"><image class="invite-menu-icon" src="/images/ui/edit.svg"/><view class="invite-menu-copy"><text>复制邀请</text><view class="invite-menu-caption">发送路径与邀请码</view></view></button></view>
<view class="invite-code-card"><view class="invite-card-heading">我的专属邀请码</view><view class="invite-code">{{invite.code}}</view><button class="invite-primary" open-type="share">邀请微信好友一起</button><view class="invite-aux"><button bindtap="copy">复制邀请</button><button bindtap="preview">模拟访客注册</button></view></view>
<view class="invite-local-note">当前邀请绑定为本机演示，跨设备使用需接入服务端及微信登录。</view><canvas canvas-id="invitePoster" style="position:absolute;left:-9999px;width:300px;height:560px"/><view wx:if="{{poster}}" class="invite-poster-card"><image class="poster" src="{{poster}}" mode="widthFix"/><button class="invite-primary" bindtap="sharePoster" disabled="{{busy}}">分享邀请海报</button></view>
<view id="invite-activities" class="section-title section">邀请活动与奖励档位</view><view wx:if="{{!activities.length}}" class="card mt empty">当前暂无上架邀请活动，成功绑定记录仍会保留。</view><view wx:for="{{activities}}" wx:for-item="activity" wx:key="id" class="card mt"><view class="title">{{activity.title}}</view><view class="caption mt">{{activity.start}} — {{activity.end}} · 领取截止 {{activity.claimUntil}}</view><view class="caption mt">已成功邀请 {{activity.progress}} 人 · {{activity.claimMode === 'highest' ? '仅最高达标档位' : '可按各档位领取'}}</view><view wx:for="{{activity.tiers}}" wx:for-item="tier" wx:key="id" class="config-row"><view class="title">{{tier.name}} · 邀请{{tier.target}}人</view><view class="caption mt">{{tier.rewardName}} {{tier.rewardType === 'member' ? '· '+tier.snapshot.days+'天 · 每日'+tier.snapshot.dailyLimit+'次' : '· 实物/商品奖励'}}</view><view class="caption mt">剩余名额 {{tier.remaining}} · {{tier.status}}</view><button class="btn white mt" data-activity="{{activity.id}}" data-tier="{{tier.id}}" bindtap="claim" disabled="{{!tier.canClaim || busy}}">{{tier.canClaim ? '领取模拟奖励' : tier.status}}</button></view></view><view id="invite-records" class="card section"><view class="title"><image class="section-symbol" src="/images/ui/edit.svg"/>成功邀请记录</view><view wx:if="{{!invite.records.length}}" class="empty">暂无新用户绑定</view><view wx:for="{{invite.records}}" wx:key="id" class="config-row"><view>{{item.nickname}}</view><view class="caption mt">{{item.date}} · 首次注册已绑定</view></view></view><view id="invite-rewards" class="card section"><view class="title"><image class="section-symbol" src="/images/ui/edit.svg"/>邀请奖励领取记录</view><view wx:if="{{!rewards.length}}" class="empty">暂无邀请活动奖励</view><view wx:for="{{rewards}}" wx:key="id" class="config-row"><view>{{item.title}} · {{item.tierName}}</view><view class="caption mt">{{item.date}} · {{item.name}} · {{statusLabels[item.status] || item.status}}</view><view wx:if="{{item.rewardType === 'member'}}" class="caption mt">{{item.days}}天 · 权益已进入统一会员队列</view></view><button class="btn white mt" data-url="/pages/reward-ledger/index" bindtap="go"><image class="feature-entry-icon" src="/images/ui/sun.svg" mode="aspectFit"/><text>查看全部奖励记录</text></button></view><view wx:if="{{role === 'hq' || role === 'admin' || role === 'operator'}}" class="card section"><view class="title"><image class="section-symbol" src="/images/ui/flag.svg"/>统一邀请活动配置</view><view class="caption mt">邀请活动复用统一奖励池、档位、名额和领取规则，发布后本页立即显示。</view><button class="btn mt" data-url="/pages/reward-ops/index?type=invite" bindtap="go"><image class="feature-entry-icon" src="/images/ui/sun.svg" mode="aspectFit"/><text>管理邀请活动与奖励档位</text></button></view></view>