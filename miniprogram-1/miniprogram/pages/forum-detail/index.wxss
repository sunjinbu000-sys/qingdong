page{background:#fff}.detail-page{color:#293553;padding-bottom:calc(130rpx + env(safe-area-inset-bottom))}.detail-author{display:flex;align-items:center;gap:16rpx;padding:24rpx 28rpx}.detail-avatar{width:70rpx;height:70rpx;border-radius:50%;flex-shrink:0}.detail-author-name{flex:1;font-size:28rpx}.detail-page button{margin:0;min-width:0;width:auto;background:transparent;padding:0;line-height:1.5;border-radius:0;font-weight:400}.detail-page button:after{border:0}.detail-page .detail-follow{border:2rpx solid #a08bd0;border-radius:28rpx;color:#9075c8;padding:4rpx 23rpx;font-size:24rpx}.detail-page .detail-share{font-size:23rpx;color:#9281ad}.detail-page .detail-more{font-size:35rpx;color:#9281ad;padding:0 5rpx}.detail-post{padding:20rpx 28rpx 32rpx}.detail-title{font-size:34rpx;font-weight:650;margin-bottom:18rpx}.detail-text{white-space:pre-wrap;word-break:break-all;font-size:30rpx;line-height:1.85}.detail-meta{display:flex;flex-wrap:wrap;gap:18rpx;color:#a49aaf;font-size:23rpx;margin-top:24rpx}.detail-meta text{color:#9a7bc7}.detail-photo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8rpx;margin-top:20rpx}.detail-photo-grid image{width:100%;height:210rpx;border-radius:12rpx}.detail-photo-grid.single-photo{grid-template-columns:1fr}.detail-photo-grid.single-photo image{height:650rpx}.detail-video{width:100%;height:420rpx;margin-top:20rpx}.detail-comments{border-top:16rpx solid #f8f6fb;padding:28rpx}.detail-comments-title{font-size:29rpx;font-weight:650;margin-bottom:25rpx}.detail-comment{display:flex;gap:20rpx;padding:22rpx 0}.detail-comment-body{flex:1;min-width:0;border-bottom:1rpx solid #f1edf5;padding-bottom:24rpx}.detail-comment-author{font-size:25rpx;color:#9c91aa}.detail-comment-text{font-size:29rpx;line-height:1.7;white-space:pre-wrap;word-break:break-all;margin-top:7rpx}.detail-comment-meta{display:flex;align-items:center;gap:22rpx;color:#ada4b5;font-size:22rpx;margin-top:16rpx}.detail-page .detail-comment-meta button{font-size:23rpx;color:#9582aa}.detail-reply-label{font-size:22rpx;color:#aa98c2;margin-top:8rpx}.detail-empty{font-size:26rpx;color:#a99db5;text-align:center;padding:60rpx 0}.detail-toolbar{position:fixed;z-index:10;bottom:0;left:0;right:0;display:flex;align-items:center;gap:20rpx;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #ece7f1}.detail-page .detail-write{flex:1;background:#f6f3fa;border-radius:40rpx;color:#a69ab3;text-align:left;font-size:26rpx;padding:17rpx 25rpx}.detail-page .detail-tool{display:flex;flex-direction:column;align-items:center;justify-content:center;width:72rpx;flex-shrink:0;font-size:21rpx;color:#a397b0;gap:3rpx}.detail-tool image{width:40rpx;height:40rpx}.detail-star{font-size:44rpx;line-height:40rpx}.detail-tool.active{color:#8e6bc4}.composer-mask{position:fixed;inset:0;background:#0005;z-index:30}.comment-composer{position:fixed;left:0;right:0;z-index:31;background:#fff;border-radius:30rpx 30rpx 0 0;padding:24rpx 28rpx calc(20rpx + env(safe-area-inset-bottom))}.composer-heading{display:flex;justify-content:space-between;color:#857396;font-size:25rpx;margin-bottom:18rpx}.detail-page .composer-heading button{font-size:24rpx;color:#a697b6}.composer-input{box-sizing:border-box;width:100%;height:180rpx;border-radius:25rpx;background:#f7f5fa;padding:22rpx;font-size:29rpx;line-height:1.6}.composer-options{display:flex;align-items:center;gap:18rpx;margin-top:18rpx;color:#a294af;font-size:22rpx}.composer-anonymous{display:flex;align-items:center;flex:1;gap:8rpx}.composer-anonymous switch{transform:scale(.7);transform-origin:left center;width:80rpx}.detail-page .composer-send{border-radius:32rpx;background:#967bcf;color:white;padding:10rpx 32rpx;font-size:27rpx}.detail-page .composer-send[disabled]{background:#eae3f3;color:#bcaed0}.composer-emojis{display:flex;justify-content:space-between;font-size:40rpx;margin-top:22rpx}.composer-reply{font-size:23rpx;color:#9b83bd;margin-bottom:12rpx}.detail-error{padding:30rpx}
