<view class="page"><view wx:if="{{error}}" class="card">{{error}}<button bindtap="retry">重试</button></view><view wx:if="{{post}}" class="card"><view class="title">{{post.title||post.kind}}</view><button wx:if="{{!post.anonymous}}" data-url="/pages/public-profile/index?userId={{post.userId}}" bindtap="go">{{post.author}}的主页</button><view>{{statusLabels[post.status] || post.status}} · {{post.date}}</view><view>{{post.text}}</view><image wx:for="{{post.images}}" wx:key="*this" src="{{item}}"/><video wx:if="{{post.video}}" class="forum-video" src="{{post.video}}" controls/><block wx:if="{{post.mine}}"><button data-url="/pages/forum-editor/index?id={{post.id}}" bindtap="go"><image class="feature-entry-icon" src="/images/ui/sun.svg" mode="aspectFit"/><text>编辑 / 重新送审</text></button><button data-method="withdrawForumPost" bindtap="act">撤回</button><button data-method="deleteForumPost" bindtap="act">删除</button></block><block wx:if="{{post.status === 'approved'}}"><button data-method="likeForumPost" bindtap="act">{{post.liked?'取消赞':'赞'}} {{post.likeCount}}</button><button data-method="favoriteForumPost" bindtap="act">{{post.favorited?'取消收藏':'收藏'}}</button><view wx:if="{{parentId}}">正在回复所选评论</view><view>匿名评论 / 回复 <switch checked="{{anonymousComment}}" bindchange="commentAnonymous"/></view><input data-key="comment" bindinput="input" placeholder="评论（最多500字）"/><button data-method="commentForumPost" bindtap="act">发表评论</button><input data-key="reason" bindinput="input" placeholder="举报原因"/><button data-method="reportForumPost" bindtap="act">举报</button></block><view wx:for="{{post.comments}}" wx:key="id"><text data-user="{{item.userId}}" data-anonymous="{{item.anonymous}}" bindtap="commentAuthor">{{item.author||item.nickname}}</text>：{{item.text}}<button data-id="{{item.id}}" bindtap="reply">回复</button><button wx:if="{{item.mine}}" data-id="{{item.id}}" bindtap="deleteComment">删除本人评论</button></view><view wx:for="{{post.audit}}" wx:key="index">{{item.date}} {{item.note}}</view></view></view>