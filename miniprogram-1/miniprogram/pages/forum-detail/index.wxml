<view class="detail-page {{post.mine?'own-post-detail':''}} qd-theme qd-social">
<view wx:if="{{error}}" class="detail-error">{{error}}<button bindtap="retry">重试</button></view>
<block wx:if="{{post}}">
<view class="detail-author"><image class="detail-avatar" src="/images/profile/avatar.png" data-user="{{post.userId}}" data-anonymous="{{post.anonymous}}" bindtap="commentAuthor"/><text class="detail-author-name" data-user="{{post.userId}}" data-anonymous="{{post.anonymous}}" bindtap="commentAuthor">{{post.author}}</text><button wx:if="{{!post.anonymous && !post.mine && post.status==='approved'}}" class="detail-follow" bindtap="follow" disabled="{{busy}}">{{post.following?'已关注':'关注'}}</button><button wx:if="{{post.status==='approved'}}" class="detail-share" open-type="share">分享</button><button class="detail-more" bindtap="more">⋯</button></view>
<view wx:if="{{post.mine && post.images.length}}" class="own-gallery"><swiper current="{{imageIndex||0}}" bindchange="imageChanged" style="height:{{galleryHeight||840}}rpx" class="own-gallery-swiper"><swiper-item wx:for="{{post.images}}" wx:key="*this"><image class="own-gallery-image" src="{{item}}" mode="aspectFit" data-index="{{index}}" bindload="imageLoaded" data-path="{{item}}" bindtap="previewImages"/></swiper-item></swiper><text class="own-gallery-count">{{(imageIndex||0)+1}}/{{post.images.length}}</text></view><video wx:if="{{post.mine && post.video}}" class="own-detail-video" src="{{post.video}}" controls/>
<view class="detail-post"><view wx:if="{{post.title}}" class="detail-title">{{post.title}}</view><view class="detail-text">{{post.text}}</view><view wx:if="{{!post.mine}}" class="detail-photo-grid {{post.images.length===1?'single-photo':''}}"><image wx:for="{{post.images}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-path="{{item}}" bindtap="previewImages"/></view><video wx:if="{{!post.mine && post.video}}" class="detail-video" src="{{post.video}}" controls/><view wx:if="{{!post.mine}}" class="detail-meta">{{post.date}} · {{post.city}}<text>#{{post.kind}}</text></view><view wx:else class="own-publication"><text>发布于 {{publishedAt}}</text><view class="own-post-actions"><button wx:if="{{post.status==='approved'}}" bindtap="reportPost">ⓘ 投诉</button><button bindtap="deleteOwnPost" disabled="{{busy}}">删除</button></view></view></view>
<view class="detail-comments" id="comments"><view class="detail-comments-title">{{post.mine?"评论区（"+post.comments.length+"）":"共 "+post.comments.length+" 条评论"}}</view><button wx:if="{{post.mine && post.status==='approved'}}" class="own-comment-entry" bindtap="openComposer">说点什么吧…</button><view wx:if="{{!post.comments.length}}" class="detail-empty">还没有评论，来聊聊你的想法吧</view><view wx:for="{{post.comments}}" wx:key="id" class="detail-comment"><image class="detail-avatar" src="/images/profile/avatar.png" data-user="{{item.userId}}" data-anonymous="{{item.anonymous}}" bindtap="commentAuthor"/><view class="detail-comment-body"><view class="detail-comment-author" data-user="{{item.userId}}" data-anonymous="{{item.anonymous}}" bindtap="commentAuthor">{{item.author||item.nickname}}</view><view wx:if="{{item.parentId}}" class="detail-reply-label">回复评论</view><view class="detail-comment-text">{{item.text}}</view><view class="detail-comment-meta"><text>{{item.date}}</text><button wx:if="{{post.status==='approved'}}" data-id="{{item.id}}" data-author="{{item.author}}" bindtap="reply">回复</button><button wx:if="{{item.mine}}" data-id="{{item.id}}" bindtap="deleteComment" disabled="{{busy}}">删除</button></view></view></view></view>
<view wx:if="{{post.status==='approved'}}" class="detail-toolbar"><button class="detail-write" bindtap="openComposer">✎ 说点什么…</button><button class="detail-tool {{post.liked?'active':''}}" data-method="likeForumPost" bindtap="act" disabled="{{busy}}"><image src="/images/ui/heart.svg"/><text>{{post.likeCount}}</text></button><button class="detail-tool {{post.favorited?'active':''}}" data-method="favoriteForumPost" bindtap="act" disabled="{{busy}}"><text class="detail-star">{{post.favorited?'★':'☆'}}</text><text>{{post.mine?post.favoriteCount:(post.favorited?'已收藏':'收藏')}}</text></button><button class="detail-tool" bindtap="openComposer"><image src="/images/ui/comment.svg"/><text>{{post.comments.length}}</text></button></view>
<button wx:if="{{post.mine && post.status==='approved'}}" class="own-share-float" open-type="share">↗ 分享</button></block>
<view wx:if="{{composerOpen}}" class="composer-mask" bindtap="closeComposer" catchtouchmove="preventMove"></view><view wx:if="{{composerOpen}}" class="comment-composer" style="bottom:{{keyboardHeight}}px" catchtap="preventMove" catchtouchmove="preventMove"><view class="composer-heading"><text>{{parentId?'回复 '+replyAuthor:'发表评论'}}</text><button bindtap="closeComposer">收起</button></view><view wx:if="{{parentId}}" class="composer-reply" bindtap="cancelReply">取消回复 ×</view><textarea class="composer-input" value="{{comment}}" data-key="comment" bindinput="input" placeholder="友善评论，文明发言" maxlength="500" focus="{{inputFocus}}" adjust-position="{{false}}" show-confirm-bar="{{false}}" bindkeyboardheightchange="keyboardChange"/><view class="composer-options"><view class="composer-anonymous"><text>匿名评论</text><switch checked="{{anonymousComment}}" bindchange="commentAnonymous" color="#9680c8"/></view><text>{{comment.length}}/500</text><button class="composer-send" data-method="commentForumPost" bindtap="act" disabled="{{busy || !comment}}" loading="{{busy}}">发送</button></view><view class="composer-emojis"><text wx:for="{{emojis}}" wx:key="*this" data-emoji="{{item}}" bindtap="addEmoji">{{item}}</text></view></view>
</view>