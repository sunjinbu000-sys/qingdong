.quota-bar{background:#edf2e5;border-radius:22rpx;padding:22rpx 26rpx}.quota-number{font-size:48rpx;color:#1d6651;font-weight:600;line-height:1.4}.photo-card{padding:24rpx}.camera-zone{text-align:center;padding:40rpx 10rpx 25rpx;display:flex;align-items:center;flex-direction:column}.camera-circle{height:150rpx;width:150rpx;border-radius:50%;background:#edf3df;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 18rpx #f7f9f1}.camera-circle image{width:76rpx;height:76rpx}.camera-zone .title{margin-top:38rpx}.food-preview{width:100%;height:390rpx;border-radius:20rpx}.result-card{border-color:#dce6cf}.result-energy{margin:18rpx 0;color:#1d6651}.result-energy>text:first-child{font-size:72rpx;font-family:Georgia,serif}.nutrition{padding:20rpx 0;border-top:1rpx solid #e8eddf;border-bottom:1rpx solid #e8eddf}.nutrition .number{font-size:34rpx}.photo-flow{display:flex;align-items:center;justify-content:space-between;font-size:21rpx;color:#8fa180}.photo-flow>view{display:flex;flex-direction:column;align-items:center;gap:6rpx}.flow-no{font:24rpx Georgia;color:#587b4c}
