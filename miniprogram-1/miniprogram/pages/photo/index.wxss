page{color:#333958}.capture-page{padding:16rpx 18rpx 28rpx}.capture-heading{font-size:43rpx;font-weight:700;line-height:1.4}.capture-subtitle{font-size:24rpx;color:#8984a0;margin-top:10rpx;margin-bottom:38rpx}.capture-stage{height:52vh;min-height:540rpx;max-height:720rpx;width:100%;position:relative;overflow:hidden;border-radius:54rpx;background:#c6bdb3}.live-camera,.captured-image{position:absolute;inset:0;width:100%;height:100%;border-radius:54rpx}.camera-viewfinder{position:absolute;left:65rpx;right:65rpx;top:58rpx;bottom:110rpx;border:4rpx solid #fffffff0;border-radius:48rpx;background:transparent;overflow:visible}.frame-accent{position:absolute;top:-4rpx;height:6rpx;width:105rpx;background:#b6efda}.frame-accent-left{left:50rpx}.frame-accent-right{right:50rpx}.camera-hint{position:absolute;left:20rpx;right:20rpx;bottom:34rpx;background:transparent;text-align:center;color:#fff;font-size:23rpx;line-height:1.5}.preview-hint{position:absolute;left:0;right:0;bottom:0;padding:28rpx 12rpx;background:#35313c70;color:#fff;font-size:23rpx;text-align:center}.camera-fallback{position:absolute;inset:0;background:#e6e1ed;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22rpx;padding:50rpx;text-align:center;color:#847795;font-size:25rpx}.camera-fallback image{width:90rpx;height:90rpx;opacity:.5}.camera-fallback .fallback-button{width:auto;min-width:0;font-size:23rpx;background:#f7f4ff;color:#76639d;padding:12rpx 24rpx}.meal-tabs{display:flex;gap:15rpx;margin:28rpx 0 22rpx}.meal-tabs .meal-tab{width:auto;min-width:0;background:#fff;border:1rpx solid transparent;border-radius:42rpx;color:#8b7c9b;font-size:24rpx;line-height:1.5;padding:16rpx 30rpx}.meal-tabs .active-meal{background:#ede7ff;border-color:#b79fff;color:#7454c5}.meal-tabs button[disabled]{opacity:1}.capture-controls{display:flex;align-items:center;justify-content:space-around;padding:16rpx 12rpx 8rpx}.capture-controls .side-action{width:150rpx;min-width:0;padding:0;display:flex;align-items:center;flex-direction:column;gap:10rpx;background:transparent;color:#8b78a5;font-size:23rpx;line-height:1.5}.side-action image{width:43rpx;height:43rpx}.capture-controls .shutter-button{width:144rpx;height:144rpx;min-width:0;padding:8rpx;display:flex;align-items:center;justify-content:center;border:8rpx solid #ac97ee;border-radius:50%;background:#fff;line-height:1}.shutter-core{width:100%;height:100%;border-radius:50%;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#a98ce9,#8a6ddc)}.shutter-core image{width:62rpx;height:62rpx}.capture-controls .shutter-button[disabled]{opacity:.55}.camera-privacy{text-align:center;color:#a89cb8;font-size:22rpx;margin-top:28rpx}.capture-status{text-align:center;font-size:19rpx;color:#a99db8;margin-top:12rpx}.capture-page .access-toggle{width:auto;min-width:0;margin:14rpx auto 0;background:transparent;color:#9d8aae;font-size:21rpx;padding:6rpx 16rpx}.capture-error{padding:18rpx 22rpx;border-radius:18rpx;background:#f6ebed;color:#a46579;font-size:24rpx;margin-top:20rpx}.capture-error .retry-photo{width:auto;min-width:0;margin-top:12rpx;color:#8f6cc2;background:#fff;font-size:24rpx}.capture-access .quota-bar{background:#f0eafa;border-radius:22rpx;padding:22rpx 26rpx}.quota-number{font-size:48rpx;color:#8263c3;font-weight:600}.result-card{border-color:#e4daef}.result-energy{margin:18rpx 0;color:#8263c3}.result-energy>text:first-child{font-size:72rpx;font-family:Georgia,serif}.nutrition{padding:20rpx 0;border-top:1rpx solid #eee7f4;border-bottom:1rpx solid #eee7f4}.nutrition .number{font-size:34rpx}

