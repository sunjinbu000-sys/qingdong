<import src="../../components/states.wxml"/>
<view class="page capture-page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><block wx:if="{{screen!=='access'}}"><view class="capture-heading">把这一餐，装进日记</view><view class="capture-subtitle">拍好餐食照片，再确认识别这一餐。</view><view class="capture-stage"><image wx:if="{{preview}}" class="captured-image" src="{{preview}}" mode="aspectFit" bindtap="previewPhoto"/><view wx:else class="capture-placeholder" bindtap="capture"><image class="capture-placeholder-icon" src="/images/ui/camera.svg"/><view>点击下方圆圈，打开全屏相机</view></view><view class="camera-viewfinder"><view class="frame-accent frame-accent-left"></view><view class="frame-accent frame-accent-right"></view></view><view class="preview-hint">{{preview ? '已选择餐食照片' : '让餐食完整入镜，光线充足更好识别'}}</view></view>
<view class="meal-tabs"><button wx:for="{{mealSlots}}" wx:key="id" class="meal-tab {{selectedSlot===item.id?'active-meal':''}}" data-slot="{{item.id}}" bindtap="selectSlot" disabled="{{busy || !!preview}}">{{item.label}}</button></view><view class="capture-controls"><button class="side-action" bindtap="choose" disabled="{{busy}}"><image class="side-action-icon" src="/images/ui/gallery.svg"/><text>相册选图</text></button><button class="shutter-button" hover-class="none" bindtap="capture" disabled="{{busy}}" aria-label="拍照"><view class="shutter-core"><image class="shutter-icon" src="/images/home/camera-white.svg"/></view></button><button class="side-action" bindtap="manualRecord" disabled="{{busy}}"><image class="side-action-icon" src="/images/ui/edit.svg"/><text>手动记录</text></button></view>
<button wx:if="{{preview && !result}}" class="photo-confirm" bindtap="confirmPhoto" disabled="{{busy}}">{{busy ? '正在处理这一餐…' : '选好啦，帮我看看这一餐'}}</button><view wx:if="{{photoError}}" class="capture-error">{{photoError}}</view><view class="camera-privacy">图片仅保存在本机，分享由你决定。</view><view class="capture-status">当前为模拟识餐，尚未上传至真实识别服务。</view>
<view wx:if="{{result}}" class="card section result-card"><view class="row"><text class="section-title">这一餐，已经记好</text><text class="pill">模拟结果</text></view><view class="title mt">{{result.name}}</view><view class="result-energy"><text>{{result.kcal}}</text><text class="unit">kcal · 估算热量</text></view><view class="grid3 nutrition"><view><text class="number">{{result.protein}}<text class="unit">g</text></text><text class="caption">蛋白质</text></view><view><text class="number">{{result.carbohydrate}}<text class="unit">g</text></text><text class="caption">碳水化合物</text></view><view><text class="number">{{result.fat}}<text class="unit">g</text></text><text class="caption">脂肪</text></view></view><view class="notice mt">已归入 {{result.date}} · {{slotLabel}}。以上营养为固定模拟值，不代表照片中的真实营养。{{result.corrected ? "名称与热量已手动调整，宏量营养仍为演示值。" : ""}}</view><view class="card mt"><view class="title">核对并手动调整（不重复扣次）</view><input value="{{editName}}" data-key="editName" bindinput="editInput" placeholder="餐食名称"/><input type="digit" value="{{editKcal}}" data-key="editKcal" bindinput="editInput" placeholder="热量kcal"/><button class="btn white mt" bindtap="correctMeal">保存调整</button><button class="btn white mt" bindtap="deleteMeal">删除本次餐食记录（不返额度）</button></view><button class="btn soft mt" data-url="/pages/health/index?date={{result.date}}" bindtap="go">去日记看看这一餐 ↗</button></view>
</block><block wx:else><view class="photo-access-heading"><image class="photo-access-icon" src="/images/profile/avatar.png"/><view><view class="capture-heading">吃得明明白白</view><view class="capture-subtitle">没有直接识别额度时，完整观看视频可获得识别机会</view></view></view><view class="photo-access-summary"><view class="photo-access-stats"><view><text>今日已识别</text><view class="photo-access-number">{{access.todayUsed || 0}}<text> 次</text></view></view><view><text>当前剩余识别</text><view class="photo-access-number">{{access.remaining || 0}}<text> 次</text></view></view></view><view class="photo-access-line"><text>每日最多观看激励视频</text><text>{{access.adDailyLimit || 0}} 次</text></view><view class="photo-access-line"><text>会员每日识餐额度</text><text>以会员套餐为准</text></view><view class="photo-access-note">视频次数按北京时间每日重置；免费与广告奖励按现有权益规则使用。</view></view>
<view class="photo-video-card"><view class="photo-access-title">看一段视频，识别这一餐</view><view class="photo-access-note">完整观看后获得次数，继续识别刚才选择的照片</view><button class="photo-confirm" bindtap="watchAndRecognize" disabled="{{busy}}">{{busy ? '处理中，请稍候…' : access.remaining > 0 ? '使用当前额度识别' : '观看视频并识别'}}</button><view class="photo-access-note">中途关闭不发放机会；加载失败可重试</view><view wx:if="{{!access.adsAvailable}}" class="photo-access-note">视频尚未开放或今日次数已用完</view></view><view class="photo-member-card"><view class="photo-access-title">轻盈会员，拍完就能识别</view><view class="photo-access-note">查看免广告套餐与会员权益</view><button class="photo-member-link" data-url="/pages/membership/index" bindtap="go">了解免广告会员</button></view><button class="photo-back" bindtap="backToCapture">返回照片预览</button></block></block></view>
