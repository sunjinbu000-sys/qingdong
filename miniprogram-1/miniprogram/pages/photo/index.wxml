<import src="../../components/states.wxml"/>
<view class="page capture-page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><block wx:if="{{screen==='capture'}}"><view class="capture-heading">把这一餐，装进日记</view><view class="capture-subtitle">拍好餐食照片，再确认识别这一餐。</view><view class="capture-stage"><image wx:if="{{preview}}" class="captured-image" src="{{preview}}" mode="aspectFit" bindtap="previewPhoto"/><view wx:else class="capture-placeholder" bindtap="capture"><image class="capture-placeholder-icon" src="/images/ui/camera.svg"/><view>点击下方圆圈，打开全屏相机</view></view><view class="camera-viewfinder"><view class="frame-accent frame-accent-left"></view><view class="frame-accent frame-accent-right"></view></view><view class="preview-hint">{{preview ? '已选择餐食照片' : '让餐食完整入镜，光线充足更好识别'}}</view></view>
<view class="meal-tabs"><button wx:for="{{mealSlots}}" wx:key="id" class="meal-tab {{selectedSlot===item.id?'active-meal':''}}" data-slot="{{item.id}}" bindtap="selectSlot" disabled="{{busy || !!preview}}">{{item.label}}</button></view><view class="capture-controls"><button class="side-action" bindtap="choose" disabled="{{busy}}"><image class="side-action-icon" src="/images/ui/gallery.svg"/><text>相册选图</text></button><button class="shutter-button" hover-class="none" bindtap="capture" disabled="{{busy}}" aria-label="拍照"><view class="shutter-core"><image class="shutter-icon" src="/images/home/camera-white.svg"/></view></button><button class="side-action" bindtap="manualRecord" disabled="{{busy}}"><image class="side-action-icon" src="/images/ui/edit.svg"/><text>手动记录</text></button></view>
<checkbox-group wx:if="{{access.mock && preview && !result}}" bindchange="toggleMockScenario"><label class="photo-demo-choice"><checkbox value="meal" checked="{{mockScenario==='meal'}}" color="#9276d8"/><text>使用餐食样例演示成功页（未分析当前照片）</text></label></checkbox-group><button wx:if="{{preview && !result}}" class="photo-confirm" bindtap="confirmPhoto" disabled="{{busy}}">{{busy ? '正在处理这一餐…' : '选好啦，帮我看看这一餐'}}</button><view wx:if="{{photoError}}" class="capture-error">{{photoError}}</view><view class="camera-privacy">图片仅保存在本机，分享由你决定。</view><view class="capture-status">当前为模拟识餐，尚未上传至真实识别服务。</view>
</block><block wx:elif="{{screen==='scanning'}}"><view class="analysis-scan-frame"><image class="analysis-scan-image" src="{{preview}}" mode="aspectFit"/><view class="analysis-scan-border"><view class="analysis-scan-line"></view></view><view class="analysis-scan-status">●　{{access.mock ? '正在展示本地演示分析' : '正在等待分析结果'}}</view></view><view class="analysis-scan-title">正在读懂这一餐</view><view class="analysis-scan-subtitle">份量与营养值为估算，完成后可逐项核对</view><view class="analysis-card"><view class="analysis-stage"><text class="analysis-stage-number">✓</text><view><view>照片已接收</view><text class="analysis-muted">已保存到本次餐食草稿</text></view></view><view class="analysis-stage"><text class="analysis-stage-number">2</text><view><view>识别食物与份量</view><text class="analysis-muted">{{access.mock ? '本地演示响应处理中，未调用真实模型' : '等待识别结果'}}</text></view></view><view class="analysis-stage"><text class="analysis-stage-number">3</text><view><view>汇总营养与后续搭配</view><text class="analysis-muted">完成后生成报告，暂不写入日记</text></view></view></view></block><block wx:elif="{{screen==='result' && result}}">
<view class="analysis-photo"><image class="analysis-result-image" src="{{preview}}" mode="aspectFit" bindtap="previewPhoto"/><text class="analysis-photo-label">{{slotLabel}} · {{result.date}}</text></view><view class="analysis-result-header"><view class="analysis-result-title">{{result.name}}</view><button class="analysis-text-button" bindtap="generateReportPoster">生成海报</button></view><view class="analysis-result-subtitle">{{result.mock ? '本地演示 · 未分析当前照片 · 可手动修正' : '视觉识别 · 营养估算 · 可手动修正'}}</view><button class="analysis-correct-link" bindtap="adjustPortions">修正 ✎</button>
<view class="analysis-card"><view class="analysis-muted">本餐估算热量 <text class="analysis-reference">仅供参考</text></view><view class="analysis-calories">{{result.recognized ? result.kcal : '未知'}}<text class="analysis-calorie-unit">千卡</text></view><view class="analysis-muted">{{result.recognized ? '份量变化示例范围 ' + result.range + ' 千卡（非置信区间）' : '未识别热量不按0处理'}}</view><view class="analysis-macros"><view class="analysis-macro protein"><view class="analysis-macro-number">{{result.recognized ? result.protein : '未知'}}<text class="analysis-macro-unit"> g</text></view><text>蛋白质{{result.pfc ? ' · '+result.pfc[0]+'%' : ''}}</text></view><view class="analysis-macro carb"><view class="analysis-macro-number">{{result.recognized ? result.carbohydrate : '未知'}}<text class="analysis-macro-unit"> g</text></view><text>碳水{{result.pfc ? ' · '+result.pfc[1]+'%' : ''}}</text></view><view class="analysis-macro fat"><view class="analysis-macro-number">{{result.recognized ? result.fat : '未知'}}<text class="analysis-macro-unit"> g</text></view><text>脂肪{{result.pfc ? ' · '+result.pfc[2]+'%' : ''}}</text></view></view><view wx:if="{{result.pfc}}" class="analysis-pfc-bar"><view class="protein-bar" style="width:{{result.pfc[0]}}%"></view><view class="carb-bar" style="width:{{result.pfc[1]}}%"></view><view class="fat-bar" style="width:{{result.pfc[2]}}%"></view></view><view class="analysis-muted">{{result.pfc ? 'PFC 占比按4/4/9千卡每克估算' : '营养数据不完整，暂不计算供能比例'}}</view></view>
<view class="analysis-card"><view class="analysis-section-title">食材与份量</view><view class="analysis-muted">{{result.recognized ? '样例估算值，请核对实际食用量' : '尚未确认任何食材与份量'}}</view><view wx:for="{{result.ingredients}}" wx:key="name" class="analysis-food-row"><view><view class="analysis-food-name">{{item.name}}</view><text class="analysis-muted">{{item.grams}} g</text></view><text class="analysis-muted">{{item.kcal}} 千卡</text></view><view wx:if="{{!result.recognized}}" class="analysis-food-row"><view>未识别食物</view><text class="analysis-muted">未知 千卡</text></view></view>
<view wx:if="{{showPortions && result.recognized}}" class="analysis-card analysis-edit-card"><view class="analysis-section-title">核对与调整份量</view><input class="analysis-name-input" value="{{editName}}" data-key="editName" bindinput="editInput"/><view wx:for="{{result.ingredients}}" wx:key="name" class="analysis-portion-row"><text>{{item.name}}</text><input class="analysis-portion-input" type="digit" value="{{portionInputs[index]}}" data-index="{{index}}" bindinput="portionInput"/><text>克</text></view><button class="photo-confirm" bindtap="correctMeal" disabled="{{busy}}">更新份量与营养估算</button></view>
<view class="analysis-card"><view class="analysis-section-title">这一餐的分析</view><view class="analysis-section"><view class="analysis-section-subtitle">识别描述</view><view>{{result.description}}</view></view><view class="analysis-section"><view class="analysis-section-subtitle">PFC 结构</view><view>{{result.pfcDescription}}</view></view><view class="analysis-section"><view class="analysis-section-subtitle">营养观察</view><view>{{result.observation}}</view></view><view class="analysis-section"><view class="analysis-section-subtitle">进餐建议</view><view>{{result.suggestion}}</view></view></view>
<view class="analysis-card"><view class="analysis-section-title">次日三餐建议 · {{suggestions.date}}</view><view class="analysis-muted">{{suggestions.notice}}</view><scroll-view scroll-x class="report-meals-scroll"><view class="report-meals-row"><view wx:for="{{suggestions.meals}}" wx:key="slot" class="report-meal-card"><text class="analysis-reference">{{item.slot==='breakfast'?'早餐':item.slot==='lunch'?'午餐':'晚餐'}}</text><view class="analysis-food-name mt">{{item.title}}</view><view class="analysis-muted">{{item.styleLabel || '参考搭配'}} · {{item.kcal}} 千卡（模拟）</view><view wx:for="{{item.ingredients}}" wx:for-item="food" wx:key="name" class="analysis-muted">{{food.name}} {{food.grams}}g</view><view wx:for="{{item.steps}}" wx:for-item="step" wx:key="*this" class="analysis-muted">{{step}}</view></view></view></scroll-view><button class="analysis-plan-link" data-url="/pages/ai-plan/index" bindtap="go">打开轻动计划，调整三餐 ›</button></view>
<view class="analysis-footer-actions"><button class="analysis-secondary" bindtap="adjustPortions">{{result.recognized ? '调整份量' : '手动记餐'}}</button><button class="photo-confirm" bindtap="saveAnalysis" disabled="{{busy || !result.recognized}}">{{result.recordId ? '已保存，查看日记' : '保存这一餐'}}</button></view><button wx:if="{{result.recordId}}" class="analysis-plan-link" bindtap="deleteMeal" disabled="{{busy}}">删除已保存的餐食记录（不返额度）</button><button class="analysis-plan-link" bindtap="newPhoto" disabled="{{busy}}">重新拍照</button><view class="analysis-disclaimer">照片估算不能替代营养检测或专业诊疗建议。未确认餐食不会自动写入日记。</view><canvas canvas-id="mealReportPoster" class="meal-report-canvas"></canvas>
</block><block wx:else><view class="photo-access-heading"><image class="photo-access-icon" src="/images/profile/avatar.png"/><view><view class="capture-heading">吃得明明白白</view><view class="capture-subtitle">没有直接识别额度时，完整观看视频可获得识别机会</view></view></view><view class="photo-access-summary"><view class="photo-access-stats"><view><text>今日已识别</text><view class="photo-access-number">{{access.todayUsed || 0}}<text> 次</text></view></view><view><text>当前剩余识别</text><view class="photo-access-number">{{access.remaining || 0}}<text> 次</text></view></view></view><view class="photo-access-line"><text>每日最多观看激励视频</text><text>{{access.adDailyLimit || 0}} 次</text></view><view class="photo-access-line"><text>会员每日识餐额度</text><text>以会员套餐为准</text></view><view class="photo-access-note">视频次数按北京时间每日重置；免费与广告奖励按现有权益规则使用。</view></view>
<view class="photo-video-card"><view class="photo-access-title">看一段视频，识别这一餐</view><view class="photo-access-note">完整观看后获得次数，继续识别刚才选择的照片</view><button class="photo-confirm" bindtap="watchAndRecognize" disabled="{{busy}}">{{busy ? '处理中，请稍候…' : access.remaining > 0 ? '使用当前额度识别' : '观看视频并识别'}}</button><view class="photo-access-note">中途关闭不发放机会；加载失败可重试</view><view wx:if="{{!access.adsAvailable}}" class="photo-access-note">视频尚未开放或今日次数已用完</view></view><view class="photo-member-card"><view class="photo-access-title">轻盈会员，拍完就能识别</view><view class="photo-access-note">查看免广告套餐与会员权益</view><button class="photo-member-link" data-url="/pages/membership/index" bindtap="go">了解免广告会员</button></view><button class="photo-back" bindtap="backToCapture">返回照片预览</button></block></block></view>
