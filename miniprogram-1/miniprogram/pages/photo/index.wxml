<import src="../../components/states.wxml"/>
<view class="page capture-page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}">
  <view class="capture-heading">把这一餐，装进日记</view><view class="capture-subtitle">让餐食完整入镜，光线充足会更好识别。</view>
  <view class="capture-stage">
    <camera wx:if="{{!preview && cameraActive}}" class="live-camera" mode="normal" device-position="back" flash="off" bindinitdone="onCameraReady" binderror="onCameraError" bindstop="onCameraStop"></camera>
    <image wx:if="{{preview}}" class="captured-image" src="{{preview}}" mode="aspectFill" bindtap="previewPhoto"/>
    <view wx:if="{{!preview && !cameraActive}}" class="camera-fallback"><image src="/images/ui/camera.svg"/><view>{{cameraError}}</view><button class="fallback-button" bindtap="restartCamera">重新打开相机</button><button class="fallback-button" bindtap="cameraSettings">检查相机权限</button></view>
    <cover-view wx:if="{{!preview && cameraActive}}" class="camera-viewfinder"><cover-view class="frame-accent frame-accent-left"></cover-view><cover-view class="frame-accent frame-accent-right"></cover-view></cover-view>
    <cover-view wx:if="{{!preview && cameraActive}}" class="camera-hint">{{cameraReady?'点击下方圆圈拍照':'正在打开相机…'}}</cover-view>
    <view wx:if="{{preview}}" class="preview-hint">{{busy?'正在保存这一餐…':'照片已拍好，可查看识别结果或再拍一餐'}}</view>
  </view>
  <view class="meal-tabs"><button wx:for="{{mealSlots}}" wx:key="id" class="meal-tab {{selectedSlot===item.id?'active-meal':''}}" data-slot="{{item.id}}" bindtap="selectSlot" disabled="{{busy || !!preview}}">{{item.label}}</button></view>
  <view wx:if="{{photoError}}" class="capture-error"><view>{{photoError}}</view><button wx:if="{{preview}}" class="retry-photo" bindtap="retryRecognition" disabled="{{busy}}">{{needsAccount?'登录后识别保存':'识别并保存'}}</button></view>
  <view class="capture-controls">
    <button class="side-action" bindtap="choose" disabled="{{busy}}"><image class="side-action-icon" src="/images/ui/gallery.svg"/><text>相册选图</text></button>
    <button class="shutter-button" bindtap="capture" disabled="{{busy || (!preview && !cameraReady)}}" loading="{{busy}}" aria-label="{{preview?'再拍一餐':'拍照'}}"><view class="shutter-core"><image class="shutter-icon" src="/images/home/camera-white.svg"/></view></button>
    <button class="side-action" bindtap="manualRecord" disabled="{{busy}}"><image class="side-action-icon" src="/images/ui/edit.svg"/><text>手动记录</text></button>
  </view>
  <view class="camera-privacy">图片仅保存在本机，分享由你决定。</view>
  <view class="capture-status">{{preview?'点击中间圆圈可再拍一餐。':'当前仅生成固定模拟样例，暂不分析照片内容。'}}</view>
  <button class="access-toggle" bindtap="toggleAccess">{{showAccess?'收起次数与权益':'查看识餐次数与权益'}} ⌄</button>
  <view wx:if="{{showAccess}}" class="capture-access"><view class="quota-bar mt"><view class="row"><view><text class="label">今日模拟识餐额度</text><view class="quota-number">{{access.remaining}}<text class="unit">/ {{membership.dailyLimit + access.freeCredits + access.adCredits}} 次剩余</text></view></view><button class="link" data-url="{{signedIn ? '/pages/membership/index' : '/pages/account/index'}}" bindtap="go">{{signedIn ? '查看权益 ›' : '先登录 ›'}}</button></view></view>
<view wx:if="{{adPlacement.enabled}}" class="notice section">本地模拟广告占位 · 识餐Banner · {{adPlacement.unitId}}（未请求真实广告）</view><view class="card section"><view class="title">共享次数</view><view class="caption mt">会员剩余{{access.membershipRemaining}}次 · 免费{{access.freeCredits}}次 · 广告奖励{{access.adCredits}}次</view><view class="caption mt">{{access.requiresCredit ? "本会员含广告：使用会员日额度时还需消耗1次免费或广告永久额度。" : access.membershipRemaining ? "免广告会员每日额度可直接使用。" : "当前使用免费或广告永久次数。"}} 全局今日剩余{{access.globalRemaining}}次 · {{access.photoEnabled ? '模拟识餐已启用' : '管理员已暂停模拟识餐'}}</view><button class="btn white mt" data-url="/pages/ai-plan/index" bindtap="go">用同一份次数，制定轻动计划</button><button class="btn white mt" bindtap="beginVideo" disabled="{{busy || !access.adsAvailable || video}}">模拟观看激励视频，领取识餐次数</button><view wx:if="{{video}}" class="notice warn mt"><view>本地视频流程模拟，未加载真实广告。只有完整观看完成才赠送次数。</view><button class="btn mt" data-complete="yes" bindtap="endVideo">模拟完整观看结束</button><button class="btn white mt" data-complete="no" bindtap="endVideo">模拟中途关闭（不赠送）</button></view></view></view>
<view wx:if="{{result}}" class="card section result-card"><view class="row"><text class="section-title">这一餐，已经记好</text><text class="pill">模拟结果</text></view><view class="title mt">{{result.name}}</view><view class="result-energy"><text>{{result.kcal}}</text><text class="unit">kcal · 估算热量</text></view><view class="grid3 nutrition"><view><text class="number">{{result.protein}}<text class="unit">g</text></text><text class="caption">蛋白质</text></view><view><text class="number">{{result.carbohydrate}}<text class="unit">g</text></text><text class="caption">碳水化合物</text></view><view><text class="number">{{result.fat}}<text class="unit">g</text></text><text class="caption">脂肪</text></view></view><view class="notice mt">已归入 {{result.date}} · {{slotLabel}}。以上营养为固定模拟值，不代表照片中的真实营养。{{result.corrected ? "名称与热量已手动调整，宏量营养仍为演示值。" : ""}}</view><view class="card mt"><view class="title">核对并手动调整（不重复扣次）</view><input value="{{editName}}" data-key="editName" bindinput="editInput" placeholder="餐食名称"/><input type="digit" value="{{editKcal}}" data-key="editKcal" bindinput="editInput" placeholder="热量kcal"/><button class="btn white mt" bindtap="correctMeal">保存调整</button><button class="btn white mt" bindtap="deleteMeal">删除本次餐食记录（不返额度）</button></view><button class="btn soft mt" data-url="/pages/health/index?date={{result.date}}" bindtap="go">去日记看看这一餐 ↗</button></view>
</block></view>
