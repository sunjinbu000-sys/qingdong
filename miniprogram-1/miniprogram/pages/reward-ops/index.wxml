<view class="page"><view wx:if="{{error}}" class="card">{{error}}<button bindtap="retry">重试</button></view><view wx:if="{{accessMessage}}" class="card">{{accessMessage}}<button data-url="/pages/account/index" bindtap="go">账号与身份</button></view><view class="card"><view class="title">活动奖励配置</view><view>{{canEdit?'管理权限按当前身份与城市生效':'浏览公开活动奖励'}}</view><button wx:if="{{canEdit && signedIn}}" data-url="/pages/reward-editor/index" bindtap="go">新建多档活动</button><button wx:if="{{canAdmin}}" data-url="/pages/reward-ledger/index" bindtap="go">发放账本 / 人工核验</button><button data-url="/pages/catalog/index" bindtap="go">共用套餐池</button></view><view wx:for="{{activities}}" wx:key="id" class="card"><view class="title">{{item.title}}</view><view>{{item.typeLabel}} · {{item.city}} · {{item.status||'已上线'}} · {{item.enabled?'启用':'停用'}}</view><view>{{item.start}} 至 {{item.end}} · 领取截止 {{item.claimUntil}}</view><view wx:for="{{item.tiers}}" wx:for-item="tier" wx:key="id">{{tier.name}}：目标{{tier.target}} · {{tier.rewardName}} · 剩余{{tier.remaining}} / {{tier.quota}}</view><button data-url="/pages/reward-editor/index?id={{item.id}}" bindtap="go">{{canEdit?'编辑活动':'查看活动'}}</button><button wx:if="{{canEdit}}" data-id="{{item.id}}" bindtap="toggle">启用 / 停用</button><block wx:if="{{canHQ}}"><button data-id="{{item.id}}" data-approved="{{true}}" bindtap="publish">审批上线</button><button data-id="{{item.id}}" data-approved="{{false}}" bindtap="publish">驳回 / 退回</button></block></view><view wx:if="{{!activities.length}}" class="card">当前范围暂无活动</view></view>