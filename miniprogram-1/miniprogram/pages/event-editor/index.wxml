<import src="../../components/states.wxml"/><view class="page"><template is="feedback" data="{{loading,error}}"/><view class="heading">活动配置</view><block wx:if="{{!loading && !error}}"><form bindsubmit="submit"><view class="field"><view>标题</view><input name="title" type="text" value="{{form.title}}"/></view><view class="field"><view>地点</view><input name="location" type="text" value="{{form.location}}"/></view><view class="field"><view>详情</view><input name="detail" type="text" value="{{form.detail}}"/></view><view class="field"><view>实际人数上限</view><input name="capacity" type="number" value="{{form.capacity}}"/></view><view class="field"><view>附加展示人数（不占名额）</view><input name="virtualCount" type="number" value="{{form.virtualCount}}"/></view><radio-group name="scope"><label><radio value="city" checked="{{form.scope !== 'all'}}"/>本城</label><label><radio value="all" checked="{{form.scope === 'all'}}"/>总部全国</label></radio-group><view class="field"><view>报名开始 YYYY-MM-DDTHH:mm</view><input name="regStart" type="text" value="{{form.regStart}}"/></view><view class="field"><view>报名截止 YYYY-MM-DDTHH:mm</view><input name="regEnd" type="text" value="{{form.regEnd}}"/></view><view class="field"><view>活动开始 YYYY-MM-DDTHH:mm</view><input name="start" type="text" value="{{form.start}}"/></view><view class="field"><view>活动结束 YYYY-MM-DDTHH:mm</view><input name="end" type="text" value="{{form.end}}"/></view><view class="field">报名字段（每行 名称|text/tel/number/textarea|必填/选填）<textarea name="fields" value="{{fields}}"/></view><view class="field">全部达标条件（每行一项）<textarea name="conditions" value="{{conditions}}"/></view><view class="field">会员奖励（每行：名称｜天数｜每日识餐次数）<textarea name="memberRewards" value="{{memberRewards}}"/></view><view class="field">实物奖励（每行：名称｜份数）<textarea name="physicalRewards" value="{{physicalRewards}}"/></view><view class="field">其他产品奖励（每行：名称｜份数）<textarea name="otherRewards" value="{{otherRewards}}"/></view><button class="btn primary" form-type="submit">保存并上架</button></form></block></view>