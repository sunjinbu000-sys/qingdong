<import src="../../components/states.wxml"/><view class="page"><template is="feedback" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><view class="eyebrow">LITTLE MILESTONES</view><view class="heading">认真生活，值得一枚勋章。</view><view wx:if="{{!signedIn}}" class="card section"><button class="btn" data-url="/pages/account/index" bindtap="go">开启我的轻动旅程</button></view><view wx:else class="grid2 section"><view wx:for="{{badges}}" wx:key="id" class="card badge-card {{item.unlocked?'':'locked-badge'}}"><view class="badge-symbol">{{item.unlocked?'✦':'◇'}}</view><view class="title">{{item.title}}</view><text class="caption">{{item.description}}</text><text class="pill mt">{{item.unlocked?'已点亮':item.value+' / '+item.target}}</text></view></view><button class="btn soft section" data-url="/pages/index/index" bindtap="go">继续今天的小坚持 ↗</button></block><view class="footnote">轻动 · 让健康成为一种日常</view></view>
