.badge-card{text-align:center;margin:0!important}.badge-symbol{font-size:90rpx;line-height:1.4;color:#ad9457}.locked-badge{opacity:.55}

.growth-header{display:flex;align-items:center;gap:24rpx;margin-bottom:24rpx}.growth-header-icon{width:120rpx;height:120rpx;flex-shrink:0}.growth-heading-copy{flex:1;min-width:0}.growth-title{font-size:39rpx;color:#263454;font-weight:700;line-height:1.5;margin-bottom:8rpx}.growth-subtitle{font-size:23rpx;line-height:1.75;color:#9a8cad}.growth-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22rpx}.growth-card{display:flex;align-items:center;flex-direction:column;background:#ffffffb0;border-radius:38rpx;min-height:290rpx;padding:30rpx 10rpx 22rpx;text-align:center}.growth-art{width:132rpx;height:132rpx;margin-bottom:15rpx}.growth-name{font-size:24rpx;font-weight:650;color:#615477}.growth-rule{font-size:18rpx;line-height:1.8;color:#a99bb7;margin-top:14rpx}.growth-card.is-locked{opacity:.5}.is-locked .growth-art{filter:grayscale(.8)}.growth-card.is-lit{background:#fff;box-shadow:0 8rpx 26rpx #aa91d516}.page .growth-share{width:100%;min-width:0;border-radius:34rpx;background:#eee7fd;color:#7653d1;font-size:27rpx;font-weight:600;padding:24rpx;margin-top:26rpx;line-height:1.5}.growth-note{text-align:center;font-size:21rpx;color:#a99bb7;line-height:1.7;margin-top:30rpx}.growth-existing-title{font-size:28rpx;font-weight:600;color:#615477;margin-top:42rpx}
