.team-rules-overlay{position:fixed;inset:0;z-index:100;background:#30274270;display:flex;align-items:center;justify-content:center;padding:12rpx}.team-rules-sheet{width:100%;max-width:960rpx;background:#fff;border-radius:38rpx;overflow:hidden}.team-rules-header{display:flex;align-items:center;justify-content:space-between;padding:24rpx 30rpx 14rpx}.team-rules-kicker{font-size:22rpx;color:#ac95ca}.team-rules-title{font-size:31rpx;color:#4c3c67;font-weight:700;margin-top:6rpx}.page .team-rules-close{width:86rpx;min-width:0;margin:0;padding:14rpx 0;background:#f5f0fb;color:#9d86b9;font-size:24rpx;border-radius:22rpx}.team-rules-scroll{height:62vh;overflow-y:auto}.team-rules-body{padding:0 30rpx 20rpx}.team-rules-intro{background:#f5effc;border-radius:24rpx;padding:20rpx;color:#9785ab;font-size:25rpx;line-height:1.8;margin-top:8rpx}.team-rule-section{padding:25rpx 0;border-bottom:1rpx solid #ede4f7}.team-rule-heading{font-size:28rpx;font-weight:650;color:#685080;line-height:1.6;margin-bottom:14rpx}.team-rule-copy{font-size:24rpx;color:#9c89ac;line-height:1.95}.team-rule-highlight{background:#f0f9f4;border:1rpx solid #e5f0e9;padding:22rpx;border-radius:22rpx;margin-top:16rpx}.team-rule-subheading{font-size:24rpx;font-weight:600;color:#668b7c;margin:14rpx 0 7rpx}.team-rule-last{border-bottom:0}.team-rules-footer{display:flex;gap:18rpx;padding:20rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));background:#fff}.page .team-rules-cancel,.page .team-rules-confirm{flex:1;width:auto;min-width:0;margin:0;min-height:88rpx;display:flex;align-items:center;justify-content:center;border-radius:34rpx;font-size:25rpx;font-weight:600;padding:18rpx 10rpx}.page .team-rules-cancel{background:#f0e9fc;color:#8c6dc9}.page .team-rules-confirm{background:linear-gradient(120deg,#a18ae5,#8269cc);color:#fff}

.team-rule-score-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;color:#659c86;font-size:25rpx;font-weight:600}.team-rule-score-row .team-rule-subheading{margin:14rpx 0 7rpx}.team-rule-score-row>text{flex-shrink:0}

.creation-summary{padding:24rpx;border-radius:24rpx;background:#f0f8f3;border:1rpx solid #e0eee5;margin:8rpx 0 22rpx}.creation-summary-title{font-size:21rpx;color:#93aa9e}.creation-summary-name{font-size:29rpx;color:#426b60;font-weight:650;margin:8rpx 0 15rpx}.creation-summary-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;color:#77958a;font-size:23rpx;margin:8rpx 0}.creation-summary-dates,.creation-summary-tasks{font-size:22rpx;color:#93a79e;line-height:1.8;margin-top:9rpx}
